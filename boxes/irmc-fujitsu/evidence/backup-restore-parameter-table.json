  "fieldLayout": {
    "0x00": "parameter ID, u16 little-endian",
    "0x02": "reserved u16, zero in all 92 records",
    "0x04": "pointer to NUL-terminated ASCII label, u32 ELF virtual address",
    "0x08": "sub-ID exclusive upper bound, u16; helper has special handling for ID 0xffff",
    "0x0a": "read-path code, u8 (0 or 1); 1 selects direct ReadConfigurationSpace path in backup",
    "0x0b": "reserved u8, zero in all records",
    "0x0c": "type code, u32 (0, 1, or 2); type 0 receives numeric handling in both helpers",
    "0x10": "mode code, u32 (0, 1, 2, 8, or 16); value 8 changes sub-ID selection for most IDs in helpers",
    "0x14": "restore restriction byte (0 or 1); 1 causes restore rejection except special ID 0xffff",
    "0x15": "reserved u8, zero in all records",
    "0x16": "declared maximum bytes, u16"
  },
  "notes": [
    "Record 0 is the ID-0 first-parameter marker. The remaining 91 records have distinct IDs.",
    "Labels are byte-for-byte ASCII strings referenced by each record; no semantic normalization is applied.",
    "The table is not itself a complete write contract: configuration-provider validation, redaction, and persistence remain unresolved.",
    "No live IPMI maintenance probe was performed."
  ],
