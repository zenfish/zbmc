# Fujitsu iRMC S6, RX2540 M7 firmware 02.63S / SDR 03.67.
#
# The preserved AMI MegaRAC IPMIMain and Fujitsu FTS_WebServer run under the
# AST2600 model. FTS_RedfishService is disabled because its helper.ko fwinfo2
# read reproducibly NULL-dereferences with the single-FMC QEMU topology.
ZBMC_NAME=irmc-fujitsu
ZBMC_NETWORK_MODE=tap
ZBMC_DESC="Fujitsu iRMC S6 / AST2600 - vendor Web-UI; IPMI under investigation"

PROJ_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$PROJ_DIR/../.." && pwd)"
ZBMC_DIR="${ZBMC_DIR:-$ROOT/work/irmc-fujitsu}"
ZBMC_IP=$(_zbmc_resolve_ip irmc-fujitsu 42 10.0.6.68)
ZBMC_HOST=irmc-fujitsu

ZBMC_QEMU="$ROOT/qemu/runtime/qemu-system-arm"
ZBMC_QEMU_SHA256=a066ffd52f50bc4555ea9af003e44e02aec3b3d260a37da8ab0b3d8c596790a6
ZBMC_QEMU_MAJOR=11
ZBMC_QEMU_VERSION=11.0.0
ZBMC_QEMU_MACHINE=ast2600-evb
ZBMC_TAP=ztap-irmc2
ZBMC_TAPS="ztap-irmc0 ztap-irmc1 $ZBMC_TAP"
ZBMC_MAC=52:54:00:fa:42:02
ZBMC_CAPTURE_INTERFACES="br-zbmc $ZBMC_TAPS"
ZBMC_REQUIRED_SERVICES="webui"
ZBMC_DISABLED_SERVICES="redfish"
ZBMC_STABILITY_SECONDS=15
ZBMC_READY_DEADLINE=900
ZBMC_PROBE_AFTER_BOOTSTRAP=1
ZBMC_EXPECTED_FIRMWARE=5
ZBMC_EXPECTED_BOOTSTRAP=180
ZBMC_EXPECTED_READY=720

SSH_USER=sysadmin
SSH_PW=superuser
SSH_PORT=22
IPMI_USER=admin
IPMI_PW=admin
IPMI_KEY=00
IPMI_PORT=623
IPMI_T=15
IPMI_OPTS="-C 17 -I lanplus"
WEB_PORT=443
ZBMC_HTTP_PROBE_TIMEOUT=12

PIDF="$ZBMC_DIR/zbmc.pid"
LOG="$ZBMC_DIR/launcher.log"
SOCK="$ZBMC_DIR/serial.sock"
QMP_SOCK="$ZBMC_DIR/qmp.sock"
CONSOLE_LOG="${ZBMC_CONSOLE_LOG:-$ZBMC_DIR/console.log}"

zbmc_boot() {
  mkdir -p "$ZBMC_DIR"
  local qp= n=0
  : >"$LOG"
  ZBMC_CONSOLE_LOG="$CONSOLE_LOG" WD="$ZBMC_DIR" ZBMC_QEMU="$ZBMC_QEMU" \
    IP="$ZBMC_IP" SSH_PORT="$SSH_PORT" HTTPS_PORT="$WEB_PORT" IPMI_PORT="$IPMI_PORT" \
    SOCK="$SOCK" QMP="$QMP_SOCK" LOG="$LOG" \
    TAP0=ztap-irmc0 TAP1=ztap-irmc1 TAP2="$ZBMC_TAP" bash "$PROJ_DIR/boot.sh" >/dev/null
  while [ "$n" -lt 60 ]; do
    qp=$(pgrep -f "ast2600-evb.*ifname=$ZBMC_TAP" | head -1)
    [ -n "$qp" ] && break
    sleep 0.25
    n=$((n + 1))
  done
  [ -n "$qp" ] && printf '%s\n' "$qp" >"$PIDF"
  printf '%s\n' "$qp"
}
zbmc_running() { pgrep -f "ast2600-evb.*ifname=$ZBMC_TAP" | head -1; }

zbmc_post_launch() {
  nohup python3 "$ROOT/tools/zbmc-configure-serial-ip.py" "$SOCK" "$ZBMC_IP" \
    8 10.0.0.1 eth0 >"$ZBMC_DIR/tap-config.log" 2>&1 &
}

zbmc_build() { bash "$PROJ_DIR/build.sh" "$ZBMC_DIR"; }
zbmc_ready() {
  local file
  for file in kernel.bin system-patched.dtb initramfs.cpio.gz initramfs-shell.cpio.gz flash64.img rootfs-sd.img build-provenance.txt; do
    [ -f "$ZBMC_DIR/$file" ] || { echo "not built - run: zbmc irmc-fujitsu build"; return 1; }
  done
  echo "ready (cold boot; Web-UI works, IPMI under investigation, Redfish disabled)"
}

zbmc_ipmi() {
  timeout -s KILL "$((IPMI_T + 6))" env PYTHONPATH="$ZIPMI" python3 -m zipmi.cli.zipmi \
    -H "$ZBMC_IP" -p "$IPMI_PORT" -U "$IPMI_USER" -P "$IPMI_PW" \
    -C 17 -I lanplus -t "$IPMI_T" "$@" 2>&1
}

zbmc_ipmi_health() {
  local output
  output=$(zbmc_ipmi mc info 2>&1) || { echo "no authenticated IPMI answer"; return 1; }
  grep -q 'IPMI Version\|Manufacturer' <<<"$output" || { echo "invalid IPMI response"; return 1; }
  echo "AUTH OK (Fujitsu iRMC S6 RMCP+)"
}

zbmc_web() {
  curl -sk --max-time 12 -o /dev/null -w 'Fujitsu iRMC Web-UI: HTTP %{http_code}\n' \
    "https://$ZBMC_IP:$WEB_PORT/"
}

zbmc_ssh() {
  echo "iRMC SSH uses the firmware-gated defshell; it is not a Unix shell" >&2
  exec sshpass -p "$SSH_PW" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o ConnectTimeout=10 -p "$SSH_PORT" "$SSH_USER@$ZBMC_IP" "$@"
}

zbmc_console() {
  local nostderr=0
  if [ "${1:-}" = --nostderr ]; then
    nostderr=1
    shift
  fi
  [ "$#" -eq 0 ] || { echo "usage: zbmc irmc-fujitsu console [--nostderr]" >&2; return 2; }
  echo "Fujitsu iRMC console -> $SOCK (Ctrl-] to detach)"
  if [ "$nostderr" = 1 ]; then
    command -v python3 >/dev/null || { echo "need python3 for --nostderr" >&2; return 1; }
    python3 -u -c '
import os
import re
import select
import socket
import sys
import termios
import tty

exact = (
    b"###(ESPI):haGetEspiPCHRTC(RX) : ERROR: retry count over\r\n",
    b"###(ESPI):haGetEspiPCHRTC(RX) : ERROR: retry count over\n",
    b"GetRTCTimeViaESPI L.231: ERROR: retry count exceeded(ret:-1)\r\n",
    b"GetRTCTimeViaESPI L.231: ERROR: retry count exceeded(ret:-1)\n",
)
line_prefixes = (
    b"[",
    b"bt:",
    b"Initialize power control",
    b"Node Manager SlaveAddr:",
    b"pwcpDeviceInit()",
    b"fts_NM_errorRecovery():",
    b"fts_NM_RecvGetDeviceId():",
    b"PCIe Function1:",
    b"fts_PCIe_initStatusSem():",
)
diagnostic_line = re.compile(
    rb"(?:"
    rb"bt:[0-9]+: .*"
    rb"|Initialize power control"
    rb"|Node Manager SlaveAddr: .*"
    rb"|pwcpDeviceInit\(\)"
    rb"|fts_NM_errorRecovery\(\): .*"
    rb"|fts_NM_RecvGetDeviceId\(\): .*"
    rb"|PCIe Function1: .*"
    rb"|fts_PCIe_initStatusSem\(\): .*"
    rb"|\[[0-9]+ : [0-9]+ (?:INFO|WARNING|CRITICAL)\].*(?:IPMBIfc\.c|irmcPCIeSignalHndlr\.c|libipmi_uds_session\.c|UDSIfc\.c|procmonitor\.c).*"
    rb")\r?\n"
)
ansi_csi = re.compile(rb"\x1b\[[0-?]*[ -/]*[@-~]")
pending = b""
suppress_blank = False

def filtered(chunk):
    global pending, suppress_blank
    output = bytearray()
    pending += chunk
    while pending:
        if suppress_blank:
            if pending.startswith(b"\r\n"):
                pending = pending[2:]
                continue
            if pending.startswith(b"\n"):
                pending = pending[1:]
                continue
            if pending == b"\r":
                break
        if pending.startswith(b"\x1b"):
            control = ansi_csi.match(pending)
            if control is not None:
                output += control.group()
                pending = pending[control.end():]
                suppress_blank = False
                continue
            if pending == b"\x1b" or pending.startswith(b"\x1b["):
                break
            output += pending[:1]
            pending = pending[1:]
            suppress_blank = False
            continue
        matched = next((text for text in exact if pending.startswith(text)), None)
        if matched is not None:
            pending = pending[len(matched):]
            suppress_blank = True
            continue
        if any(text.startswith(pending) for text in exact):
            break
        possible_line = tuple(prefix for prefix in line_prefixes if prefix.startswith(pending) or pending.startswith(prefix))
        if possible_line:
            if not any(pending.startswith(prefix) for prefix in line_prefixes):
                break
            newline = pending.find(b"\n")
            if newline < 0:
                break
            line, pending = pending[:newline + 1], pending[newline + 1:]
            if diagnostic_line.fullmatch(line):
                suppress_blank = True
            else:
                output += line
                suppress_blank = False
            continue
        output += pending[:1]
        pending = pending[1:]
        suppress_blank = False
    return output

terminal = 0
old_settings = termios.tcgetattr(terminal)
connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
connection.connect(sys.argv[1])
tty.setraw(terminal)
try:
    while True:
        readable, _, _ = select.select((terminal, connection), (), ())
        if terminal in readable:
            data = os.read(terminal, 4096)
            if not data:
                break
            escape = data.find(b"\x1d")
            if escape >= 0:
                if escape:
                    connection.sendall(data[:escape])
                break
            connection.sendall(data)
        if connection in readable:
            data = connection.recv(4096)
            if not data:
                break
            output = filtered(data)
            if output:
                os.write(1, output)
finally:
    if pending:
        os.write(1, pending)
    termios.tcsetattr(terminal, termios.TCSADRAIN, old_settings)
    connection.close()
' "$SOCK"
    return
  fi
  command -v socat >/dev/null || { echo "need socat" >&2; return 1; }
  exec socat -,raw,echo=0,escape=0x1d "UNIX-CONNECT:$SOCK"
}

ZBMC_READY_GREP='INIT: Entering runlevel: 3'
