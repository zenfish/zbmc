# zbmc.box — virtual-BMC descriptor for "idrac10" (Dell iDRAC10, Nuvoton NPCM845 / aarch64).
# Sourced by the `zbmc` dispatcher (~/phd/bin/zbmc). Root-direct model: qemu runs as root and binds
# the box's real IP + standard IPMI port (10.0.9.10:623) directly — no socat/high-port hop.
ZBMC_NAME=idrac10
ZBMC_DESC="Dell iDRAC10 (NPCM845/aarch64) — Phase-5 RMCP+/RAKP (encrypted) via shm-shim interposes"
# Portable (clone-and-run): scripts+payloads ship in THIS box dir; boot/img artifacts + the warm
# ckpt live in work/idrac10 (symlinked here for dogfood; a clone fetches/rebuilds them). Build deps:
# zig (shm-shim), expect, socat, python.
PROJ_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ZBMC_DIR="${ZBMC_DIR:-$(cd "$PROJ_DIR/../.." && pwd)/work/idrac10}"

# Real IP + /etc/hosts name (idrac10 = 10.0.9.10 in the 10.0.9.x scheme). Ports are bound directly.
ZBMC_IP=$(_zbmc_resolve_ip idrac10 31 10.0.9.10)
ZBMC_HOST=drac10

# IPMI/RAKP (zipmi). Primary auth = IPMIKey (-K); calvin is the ssh/redfish pw.
# idrac10 RAKP uses cipher default; give it a longer per-op timeout (aarch64 is slow).
IPMI_USER=root
IPMI_PW=calvin                                       # Redfish/SSH password (zipmi -P fallback)
IPMI_KEY=915F32F49A97456D0D6D66EEE5ED84C894B414AF   # first 20 bytes of the factory IPMIKey
IPMI_OPTS=""
IPMI_T=25   # aarch64 emulation is slow; <25 intermittently times out the RAKP handshake (measured 2026-07-15)

SSH_PORT=$(_zbmc_pick_port 22 2222)
IPMI_PORT=623
WEB_PORT=$(_zbmc_pick_port 443 8443)

PIDF=/tmp/zbmc-idrac10.pid
LOG=/tmp/zbmc-idrac10-console.log
SOCK=/tmp/zbmc-idrac10-serial.sock
CONSOLE_LOG="${ZBMC_CONSOLE_LOG:-$LOG}"
WORK="$ZBMC_DIR"; SERVE="$WORK/serve"
if [ -z "${IDRAC10_QEMU:-}" ] && [ -x /home/zen/opt/qemu-11-idrac10/bin/qemu-system-aarch64 ]; then
  IDRAC10_QEMU=/home/zen/opt/qemu-11-idrac10/bin/qemu-system-aarch64
elif [ -z "${IDRAC10_QEMU:-}" ] && [ -x /home/zen/opt/qemu-11-aarch64/bin/qemu-system-aarch64 ]; then
  IDRAC10_QEMU=/home/zen/opt/qemu-11-aarch64/bin/qemu-system-aarch64
fi
IDRAC10_QEMU="${IDRAC10_QEMU:-qemu-system-aarch64}"
export IDRAC10_QEMU

# boot: build the shm-shim, serve guest binaries over http, launch qemu AS ROOT with hostfwd on the
# real IP:623, then drive the guest bring-up (mount/net/fullfw -> IPMI_READY) via boot-idrac10.exp.
zbmc_boot() {
  mkdir -p "$ZBMC_DIR"; cd "$PROJ_DIR" || return 1
  for f in "$ZBMC_DIR/boot/Image.boot-patched" "$ZBMC_DIR/boot/qemu-gmac.dtb" "$ZBMC_DIR/img/sd.img" shm-shim.c boot-fullfw-guest.sh prebind-v2 boot-idrac10.exp qemu-usb-net-overlay.dts; do
    [ -e "$f" ] || { echo "missing $f — idrac10 not built" >&2; return 1; }
  done
  command -v dtc >/dev/null && command -v fdtoverlay >/dev/null || {
    echo "need dtc and fdtoverlay to build the idrac10 USB network DTB" >&2
    return 1
  }
  local SUDO=; [ "$(id -u)" = 0 ] || SUDO=sudo
  _zbmc_lo_alias "$ZBMC_IP"
  grep -qE "[[:space:]]${ZBMC_HOST}([[:space:]]|\$)" /etc/hosts 2>/dev/null || \
    echo "$ZBMC_IP $ZBMC_HOST $ZBMC_NAME" | $SUDO tee -a /etc/hosts >/dev/null
  # FAST PATH: a warm snapshot exists -> restore it on the real IP:623 in ~seconds (skips the
  # ~7min cold boot + dbus lottery + fullfw warm-up). Make one with: zbmc idrac10 snapshot.
  if [ -z "${ZBMC_COLD:-}" ] && [ -f "$WORK/ckpt/state.gz" ]; then
    : > "$LOG"
    # ponytail: restore+verify can take minutes (5 IPMI probes x up to 3 re-restores). Run it
    # DETACHED like the cold path so `start` returns at once; `zbmc status -f` follows to READY.
    # Redirect wraps the whole subshell so it can't hold the $(zbmc_boot) pipe open (bash gotcha).
    ( set +x   # keep the caller's xtrace/PS4 out of the console log
      ZBMC_CONSOLE_LOG="$CONSOLE_LOG" WD="$ZBMC_DIR" bash "$PROJ_DIR/restore-idrac10.sh" "$IPMI_PORT" "$ZBMC_IP"
      grep -q 'RESTORE OK' "$LOG" && echo "IDRAC10_UP" ) >>"$LOG" 2>&1 &
    # report the qemu pid the moment it's up (restore launches it before verifying), then detach
    local n=0 qp=; while [ $n -lt 40 ]; do qp=$(pgrep -f "hostfwd=udp:$ZBMC_IP:$IPMI_PORT-" | head -1); [ -n "$qp" ] && break; sleep 0.3; n=$((n+1)); done
    echo "$qp"
    return 0
  fi
  mkdir -p "$WORK" "$SERVE"
  # rebuild shm-shim + sync guest payloads
  zig cc -shared -fPIC -o "$SERVE/shm-shim.so" shm-shim.c -target aarch64-linux-gnu -ldl -lpthread -O2 || return 1
  cp shm-shim.so "$ZBMC_DIR/shm-shim.so" 2>/dev/null || cp "$SERVE/shm-shim.so" shm-shim.so
  cp boot-fullfw-guest.sh fake-journal udp-echo cfgdb-defaults.sql "$SERVE/" 2>/dev/null
  cp prebind-v2 "$SERVE/prebind"
  dtc -Wno-interrupts_property -@ -I dts -O dtb \
    -o "$WORK/qemu-usb-net.dtbo" qemu-usb-net-overlay.dts || return 1
  fdtoverlay -i "$ZBMC_DIR/boot/qemu-gmac.dtb" -o "$WORK/qemu-usb-net.dtb" \
    "$WORK/qemu-usb-net.dtbo" || return 1
  pkill -f "http.server 8091" 2>/dev/null
  python3 -m http.server 8091 --directory "$SERVE" >"$WORK/httpd.log" 2>&1 &
  : > "$LOG"; $SUDO rm -f "$SOCK" 2>/dev/null; rm -f "$SOCK" 2>/dev/null
  $SUDO nohup "$IDRAC10_QEMU" -M npcm845-evb -m 1G \
    -kernel "$ZBMC_DIR/boot/Image.boot-patched" -dtb "$WORK/qemu-usb-net.dtb" \
    -drive "id=rootsd,if=none,file=$ZBMC_DIR/img/sd.img,format=raw,snapshot=on" -device sd-card,drive=rootsd,bus=sd-bus \
    -display none -nic user,model=npcm-gmac,"hostfwd=udp:$ZBMC_IP:623-10.0.2.15:623" \
    -netdev user,id=tcpnet,net=10.0.3.0/24,host=10.0.3.2,dhcpstart=10.0.3.15,"hostfwd=tcp:$ZBMC_IP:$SSH_PORT-10.0.3.15:22,hostfwd=tcp:$ZBMC_IP:$WEB_PORT-10.0.3.15:443,hostfwd=tcp:$ZBMC_IP:5200-10.0.3.15:5200,hostfwd=tcp:$ZBMC_IP:5201-10.0.3.15:5201" \
    -device usb-net,netdev=tcpnet,bus=usb-bus.0,port=1,id=tcpnic \
    -chardev "socket,id=serial0,path=$SOCK,server=on,wait=off,logfile=$CONSOLE_LOG,logappend=off" \
    -serial chardev:serial0 >"$WORK/qemu.log" 2>&1 &
  # drive the bring-up in the background (needs root: the serial sock is root-owned)
  ( until [ -S "$SOCK" ]; do sleep 0.5; done; sleep 1; $SUDO expect boot-idrac10.exp "$SOCK" ) >>"$LOG" 2>&1 &
  # UDP-echo prime: boot-fullfw-guest.sh prints UDP_ECHO_READY then waits for a test packet on :623 to
  # verify the UDP RX path (via the shm-shim) before starting fullfw. Send it, else fw.sh -> UDP_ECHO_TIMEOUT.
  ( until grep -q UDP_ECHO_READY "$LOG" 2>/dev/null; do sleep 0.5; done
    python3 -c "import socket; s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM); s.sendto(b'HELLO_UDP_TEST',('$ZBMC_IP',623))" 2>/dev/null || true ) >/dev/null 2>&1 &
  local n=0 qp=; while [ $n -lt 40 ]; do qp=$(pgrep -f "hostfwd=udp:$ZBMC_IP:623-" | head -1); [ -n "$qp" ] && break; sleep 0.3; n=$((n+1)); done
  echo "$qp"
}
zbmc_build() { echo "idrac10 build is phase-script driven — see run-p*.sh; boot/Image.boot-patched + img/sd.img are prebuilt"; }
zbmc_ready() {
  local d="$ZBMC_DIR"
  if [ -f "$d/boot/Image.boot-patched" ] && [ -f "$d/img/sd.img" ]; then
    [ -f "$d/ckpt/state.gz" ] && { echo "ready (warm snapshot)"; return 0; }
    echo "ready (cold boot only)"; return 0
  fi
  echo "not built — need boot/Image.boot-patched + img/sd.img"; return 1
}
# snapshot: cold-boot until a good box (fullfw up, IPMI answers), then freeze it to $WORK/ckpt/state.gz.
# Pays the dbus lottery ONCE; afterwards `zbmc idrac10 start` restores it in ~seconds. Arg: max boot tries.
zbmc_snapshot() { WD="$ZBMC_DIR" bash "$PROJ_DIR/boot-live-ckpt.sh" "${1:-4}"; }
# restore: bring the warm snapshot up on the real IP:623 (what `start` does automatically when a snap exists).
zbmc_restore()  { WD="$ZBMC_DIR" bash "$PROJ_DIR/restore-idrac10.sh" "$IPMI_PORT" "$ZBMC_IP"; }
# Serial console works on BOTH warm-restore and cold boot (the old "vmstate gap" was a wrong socket path:
# the 16550 SerialMM migrates fully via vmstate_serial_mm). A warm restore binds the console at
# $WORK/ckpt/rserial.sock (restore-idrac10.sh); a cold boot uses $SOCK. Pick whichever is newest = the
# running box. qemu runs as root so the socket is root-owned -> sudo.
_zbmc_sock(){ local s; for s in $(ls -t "$WORK/ckpt/rserial.sock" "$SOCK" 2>/dev/null); do [ -S "$s" ] && { echo "$s"; return; }; done; }
zbmc_ssh() {
  command -v sshpass >/dev/null || { echo "sshpass missing"; return 1; }
  exec sshpass -p "$IPMI_PW" ssh -o PubkeyAuthentication=no -o PreferredAuthentications=password \
    -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=10 -o LogLevel=ERROR \
    -p "$SSH_PORT" "root@$ZBMC_IP" "$@"
}
zbmc_console() {
  command -v socat >/dev/null || { echo "socat missing"; return 1; }
  local sk; sk="$(_zbmc_sock)"; [ -n "$sk" ] || { echo "no serial console — box up? (zbmc idrac10 status)"; return 1; }
  local SUDO=; { [ -r "$sk" ] && [ -w "$sk" ]; } || { [ "$(id -u)" = 0 ] || SUDO="sudo -n"; }
  exec $SUDO socat -,raw,echo=0,escape=0x1d "UNIX-CONNECT:$sk"
}
zbmc_ipmi_health() {
  local out rc
  out=$(timeout -s KILL "$((IPMI_T + 10))" env PYTHONPATH="$ZIPMI" python3 -m zipmi.cli.zipmi \
    -H "$ZBMC_IP" -p "$IPMI_PORT" -U "$IPMI_USER" -K "$IPMI_KEY" -t "$IPMI_T" -R 0 \
    raw 0x06 0x3b 0x04 2>&1); rc=$?
  [ "$rc" = 0 ] && { echo "authenticated RMCP+ works; ordinary command dispatch is not ready"; return 1; }
  echo "${out:-no answer (warming/down)}"; return 1
}
zbmc_web()   { echo "idrac10 Redfish: P3 (run-p3-redfish.sh) — not wired into zbmc yet"; }
# readiness marker in the console log (zbmc status greps IDRAC10_UP / IPMI_READY)
ZBMC_READY_GREP='IDRAC10_UP'
