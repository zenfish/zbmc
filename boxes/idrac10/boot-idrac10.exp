#!/usr/bin/expect -f
# boot-idrac10.exp — minimal iDRAC10 (npcm845) Phase-5 IPMI bring-up, driven over the QEMU serial
# socket. Mounts filesystems, brings up eth0 (slirp 10.0.2.15), fetches+runs boot-fullfw-guest.sh
# (the fullfw/RAKP daemon bring-up with the shm-shim), waits for IPMI_READY, then detaches leaving
# QEMU + fullfw running. This is the stripped bring-up from run-p5-ipmi.sh (no debug diagnostics).
# Called by zbmc.box zbmc_boot. Arg: <serial-unix-sock>.  Guest fetches binaries from the host's
# python http.server on 10.0.2.2:8091 (slirp gateway).
set sock [lindex $argv 0]
match_max 2000000
set timeout 60
spawn socat - UNIX-CONNECT:$sock
expect { "sh-5.2#" {} timeout { puts "BOOT_TIMEOUT (no shell)"; exit 1 } }
puts "\[exp] shell ready"
send "mount -t proc proc /proc; mount -t sysfs sysfs /sys; mount -t devtmpfs devtmpfs /dev; mkdir -p /dev/pts; mount -t devpts devpts /dev/pts; mount -t tmpfs tmpfs /tmp; mount -t tmpfs tmpfs /run; mount -t tmpfs tmpfs /var/volatile; mount -t tmpfs tmpfs /mnt\r"
expect -timeout 15 "sh-5.2#"
puts "\[exp] fs mounted"
send "ip link set eth0 up; ip addr add 10.0.2.15/24 dev eth0; ip route add default via 10.0.2.2\r"
expect -timeout 210 "sh-5.2#"
puts "\[exp] NET_UP"
send "wget -q --timeout=15 http://10.0.2.2:8091/boot-fullfw-guest.sh -O /tmp/fw.sh && sh /tmp/fw.sh 2>&1\r"
expect {
    -timeout 600
    "IPMI_READY" { puts "\[exp] IPMI_READY (env ready)" }
    timeout      { puts "\[exp] TIMEOUT waiting IPMI_READY"; exit 1 }
    eof          { puts "\[exp] EOF before IPMI_READY"; exit 1 }
}
puts "IDRAC10_UP"
exit 0
