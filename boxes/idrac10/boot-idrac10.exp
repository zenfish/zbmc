#!/usr/bin/expect -f
# boot-idrac10.exp — minimal iDRAC10 (npcm845) Phase-5 IPMI bring-up, driven over the QEMU serial
# socket. Mounts filesystems, brings up eth0 (slirp 10.0.2.15), fetches+runs boot-fullfw-guest.sh
# (the fullfw/RAKP daemon bring-up with the shm-shim), waits for IPMI_READY, then detaches leaving
# QEMU + fullfw running. This is the stripped bring-up from run-p5-ipmi.sh (no debug diagnostics).
# Called by zbmc.box zbmc_boot. Arg: <serial-unix-sock>.  Guest fetches binaries from the host's
# python http.server on 10.0.2.2:8091 (slirp gateway).
set sock [lindex $argv 0]
match_max 2000000
set timeout 60
spawn socat - UNIX-CONNECT:$sock
set shell_ready 0
for {set i 0} {$i < 30 && !$shell_ready} {incr i} {
    send "\r"
    expect {
        -timeout 2
        "sh-5.2#" { set shell_ready 1 }
        eof { puts "BOOT_EOF (no shell)"; exit 1 }
        timeout {}
    }
}
if {!$shell_ready} { puts "BOOT_TIMEOUT (no shell)"; exit 1 }
puts "\[exp] shell ready"
send "mount -t proc proc /proc; mount -t sysfs sysfs /sys; mount -t devtmpfs devtmpfs /dev; mkdir -p /dev/pts; mount -t devpts devpts /dev/pts; mount -t tmpfs tmpfs /tmp; mount -t tmpfs tmpfs /run; mount -t tmpfs tmpfs /var/volatile; mount -t tmpfs tmpfs /mnt; printf '__ZBMC_%s__\\n' FS_READY\r"
expect -timeout 30 "__ZBMC_FS_READY__"
puts "\[exp] fs mounted"
send "ip link set eth0 up; ip addr add 10.0.2.15/24 dev eth0; ip route add default via 10.0.2.2; printf '__ZBMC_%s__\\n' NET_UP\r"
expect -timeout 210 "__ZBMC_NET_UP__"
puts "\[exp] NET_UP"
send "TCP_NIC=usb0; for i in {1..30}; do test -e /sys/class/net/\$TCP_NIC && break; sleep 1; done; if test -e /sys/class/net/\$TCP_NIC && ip link set \"\$TCP_NIC\" up && ip addr add 10.0.3.15/24 dev \"\$TCP_NIC\"; then ip route replace 10.0.3.0/24 dev \"\$TCP_NIC\" src 10.0.3.15 table 100; ip route replace default via 10.0.3.2 dev \"\$TCP_NIC\" table 100; ip rule add from 10.0.3.15/32 table 100 priority 32765 2>/dev/null || true; printf '__ZBMC_TCP_NET_%s__=%s\\n' UP \"\$TCP_NIC\"; else printf '__ZBMC_TCP_NET_%s__\\n' MISSING; fi\r"
expect {
    -timeout 45
    "__ZBMC_TCP_NET_UP__=usb0" { puts "\[exp] TCP_NET_UP" }
    "__ZBMC_TCP_NET_MISSING__" { puts "\[exp] TCP_NET_MISSING"; exit 1 }
    timeout { puts "\[exp] TIMEOUT configuring TCP network"; exit 1 }
}
send "wget -q --timeout=15 http://10.0.2.2:8091/boot-fullfw-guest.sh -O /tmp/fw.sh && sh /tmp/fw.sh 2>&1\r"
expect {
    -timeout 600
    "IPMI_READY" { puts "\[exp] IPMI_READY (env ready)" }
    timeout      { puts "\[exp] TIMEOUT waiting IPMI_READY"; exit 1 }
    eof          { puts "\[exp] EOF before IPMI_READY"; exit 1 }
}
puts "IDRAC10_UP"
exit 0
