# vbmc.box — virtual-BMC descriptor for "idrac10" (Dell iDRAC10, Nuvoton NPCM845 / aarch64).
# Sourced by the `vbmc` dispatcher (~/phd/bin/vbmc). Root-direct model: qemu runs as root and binds
# the box's real IP + standard IPMI port (10.0.9.10:623) directly — no socat/high-port hop.
VBMC_NAME=idrac10
VBMC_DESC="Dell iDRAC10 (NPCM845/aarch64) — Phase-5 RMCP+/RAKP (encrypted) via shm-shim interposes"
VBMC_DIR=/Volumes/yyy/phd/bmc/dell/idrac10-virtual

# Real IP + /etc/hosts name (idrac10 = 10.0.9.10 in the 10.0.9.x scheme). Ports are bound directly.
VBMC_IP=10.0.9.10
VBMC_HOST=drac10
# copy-paste access hint shown by `vbmc status` (factory-default creds by design;
# IPMI auth is the factory IPMIKey via -K, NOT a password; calvin is the ssh/redfish pw)
VBMC_HINT='ssh root@drac10 | zipmi -H drac10 -U root -K 915F32F49A97456D0D6D66EEE5ED84C894B414AF (or -P calvin) | curl -k -u root:calvin https://drac10/redfish/'

# IPMI/RAKP (zipmi). idrac10 RAKP uses cipher default; give it a longer per-op timeout (aarch64 is slow).
IPMI_USER=root
IPMI_KEY=915F32F49A97456D0D6D66EEE5ED84C894B414AF   # first 20 bytes of the factory IPMIKey
IPMI_OPTS=""
IPMI_T=25   # aarch64 emulation is slow; <25 intermittently times out the RAKP handshake (measured 2026-07-15)

# port vars (kept for the dispatcher; the box binds standard ports directly on VBMC_IP)
SSH_PORT=22
IPMI_PORT=623
WEB_PORT=443

PIDF=/tmp/vbmc-idrac10.pid
LOG=/tmp/vbmc-idrac10-console.log
SOCK=/tmp/vbmc-idrac10-serial.sock
WORK="$HOME/phd/tmp/idrac10-virtual"; SERVE="$WORK/serve"

# boot: build the shm-shim, serve guest binaries over http, launch qemu AS ROOT with hostfwd on the
# real IP:623, then drive the guest bring-up (mount/net/fullfw -> IPMI_READY) via boot-idrac10.exp.
vbmc_boot() {
  cd "$VBMC_DIR" || return 1
  for f in boot/Image.boot-patched boot/qemu-gmac.dtb img/sd.img shm-shim.c boot-fullfw-guest.sh prebind-v2 boot-idrac10.exp; do
    [ -e "$f" ] || { echo "missing $f — idrac10 not built" >&2; return 1; }
  done
  local SUDO=; [ "$(id -u)" = 0 ] || SUDO=sudo
  $SUDO ifconfig lo0 alias "$VBMC_IP" up 2>/dev/null
  grep -qE "[[:space:]]${VBMC_HOST}([[:space:]]|\$)" /etc/hosts 2>/dev/null || \
    echo "$VBMC_IP $VBMC_HOST $VBMC_NAME" | $SUDO tee -a /etc/hosts >/dev/null
  # FAST PATH: a warm snapshot exists -> restore it on the real IP:623 in ~seconds (skips the
  # ~7min cold boot + dbus lottery + fullfw warm-up). Make one with: vbmc idrac10 snapshot.
  if [ -z "${VBMC_COLD:-}" ] && [ -f "$WORK/ckpt/state.gz" ]; then
    : > "$LOG"
    # ponytail: restore+verify can take minutes (5 IPMI probes x up to 3 re-restores). Run it
    # DETACHED like the cold path so `start` returns at once; `vbmc status -f` follows to READY.
    # Redirect wraps the whole subshell so it can't hold the $(vbmc_boot) pipe open (bash gotcha).
    ( set +x   # keep the caller's xtrace/PS4 out of the console log
      bash "$VBMC_DIR/restore-idrac10.sh" "$IPMI_PORT" "$VBMC_IP"
      grep -q 'RESTORE OK' "$LOG" && echo "IDRAC10_UP" ) >>"$LOG" 2>&1 &
    # report the qemu pid the moment it's up (restore launches it before verifying), then detach
    local n=0 qp=; while [ $n -lt 40 ]; do qp=$(pgrep -f "hostfwd=udp:$VBMC_IP:$IPMI_PORT-:623" | head -1); [ -n "$qp" ] && break; sleep 0.3; n=$((n+1)); done
    echo "$qp"
    return 0
  fi
  mkdir -p "$WORK" "$SERVE"
  # rebuild shm-shim + sync guest payloads
  zig cc -shared -fPIC -o "$SERVE/shm-shim.so" shm-shim.c -target aarch64-linux-gnu -ldl -lpthread -O2 || return 1
  cp shm-shim.so "$VBMC_DIR/shm-shim.so" 2>/dev/null || cp "$SERVE/shm-shim.so" shm-shim.so
  cp boot-fullfw-guest.sh fake-journal udp-echo cfgdb-defaults.sql "$SERVE/" 2>/dev/null
  cp prebind-v2 "$SERVE/prebind"
  pkill -f "http.server 8091" 2>/dev/null
  python3 -m http.server 8091 --directory "$SERVE" >"$WORK/httpd.log" 2>&1 &
  : > "$LOG"; $SUDO rm -f "$SOCK" 2>/dev/null; rm -f "$SOCK" 2>/dev/null
  $SUDO nohup qemu-system-aarch64 -M npcm845-evb -m 1G \
    -kernel boot/Image.boot-patched -dtb boot/qemu-gmac.dtb \
    -drive "id=rootsd,if=none,file=img/sd.img,format=raw,snapshot=on" -device sd-card,drive=rootsd,bus=sd-bus \
    -display none -nic user,model=npcm-gmac,"hostfwd=udp:$VBMC_IP:623-:623,hostfwd=tcp:$VBMC_IP:22-:22,hostfwd=tcp:$VBMC_IP:443-:443,hostfwd=tcp:$VBMC_IP:5200-:5200,hostfwd=tcp:$VBMC_IP:5201-:5201" \
    -serial unix:"$SOCK",server,nowait >"$WORK/qemu.log" 2>&1 &
  # drive the bring-up in the background (needs root: the serial sock is root-owned)
  ( until [ -S "$SOCK" ]; do sleep 0.5; done; sleep 1; $SUDO expect boot-idrac10.exp "$SOCK" ) >>"$LOG" 2>&1 &
  # UDP-echo prime: boot-fullfw-guest.sh prints UDP_ECHO_READY then waits for a test packet on :623 to
  # verify the UDP RX path (via the shm-shim) before starting fullfw. Send it, else fw.sh -> UDP_ECHO_TIMEOUT.
  ( until grep -q UDP_ECHO_READY "$LOG" 2>/dev/null; do sleep 0.5; done
    python3 -c "import socket; s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM); s.sendto(b'HELLO_UDP_TEST',('$VBMC_IP',623))" 2>/dev/null || true ) >/dev/null 2>&1 &
  local n=0 qp=; while [ $n -lt 40 ]; do qp=$(pgrep -f "hostfwd=udp:$VBMC_IP:623-:623" | head -1); [ -n "$qp" ] && break; sleep 0.3; n=$((n+1)); done
  echo "$qp"
}
vbmc_build() { echo "idrac10 build is phase-script driven — see run-p*.sh; boot/Image.boot-patched + img/sd.img are prebuilt"; }
# snapshot: cold-boot until a good box (fullfw up, IPMI answers), then freeze it to $WORK/ckpt/state.gz.
# Pays the dbus lottery ONCE; afterwards `vbmc idrac10 start` restores it in ~seconds. Arg: max boot tries.
vbmc_snapshot() { bash "$VBMC_DIR/boot-live-ckpt.sh" "${1:-4}"; }
# restore: bring the warm snapshot up on the real IP:623 (what `start` does automatically when a snap exists).
vbmc_restore()  { bash "$VBMC_DIR/restore-idrac10.sh" "$IPMI_PORT" "$VBMC_IP"; }
# Serial console works on BOTH warm-restore and cold boot (the old "vmstate gap" was a wrong socket path:
# the 16550 SerialMM migrates fully via vmstate_serial_mm). A warm restore binds the console at
# $WORK/ckpt/rserial.sock (restore-idrac10.sh); a cold boot uses $SOCK. Pick whichever is newest = the
# running box. qemu runs as root so the socket is root-owned -> sudo.
#   vbmc idrac10 ssh          -> interactive root shell on the console
#   vbmc idrac10 ssh <cmd...> -> run <cmd> on the console, print its stdout, propagate its exit code
_vbmc_sock(){ local s; for s in $(ls -t "$WORK/ckpt/rserial.sock" "$SOCK" 2>/dev/null); do [ -S "$s" ] && { echo "$s"; return; }; done; }
vbmc_ssh() {
  command -v socat >/dev/null || { echo "socat missing"; return 1; }
  local sk; sk="$(_vbmc_sock)"; [ -n "$sk" ] || { echo "no serial console — box up? (vbmc idrac10 status)"; return 1; }
  local SUDO=; { [ -r "$sk" ] && [ -w "$sk" ]; } || { [ "$(id -u)" = 0 ] || SUDO="sudo -n"; }
  [ $# -eq 0 ] && exec $SUDO socat -,raw,echo=0,escape=0x1d "UNIX-CONNECT:$sk"   # interactive shell
  $SUDO python3 - "$sk" "$*" <<'PY'
import socket,sys,time,select,re
sk,cmd=sys.argv[1],sys.argv[2]
s=socket.socket(socket.AF_UNIX);s.connect(sk);s.setblocking(False)
def send(b): s.send(b);time.sleep(0.2)
send(b'\r\n'); send(("%s; echo __RC_$?__\r\n"%cmd).encode())
buf=b'';end=time.time()+12
while time.time()<end:
    r,_,_=select.select([s],[],[],0.3)
    if r:
        try:d=s.recv(4096)
        except BlockingIOError:continue
        if d:buf+=d
        if re.search(rb'__RC_\d+__',buf):break
t=buf.decode('utf-8','replace'); m=re.search(r'__RC_(\d+)__',t)
body=re.sub(r'^.*?echo __RC_\$\?__\r?\n','',t,count=1,flags=re.S)
sys.stdout.write(re.split(r'__RC_\d+__',body)[0]); sys.exit(int(m.group(1)) if m else 1)
PY
}
vbmc_web()   { echo "idrac10 Redfish: P3 (run-p3-redfish.sh) — not wired into vbmc yet"; }
# readiness marker in the console log (vbmc status greps IDRAC10_UP / IPMI_READY)
VBMC_READY_GREP='IDRAC10_UP'
