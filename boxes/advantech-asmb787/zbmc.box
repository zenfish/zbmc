# zbmc.box — virtual-BMC descriptor for "asmb787" (Advantech ASMB-787 = AMI MegaRAC SP-X 4.0 / AST2600).
#
# WHAT: `zbmc asmb787 <verb>` drives the virtual Advantech ASMB-787 BMC. qemu ast2600-evb (armv7l),
#       Linux 5.4.11-ami MegaRAC SP-X 4.0. Rootfs (squashfs) boots as a RAM disk; /conf, /usr/local/www,
#       /dre mount from the ORIGINAL 64MB NOR image via mtdparts whose mtdblock NUMBERS match the
#       firmware's /etc/dupfstab. Console on ttyS4.
# WHY:  first Advantech box in the zoo; sibling of the HPE Cray XD670 (same AMI SP-X / ast2600evb_ami
#       platform). Unpacked from encrypted_ASMB-787_20220912.ima_enc ("encrypted" is a misnomer — it
#       is plain XZ-SquashFS; see ~/phd/bin/unpack-ami).
#
# STATUS (2026-08-14): CONSOLE-GREEN. Full MegaRAC userland boots (IPMIMain stable, redis, lighttpd,
#   Redfish, event/task services). Root console login works. The cray IPMIMain fixes ported clean
#   (qemu-patch-rootfs.sh: /conf/BMC symlink + IPMI.conf hw-trim -> no MsgHndlr SIGSEGV/reboot loop).
#   EXTERNAL NET = WIP: the 5.4.11-ami ftgmac won't enable its qemu TX/RX path without completing the
#   NC-SI enable sequence (qemu ast2600 slirp has no NC-SI responder; cray's newer 5.4.184 kernel forces
#   the MAC up regardless, this older one does not). Confirmed: fixed-link brings carrier up but ping to
#   the slirp gateway = 100% loss / TX errors. Fix pending = a socket-netdev NC-SI responder ("fake NIC").
#   So Redfish/IPMI over host ports are NOT reachable yet — use the console.
#
# ACCESS:
#   Console : zbmc asmb787 console            (serial ttyS4; login sysadmin / superuser -> uid 0 root)
#             zbmc asmb787 console '<cmd>'    (run one command over the console fifo)
#   Redfish : WIP (needs NC-SI responder)     https://asmb787bmc/redfish/v1/  (admin/superuser)
#   IPMI    : WIP (needs NC-SI responder)     zipmi -H asmb787bmc -U admin -P superuser mc info
ZBMC_NAME=advantech-asmb787
ZBMC_DESC="Advantech ASMB-787 BMC (AMI MegaRAC SP-X 4.0 / AST2600, armv7l) — CONSOLE-green (sysadmin/superuser); ext net WIP (NC-SI responder)"

ZBMC_DIR=/Users/zen/phd/tmp/asmb787                          # scratch: artifacts + console log + fifo
PROJ_DIR=/Volumes/yyy/phd/bmc/advantech/asmb787-virtual      # scripts + docs (git-tracked)

# Real IP + standard ports — 10.0.10.x is Advantech's /24 in the vendor scheme
# (Dell 10.0.9, Supermicro 10.0.8, OpenBMC 10.0.7). qemu binds ZBMC_IP:{22,443,623}
# directly as root on a lo0 alias, exactly like idrac9/x14. No port offset.
ZBMC_IP=10.0.10.10
ZBMC_HOST=asmb787bmc
IPMI_USER=admin
IPMI_PW=superuser
IPMI_KEY=00
IPMI_OPTS=""
IPMI_T=20
SSH_USER=sysadmin
SSH_PW=superuser
SSH_PORT=22
IPMI_PORT=623
WEB_PORT=443

PIDF=/tmp/zbmc-advantech-asmb787.pid
LOG=/Users/zen/phd/tmp/asmb787/svc.log
SOCK=/Users/zen/phd/tmp/asmb787/cin        # fifo: echo 'cmd' > "$SOCK" drives the console

# boot: background the service boot (real init). ~2 min cold boot to login.
zbmc_boot() {
  # root-direct model: alias the real IP onto lo0 + map the /etc/hosts name, then qemu (as root)
  # binds ZBMC_IP:{22,443,623} directly. Interactive sudo here also warms the timestamp so the
  # backgrounded `sudo qemu` in the boot script doesn't re-prompt.
  local SUDO=; [ "$(id -u)" = 0 ] || SUDO=sudo
  $SUDO ifconfig lo0 alias "$ZBMC_IP" up 2>/dev/null
  grep -qE "[[:space:]]${ZBMC_HOST}([[:space:]]|\$)" /etc/hosts 2>/dev/null || \
    echo "$ZBMC_IP $ZBMC_HOST $ZBMC_NAME" | $SUDO tee -a /etc/hosts >/dev/null
  BG=1 IP="$ZBMC_IP" HTTPS_PORT="$WEB_PORT" IPMI_PORT="$IPMI_PORT" SSH_PORT="$SSH_PORT" WD="$ZBMC_DIR" \
    bash "$PROJ_DIR/boot-asmb787-svc.sh" >/dev/null 2>&1
  local n=0 qp=; while [ $n -lt 40 ]; do
    qp=$(pgrep -f 'asmb787/mtdflash-run.bin' | head -1); [ -n "$qp" ] && break
    sleep 0.3; n=$((n+1)); done
  [ -n "$qp" ] && echo "$qp" > "$PIDF"; echo "$qp"
}
zbmc_build() { WD="$ZBMC_DIR" bash "$PROJ_DIR/extract.sh"; }

# console: tail the serial log; pass a string arg to send it to the getty/shell over the fifo.
zbmc_console() {
  if [ $# -gt 0 ]; then printf '%s\n' "$*" > "$SOCK"; sleep 1; tail -20 "$LOG"; else tail -f "$LOG"; fi
}
# web/ipmi: WIP until the NC-SI responder lands; report honestly rather than hang.
zbmc_web() {
  if curl -sk --max-time 6 "https://$ZBMC_IP:$WEB_PORT/redfish/v1/" 2>/dev/null | grep -q '"v1"'; then
    echo "asmb787 Redfish: UP (https://$ZBMC_IP:$WEB_PORT/redfish/v1/)"
  else
    echo "asmb787 Redfish: WIP — ext net needs the NC-SI responder (fake NIC). Use: zbmc asmb787 console"
  fi
}
zbmc_ipmi()        { echo "asmb787 IPMI: WIP — ext RMCP+ needs the NC-SI responder. Use: zbmc asmb787 console"; return 1; }
zbmc_ipmi_health() { echo "no answer (ext net WIP — NC-SI responder pending; console works)"; return 1; }
zbmc_ssh()         { echo "asmb787 ssh: use the console — zbmc asmb787 console (login sysadmin/superuser)"; return 1; }

ZBMC_READY_GREP='login:'
