# zbmc.box — virtual-BMC descriptor for "asmb787" (Advantech ASMB-787 = AMI MegaRAC SP-X 4.0 / AST2600).
#
# WHAT: `zbmc asmb787 <verb>` drives the virtual Advantech ASMB-787 BMC. qemu ast2600-evb (armv7l),
#       Linux 5.4.11-ami MegaRAC SP-X 4.0. Rootfs (squashfs) boots as a RAM disk; /conf, /usr/local/www,
#       /dre mount from the ORIGINAL 64MB NOR image via mtdparts whose mtdblock NUMBERS match the
#       firmware's /etc/dupfstab. Console on ttyS4.
# WHY:  first Advantech box in the zoo; sibling of the HPE Cray XD670 (same AMI SP-X / ast2600evb_ami
#       platform). Unpacked from encrypted_ASMB-787_20220912.ima_enc ("encrypted" is a misnomer — it
#       is plain XZ-SquashFS; see tools/unpack-ami).
#
# HISTORICAL (2026-08-27): retained serial login worked, measured at 9m38s on the reference host;
# external networking remained blocked by the 5.4.11-ami NC-SI mismatch.
# VERIFIED (2026-09-10): a deterministic derived kernel bypasses the forced NC-SI call after the
# FTGMAC direct-PHY path is initialized. A clean build and cold boot reached the serial console and
# guest-owned 10.250.0.50 over TAP; ARP resolved the QEMU NIC MAC and ICMP passed 20/20.
#
# ACCESS:
#   Console : zbmc asmb787 console            (serial ttyS4; login sysadmin / superuser -> uid 0 root)
#             zbmc asmb787 console '<cmd>'    (run one command over the console fifo)
#   Network : TAP/direct L2; guest owns the configured zBMC address
ZBMC_NAME=advantech-asmb787
ZBMC_NETWORK_MODE=tap
ZBMC_TAP=ztap-asmb
ZBMC_MAC=52:54:00:fa:00:50
ZBMC_DESC="Advantech ASMB-787 (MegaRAC/AST2600) - direct-L2 TAP and serial console verified"

# paths derive from this box file's location so it works from a fresh clone (sourced -> BASH_SOURCE).
PROJ_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"                        # boxes/advantech-asmb787/
ZBMC_DIR="${ZBMC_DIR:-$(cd "$PROJ_DIR/../.." && pwd)/work/$(basename "$PROJ_DIR")}"   # work/advantech-asmb787/

# Address comes from zbmc.conf and is owned by the guest FTGMAC.
ZBMC_IP=$(_zbmc_resolve_ip advantech-asmb787 50 10.0.10.10)
ZBMC_HOST=asmb787bmc
ZBMC_HINT='guest-owned TAP address and serial console verified; management-service repair is separate'
IPMI_USER=admin
IPMI_PW=superuser
IPMI_KEY=00
IPMI_OPTS=""
IPMI_T=20
SSH_USER=sysadmin
SSH_PW=superuser
SSH_PORT=22
IPMI_PORT=623
WEB_PORT=443
ZBMC_QEMU="$(cd "$PROJ_DIR/../.." && pwd)/qemu/runtime/qemu-system-arm-debian"
ZBMC_QEMU_SHA256=94e624f52653ecd1d226a2edd76e847dd46e00dc1ae5f4efed11fac5ef20898a
ZBMC_QEMU_MAJOR=10
ZBMC_QEMU_VERSION=10.0.11
ZBMC_QEMU_MACHINE=ast2600-evb
ZBMC_REQUIRED_SERVICES=console
ZBMC_DEFAULT_NO_WEB=1
ZBMC_PROBE_AFTER_BOOTSTRAP=1

PIDF="$ZBMC_DIR/zbmc.pid"
CONSOLE_LOG="${ZBMC_CONSOLE_LOG:-$ZBMC_DIR/svc.log}"
LOG="$CONSOLE_LOG"
SOCK="$ZBMC_DIR/cin"        # fifo: echo 'cmd' > "$SOCK" drives the console

# Boot artifacts if missing, then background the real init path. Reference login time: about 10 minutes.
zbmc_boot() {
  [ -f "$ZBMC_DIR/mtdflash.bin" ] || bash "$PROJ_DIR/build.sh" "$ZBMC_DIR" >/dev/null 2>&1
  rm -f "$ZBMC_DIR/.loggedin"                          # fresh boot = at the login prompt
  BG=1 IP="$ZBMC_IP" TAP="$ZBMC_TAP" MAC="$ZBMC_MAC" ZBMC_QEMU="$ZBMC_QEMU" \
    WD="$ZBMC_DIR" ZBMC_CONSOLE_LOG="$CONSOLE_LOG" \
    bash "$PROJ_DIR/boot.sh" >/dev/null 2>&1
  local n=0 qp=; while [ $n -lt 40 ]; do
    qp=$(pgrep -f "ifname=$ZBMC_TAP" | head -1); [ -n "$qp" ] && break
    sleep 0.3; n=$((n+1)); done
  [ -n "$qp" ] && echo "$qp" > "$PIDF"; echo "$qp"
}
zbmc_build() { WD="$ZBMC_DIR" bash "$PROJ_DIR/build.sh" "$ZBMC_DIR"; }
zbmc_ready() {
  [ -f "$ZBMC_DIR/mtdflash.bin" ] && [ -f "$ZBMC_DIR/kernel-direct.uImage" ] && \
    { echo "ready (built)"; return 0; }
  echo "not built — run: zbmc advantech-asmb787 build"; return 1
}

# console: no args = live tail. With a command, AUTO-LOGIN once (getty at 'login:'), then run it.
# Waits for each prompt (login:/Password:/shell) rather than fixed sleeps — robust under emulation load.
_c_seen() { tail -n 8 "$CONSOLE_LOG" 2>/dev/null | grep -q "$1"; }   # is $1 near the end of the console log?
_c_wait() { local t=0; until _c_seen "$1" || [ $t -ge "${2:-20}" ]; do sleep 1; t=$((t+1)); done; _c_seen "$1"; }
zbmc_console() {
  if [ $# -eq 0 ]; then tail -f "$CONSOLE_LOG"; return; fi
  if [ ! -f "$ZBMC_DIR/.loggedin" ]; then
    printf '\n' > "$SOCK"                                             # nudge a fresh login: prompt
    if _c_wait 'login:' 30; then
      printf '%s\n' "$SSH_USER" > "$SOCK"
      _c_wait 'Password:' 15 && printf '%s\n' "$SSH_PW" > "$SOCK"
    fi
    _c_wait '# ' 15 && touch "$ZBMC_DIR/.loggedin" || { echo "console: login didn't settle — retry the command"; return 1; }
  fi
  printf '%s\n' "$*" > "$SOCK"; sleep 2; tail -n 25 "$CONSOLE_LOG"
}
zbmc_console_health() {
  [ -p "$SOCK" ] && printf '\n' > "$SOCK"
  grep -q 'login:' "$CONSOLE_LOG" 2>/dev/null && { echo "serial login prompt observed"; return 0; }
  echo "waiting for serial login prompt"; return 1
}
# Management transport now reaches the guest directly. Full IPMI, protected
# Redfish/Web-UI, and privileged SSH acceptance remain separate service work.
zbmc_web()         { echo "$ZBMC_NAME: HTTPS root responds, but protected Redfish/Web-UI is not accepted yet"; return 1; }
zbmc_ipmi()        { echo "$ZBMC_NAME: RMCP+ session is not accepted yet"; return 1; }
zbmc_ipmi_health() { echo "RMCP+ session is not accepted yet"; return 1; }
zbmc_ssh()         { echo "$ZBMC_NAME: SSH authenticates, but firmware denies shell privilege"; return 1; }

ZBMC_READY_GREP='zbmc: Advantech direct-PHY FTGMAC address'
