# zbmc.box — virtual-BMC descriptor for "gb200" (Nvidia GB200NVL BMC, OpenBMC on ASPEED AST2600).
# Custom image built from source (bitbake MACHINE=gb200nvl-obmc; see reference_nvidia_oem_ipmi + the
# build notes). Boots the full flash image (.static.mtd = u-boot+kernel+rootfs) on qemu -M gb200nvl-bmc.
# NB: IPMI-over-LAN WORKS on a settled boot — net-ipmid comes up on its own (earlier "no net-ipmid" was
# wrong; it just starts late, after eth0). CIPHER-17 ONLY: use `zipmi -C 17 -I lanplus`. The NVIDIA OEM
# handlers (libnvidia_ipmi_oem.so, raw NetFn 0x3C) are reachable over LAN AND locally via busctl.
ZBMC_NAME=nvidia-obmc
ZBMC_DESC="Nvidia GB200NVL BMC (OpenBMC/AST2600) — NVIDIA OEM IPMI 0x3C; ipmi-LAN works (cipher-17 only) + busctl"
# Portable (clone-and-run): the .static.mtd firmware ships via firmware/download-fw.sh
# and boots with snapshot=on (writes to a throwaway overlay), so no work-dir copy needed.
PROJ_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_XREPO="$(cd "$PROJ_DIR/../.." && pwd)"
FIRMWARE_DIR="$_XREPO/firmware"
ZBMC_DIR="${ZBMC_DIR:-$_XREPO/work/$ZBMC_NAME}"

ZBMC_IP=$(_zbmc_resolve_ip nvidia-obmc 11 10.0.7.20)
ZBMC_HOST=nvidia-obmc

# ssh/redfish creds (Phosphor default on this build)
SSH_USER=root
SSH_PASS=0penBmc
IPMI_USER=root
IPMI_PW=0penBmc
IPMI_KEY=00
IPMI_OPTS="-C 17"   # gb200 net-ipmid offers cipher-17 only
SSH_PORT=22
WEB_PORT=443
IPMI_PORT=623

PIDF="$ZBMC_DIR/zbmc-nvidia-obmc.pid"
QMP_SOCK="$ZBMC_DIR/qmp.sock"
LOG="$ZBMC_DIR/nvidia-obmc-console.log"
SOCK="$ZBMC_DIR/nvidia-obmc-serial.sock"
CONSOLE_LOG="${ZBMC_CONSOLE_LOG:-$ZBMC_DIR/nvidia-obmc-uart.log}"
ZBMC_QEMU="$_XREPO/qemu/runtime/qemu-system-arm"
ZBMC_QEMU_SHA256=a066ffd52f50bc4555ea9af003e44e02aec3b3d260a37da8ab0b3d8c596790a6
ZBMC_QEMU_MAJOR=11
ZBMC_QEMU_VERSION=11.0.0
ZBMC_QEMU_MACHINE=gb200nvl-bmc
ZBMC_REQUIRED_SERVICES="ssh ipmi redfish webui"

zbmc_boot() {
  cd "$FIRMWARE_DIR" || return 1
  local MTD=obmc-phosphor-image-gb200nvl-obmc.static.mtd
  [ -e "$MTD" ] || { echo "missing $MTD — build not present" >&2; return 1; }
  local SUDO=; [ "$(id -u)" = 0 ] || SUDO=sudo
  _zbmc_lo_alias "$ZBMC_IP"
  grep -qE "[[:space:]]${ZBMC_HOST}([[:space:]]|\$)" /etc/hosts 2>/dev/null || \
    echo "$ZBMC_IP $ZBMC_HOST $ZBMC_NAME" | $SUDO tee -a /etc/hosts >/dev/null
  mkdir -p "$ZBMC_DIR"
  : > "$LOG"; $SUDO rm -f "$SOCK" "$QMP_SOCK" 2>/dev/null
  # snapshot=on -> writes go to a throwaway overlay, the built image stays pristine.
  $SUDO nohup "$ZBMC_QEMU" -M gb200nvl-bmc -smp 2 -m 1G -display none \
    -qmp "unix:$QMP_SOCK,server=on,wait=off" \
    -drive file="$MTD",format=raw,if=mtd,snapshot=on \
    -net nic,macaddr=3c:6d:66:14:c8:7a -net user,"hostfwd=tcp:$ZBMC_IP:$SSH_PORT-:22,hostfwd=tcp:$ZBMC_IP:$WEB_PORT-:443,hostfwd=udp:$ZBMC_IP:623-:623",hostname=qemu \
    -chardev "socket,id=serial0,path=$SOCK,server=on,wait=off,logfile=$CONSOLE_LOG,logappend=off" \
    -serial chardev:serial0 -serial null >"$LOG" 2>&1 &
  local n=0 qp=; while [ $n -lt 40 ]; do qp=$(pgrep -f "hostfwd=tcp:$ZBMC_IP:$SSH_PORT-:22" | head -1); [ -n "$qp" ] && break; sleep 0.3; n=$((n+1)); done
  echo "$qp"
}
zbmc_build() { echo "gb200 image is bitbake-built (MACHINE=gb200nvl-obmc) on dell; not a local rebuild. See reference_nvidia_oem_ipmi."; }
zbmc_ready() {
  [ -f "$FIRMWARE_DIR/obmc-phosphor-image-gb200nvl-obmc.static.mtd" ] && { echo "ready (firmware present)"; return 0; }
  echo "no firmware — run: firmware/download-fw.sh nvidia-obmc"; return 1
}

# ssh: password auth (Phosphor root/0penBmc). Real Linux shell (busybox).
zbmc_ssh() {
  command -v sshpass >/dev/null || { echo "need sshpass"; return 1; }
  exec sshpass -p "$SSH_PASS" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o ConnectTimeout=10 -p "$SSH_PORT" "$SSH_USER@$ZBMC_IP" "$@"
}
# Standard commands use IPMI-LAN. A leading numeric NetFn preserves the direct D-Bus OEM shorthand.
_nvidia_ipmi_lan() {
  timeout 12 env PYTHONPATH="$ZIPMI" python3 -m zipmi.cli.zipmi \
    -H "$ZBMC_IP" -p "$IPMI_PORT" -U "$IPMI_USER" -P "$IPMI_PW" -C 17 -I lanplus "$@"
}
zbmc_ipmi() {
  [ $# -eq 0 ] && { echo "usage: zbmc nvidia-obmc ipmi <command>; OEM D-Bus shorthand: 0x3c 0x37 0x01"; return 2; }
  case "$1" in 0x*|[0-9]*) ;; *) _nvidia_ipmi_lan "$@"; return;; esac
  [ $# -ge 2 ] || { echo "numeric OEM shorthand needs <netfn> <cmd> [data-bytes...]" >&2; return 2; }
  local nf="$1" cmd="$2"; shift 2; local data="$*" n=$#
  zbmc_ssh "busctl call xyz.openbmc_project.Ipmi.Host /xyz/openbmc_project/Ipmi xyz.openbmc_project.Ipmi.Server execute yyyaya{sv} $nf 0 $cmd $n $data 0"
}
zbmc_ipmi_health() {
  local r; r=$(_nvidia_ipmi_lan mc info 2>&1)
  if grep -q Manufacturer <<<"$r"; then
    echo "IPMI-LAN: OK (cipher-17 RMCP+; NVIDIA OEM 0x3C over LAN — zipmi -C 17)"; return 0
  fi
  echo "IPMI-LAN: no answer yet (cipher-17 only; net-ipmid starts late — retry once settled)"; return 1
}
zbmc_web() { echo "Redfish: curl -sk -u root:0penBmc https://$ZBMC_IP/redfish/v1/"; command -v curl >/dev/null && curl -sk --max-time 8 -u root:0penBmc "https://$ZBMC_IP/redfish/v1/" 2>/dev/null | head -c 200; echo; }
# interactive console on the qemu serial socket (UART1; escape = Ctrl-]). Root shell on the box console.
zbmc_console() { command -v socat >/dev/null || { echo "need socat"; return 1; }
  echo "console -> $SOCK  (Ctrl-] to detach)"; exec sudo socat -,raw,echo=0,escape=0x1d "UNIX-CONNECT:$SOCK"; }
ZBMC_READY_GREP='login:'
