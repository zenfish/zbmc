# zbmc.box — virtual-BMC descriptor for "supermicro-h13f" (Supermicro H13 F401MS BMC = ATEN AST2600, FW 01.06.05).
#
# WHAT: virtual Supermicro H13 (F401MS) BMC running the real ATEN userland. jffs2-on-NOR
#       ATEN layout (same class as X12): root = mtdblock1 (rofs squashfs @0x100000),
#       /web = mtdblock3, /nv = mtdblock4 (jffs2, guest formats). No eMMC.
# WHY:  H13 is the AMD-SP5-generation ATEN BMC. Ships the fixed factory ADMIN blob and the
#       fleet-shared etc/conf/key_iv.key + the hardcoded at-rest AES key in libipmi.so
#       fleet-shared etc/conf/key_iv.key + the hardcoded at-rest AES key in libipmi.so.
#       Distinct board profile from the X-series (F401MS vs 5201MS/2401MS).
# BOOT: direct-kernel (vendor kernel carved from the NOR FIT @0x1d00000, dtb patched for
#       FMC), root=/dev/mtdblock1, no initramfs. Cold only (~2 min).
#
# ACCESS (Supermicro ATEN factory default — password auth):
#   IPMI    : zipmi -H 10.0.8.16 -U ADMIN -P ADMIN <cmd>
#   Web     : curl -sk https://10.0.8.16/page/login.www
#   SSH     : sshpass -p ADMIN ssh ADMIN@10.0.8.16
#   Console : zbmc supermicro-h13f console
ZBMC_NAME=supermicro-h13f
ZBMC_DESC="Supermicro H13 F401MS BMC (ATEN AST2600, FW 01.06.05) — AMD-SP5 ATEN, jffs2-on-NOR; ADMIN:ADMIN; real IPMI+web"

PROJ_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_XREPO="$(cd "$PROJ_DIR/../.." && pwd)"
ZBMC_DIR="${ZBMC_DIR:-$_XREPO/work/supermicro-h13f}"
FLASH="$_XREPO/firmware/smc-h13f-01.06.05.bin"

ZBMC_IP=10.0.8.16
ZBMC_HOST=h13fbmc

IPMI_USER=ADMIN
IPMI_PW=ADMIN
IPMI_KEY=00
IPMI_OPTS=""
IPMI_T=8
SSH_USER=ADMIN
SSH_PW=ADMIN
SSH_PORT=22
IPMI_PORT=623
WEB_PORT=443

PIDF=/tmp/zbmc-supermicro-h13f.pid
LOG="$ZBMC_DIR/console.log"
SOCK="$ZBMC_DIR/console.sock"

zbmc_build() {
  mkdir -p "$ZBMC_DIR"
  [ -f "$FLASH" ] || bash "$_XREPO/firmware/download-fw.sh" supermicro-h13f
  [ -f "$FLASH" ] || { echo "firmware missing: $FLASH" >&2; return 1; }
  # H13F is jffs2-on-NOR (root on mtdblock1); carve kernel+dtb, keep the vendor partitions.
  python3 "$_XREPO/tools/aten-carve.py" "$FLASH" "$ZBMC_DIR" --fit-off 0x1d00000
  echo "built: $ZBMC_DIR (kernel.bin fdt-patched.dtb)"
}

zbmc_boot() {
  mkdir -p "$ZBMC_DIR"
  [ -f "$ZBMC_DIR/kernel.bin" ] || zbmc_build || return 1
  local SUDO=; [ "$(id -u)" = 0 ] || SUDO=sudo
  $SUDO ifconfig lo0 alias "$ZBMC_IP" up 2>/dev/null
  grep -qE "[[:space:]]${ZBMC_HOST}([[:space:]]|\$)" /etc/hosts 2>/dev/null || \
    echo "$ZBMC_IP $ZBMC_HOST $ZBMC_NAME" | $SUDO tee -a /etc/hosts >/dev/null
  $SUDO rm -f "$SOCK" 2>/dev/null
  WD="$ZBMC_DIR" FLASH="$FLASH" EMMC="" ZBMC_IP="$ZBMC_IP" \
    CONSOLE_SOCK="$SOCK" LOG="$LOG" ROOT_MTD=1 \
    nohup bash "$_XREPO/tools/aten-boot.sh" >>"$LOG" 2>&1 &
  local n=0 qp=; while [ $n -lt 60 ]; do
    qp=$(pgrep -f "hostfwd=udp:$ZBMC_IP:623-:623" | head -1); [ -n "$qp" ] && break
    sleep 0.3; n=$((n+1)); done
  echo "$qp"
}

zbmc_ssh() {
  command -v sshpass >/dev/null || { echo "need sshpass"; return 1; }
  sshpass -p "$SSH_PW" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o ConnectTimeout=8 -o LogLevel=ERROR "$SSH_USER@$ZBMC_IP" "$@"
}

zbmc_ipmi() {
  timeout -s KILL "$(( IPMI_T + 6 ))" \
    env PYTHONPATH="$ZIPMI" python3 -m zipmi.cli.zipmi \
    -H "$ZBMC_IP" -p "${IPMI_PORT:-623}" -U "$IPMI_USER" -P "$IPMI_PW" -t "${IPMI_T:-8}" "$@" 2>&1
}

zbmc_ipmi_health() {
  local r; r=$(zbmc_ipmi mc info)
  if echo "$r" | grep -q "IPMI Version"; then
    echo "AUTH OK (zipmi RMCP+; ADMIN:ADMIN)"; return 0
  else
    echo "no answer (first boot formats /nv, ~2 min)"; return 1
  fi
}

zbmc_web() {
  if curl -sk --max-time 8 "https://$ZBMC_IP/page/login.www" 2>/dev/null | grep -qi "login\|Supermicro"; then
    echo "h13f web: UP  (curl -sk https://$ZBMC_HOST/page/login.www)"
  else
    echo "h13f web: down/warming — zbmc $ZBMC_NAME status -f"
  fi
}

zbmc_console() { command -v socat >/dev/null || { echo "need socat"; return 1; }
  echo "console -> $SOCK  (Ctrl-] to detach)"; exec sudo socat -,raw,echo=0,escape=0x1d "UNIX-CONNECT:$SOCK"; }

ZBMC_READY_GREP='login:'
