# zbmc.box — virtual-BMC descriptor for "x14" (Supermicro X14 BMC = Phosphor OpenBMC / AST2600-ROT).
#
# WHAT: makes `zbmc x14 <verb>` drive the virtual Supermicro X14 BMC, exactly like `zbmc idrac10`.
#       qemu is ast2600-evb (armv7l), bound to the real IP 10.0.8.14 (lo0 alias) with hostfwd
#       tcp 22/443 + udp 623. Serial console is the unix socket /tmp/x14.sock; QMP /tmp/x14-qmp.sock.
# WHY:  X14 is the OpenBMC counterpart to the Dell iDRAC boxes in this framework — one control tool.
# BOOT: FAST PATH restores a warm QMP snapshot (svc-snap-shell.gz: IPMI + Redfish + SSH shell all
#       working) in ~10s with a LIVE network (-incoming keeps 623/443/22 up). ZBMC_COLD=1 (or a
#       missing snapshot) falls back to a full cold boot to an interactive shell (shell-x14.sh).
#
# ACCESS (unlike the iDRAC boxes, X14 is PASSWORD auth — NOT the zipmi factory IPMIKey):
#   SSH     : ssh ADMIN@10.0.8.14  pw ADMIN  -> real Linux /bin/sh (SMASH_ENABLE=0 baked in);
#             sudo -i (pw ADMIN) -> root.   [we use sshpass -p ADMIN, StrictHostKeyChecking=no]
#   IPMI    : zipmi -H 10.0.8.14 -U ADMIN -P ADMIN <cmd>   (user/channel/etc. work;
#             `mc info` returns 0xff — one-handler quirk — so status probes `channel info 1`).
#   Redfish : curl -sk -u ADMIN:ADMIN https://10.0.8.14/redfish/v1/...   (served by the restore).
#
# Sourced by the `zbmc` dispatcher (~/phd/bin/zbmc). Root-direct model: qemu runs as root and binds
# the box's real IP + standard ports directly. The wrapped scripts live in the X14 scratch workdir.
ZBMC_NAME=supermicro-x14
ZBMC_DESC="Supermicro X14 BMC (Phosphor OpenBMC/AST2600-ROT, armv7l) — password auth (ADMIN:ADMIN); warm-restore snapshot"

# Scripts + snapshots live in the X14 scratch workdir (restore/snapshot/shell scripts cd there).
# Portable (clone-and-run): scripts ship in THIS box dir; snapshot + boot artifacts in work/.
PROJ_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ZBMC_DIR="${ZBMC_DIR:-$(cd "$PROJ_DIR/../.." && pwd)/work/supermicro-x14}"
SNAP=svc-snap-shell.gz   # canonical warm snapshot: IPMI + Redfish + interactive SSH shell
ZBMC_QEMU=/home/zen/opt/qemu-11/bin/qemu-system-arm
ZBMC_QEMU_MAJOR=11
ZBMC_QEMU_MACHINE=ast2600-evb

# Real IP + /etc/hosts name (X14 = 10.0.8.14 in the 10.0.8.x scheme). Ports bound directly by qemu.
ZBMC_IP=$(_zbmc_resolve_ip supermicro-x14 21 10.0.8.14)
ZBMC_HOST=x14bmc

# IPMI: password auth via zipmi (ADMIN:ADMIN). IPMI_KEY unused but kept for the
# dispatcher's key-fallback signature.
IPMI_USER=ADMIN
IPMI_PW=ADMIN
IPMI_KEY=00
IPMI_OPTS=""
IPMI_T=6

# SSH: password auth via sshpass, NOT the iDRAC serial-socat path.
SSH_USER=ADMIN
SSH_PW=ADMIN

SSH_PORT=$(_zbmc_pick_port 22 2222)
IPMI_PORT=623
WEB_PORT=$(_zbmc_pick_port 443 8443)

PIDF=/tmp/zbmc-supermicro-x14.pid
LOG=/tmp/x14-restore-console.log     # restore-svc-x14.sh writes qemu console here
SOCK=/tmp/x14.sock                   # root-owned serial console unix socket
CONSOLE_LOG="${ZBMC_CONSOLE_LOG:-$LOG}"

# boot: FAST PATH restores the warm snapshot (~10s, network live). Cold-boot fallback (shell-x14.sh,
# interactive /bin/sh as PID1) when ZBMC_COLD=1 or the snapshot is missing. Prints the qemu pid.
zbmc_boot() {
  mkdir -p "$ZBMC_DIR"; cd "$ZBMC_DIR" || return 1
  local SUDO=; [ "$(id -u)" = 0 ] || SUDO=sudo
  _zbmc_lo_alias "$ZBMC_IP"
  grep -qE "[[:space:]]${ZBMC_HOST}([[:space:]]|\$)" /etc/hosts 2>/dev/null || \
    echo "$ZBMC_IP $ZBMC_HOST $ZBMC_NAME" | $SUDO tee -a /etc/hosts >/dev/null
  if [ -z "${ZBMC_COLD:-}" ] && [ -f "$ZBMC_DIR/$SNAP" ]; then
    ZBMC_CONSOLE_LOG="$CONSOLE_LOG" WD="$ZBMC_DIR" QEMU="$ZBMC_QEMU" bash "$PROJ_DIR/restore-svc-x14.sh" "$SNAP" >>"$LOG" 2>&1   # backgrounds qemu, network live ~10s
  else
    [ -f "$ZBMC_DIR/$SNAP" ] || echo "snapshot $SNAP missing — cold boot (shell)" >&2
    : > "$LOG"
    ZBMC_CONSOLE_LOG="$CONSOLE_LOG" WD="$ZBMC_DIR" QEMU="$ZBMC_QEMU" nohup bash "$PROJ_DIR/shell-x14.sh" >>"$LOG" 2>&1 &   # cold boot to interactive shell (~55s)
  fi
  # wait for the qemu whose hostfwd matches this box's IPMI port to appear, print its pid
  local n=0 qp=; while [ $n -lt 60 ]; do
    qp=$(pgrep -f "hostfwd=udp:$ZBMC_IP:623-:623" | head -1); [ -n "$qp" ] && break
    sleep 0.3; n=$((n+1)); done
  echo "$qp"
}

zbmc_build() { echo "x14 boot is snapshot-driven — see SNAPSHOTS.md; kernel.bin/initramfs-patched.bin + the .gz snapshots are prebuilt. Cold shell: ZBMC_COLD=1 zbmc x14 start"; }
zbmc_ready() {
  local d="$ZBMC_DIR"
  if [ -f "$d/kernel.bin" ] && [ -f "$d/initramfs-patched.bin" ]; then
    [ -f "$d/$SNAP" ] && { echo "ready (warm snapshot)"; return 0; }
    echo "ready (cold boot only — no snapshot)"; return 0
  fi
  echo "not built — need kernel.bin + initramfs-patched.bin in work/"; return 1
}

# snapshot: QMP-checkpoint the running instance to a gz (pauses the VM — restore to resume).
zbmc_snapshot() { WD="$ZBMC_DIR" bash "$PROJ_DIR/snapshot-x14.sh" "${1:-$SNAP}"; }
# restore: bring a warm snapshot up on the real IP (what `start` does automatically).
zbmc_restore()  { ZBMC_CONSOLE_LOG="$CONSOLE_LOG" WD="$ZBMC_DIR" QEMU="$ZBMC_QEMU" bash "$PROJ_DIR/restore-svc-x14.sh" "${1:-$SNAP}"; }

# ssh: password auth (sshpass). Real Linux shell; `sudo -i` for root. Args = remote command.
zbmc_ssh() {
  sshpass -p "$SSH_PW" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o ConnectTimeout=8 -o LogLevel=ERROR "$SSH_USER@$ZBMC_IP" "$@"
}

# ipmi: zipmi RMCP+ password auth (ADMIN:ADMIN). mc info returns 0xff on X14, so health uses channel info 1.
zbmc_ipmi() {
  timeout -s KILL "$(( IPMI_T + 6 ))" \
    env PYTHONPATH="$ZIPMI" python3 -m zipmi.cli.zipmi \
    -H "$ZBMC_IP" -p "${IPMI_PORT:-623}" -U "$IPMI_USER" -P "$IPMI_PW" -t "${IPMI_T:-6}" "$@" 2>&1
}

# ipmi health for `status`: `mc info` returns 0xff on X14 (one-handler quirk), so probe channel info.
# Prints its own status line; returns 0 when the RMCP+ session authenticates.
zbmc_ipmi_health() {
  local r; r=$(zbmc_ipmi channel info 1)
  if echo "$r" | grep -qE 'Channel Medium Type|Medium type[[:space:]]*:'; then
    echo "AUTH OK (zipmi RMCP+; ADMIN:ADMIN — mc info=0xff quirk)"; return 0
  else
    echo "no answer (restore warming/down)"; return 1
  fi
}

# web: X14 Redfish is served by the restored instance already — verify it (health check, no bring-up).
zbmc_web() {
  if curl -sk -u "$IPMI_USER:$IPMI_PW" "https://$ZBMC_IP/redfish/v1/" 2>/dev/null | grep -q ServiceRoot; then
    echo "x14 Redfish: UP  (curl -sk -u $IPMI_USER:$IPMI_PW https://$ZBMC_HOST/redfish/v1/)"
  else
    echo "x14 Redfish: down — restore not up? (zbmc x14 start)"
  fi
}

ZBMC_READY_GREP='network live'
