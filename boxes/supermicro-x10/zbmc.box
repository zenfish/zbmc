# zbmc.box — virtual-BMC descriptor for "x10" (Supermicro X10 BMC = ASPEED AST2400, FW 3.93).
#
# WHAT: `zbmc x10 <verb>` drives a virtual Supermicro X10 BMC. qemu -M supermicrox11-bmc
#       (AST2400, ARMv5) boots the 32MB flash; a pexpect driver fixes guest networking
#       (firmware zeroes its MAC + fails eth0->bond0, so no DHCP) per trouble.org's
#       python-shim recipe, then holds qemu alive with hostfwd udp $ZBMC_IP:623.
# WHY:  THE WEAK-CIPHER ORACLE. Unlike the modern zoo (idrac9/10/x14 offer only 3+17),
#       X10-era firmware advertises the FULL IPMI 2.0 cipher set 0-14 — including the
#       RC4/MD5 suites 4,5,9,10,11,12,13,14 that ipmitool never implemented and modern
#       BMCs dropped. This is the authorized local target for verifying zipmi's MD5-128
#       (integrity alg 3) and xRC4-128/40 (conf alg 2/3) against real firmware.
# BOOT: cold only (~60s to network-ready). No snapshot machinery — the flat flash boots
#       clean first try; start-x10.sh nohup's the driver and waits for NET_CONFIGURED.
#
# ACCESS (Supermicro factory default — password auth, NOT the zipmi -K factory key):
#   IPMI : zipmi -H 10.0.8.10 -U ADMIN -P ADMIN <cmd>   (RMCP+; offers cipher 0-14)
#          e.g.  zipmi -H 10.0.8.10 -U ADMIN -P ADMIN -C 11 mc info
#   scan : zipmi -H 10.0.8.10 -U ADMIN -P ADMIN scan cipher-suites   -> [0..14]
#
# NET: zoo-standard model (like x14). qemu runs under sudo, binds the lo0 alias
#      10.0.8.10 on the standard privileged port 623/udp directly. zbmc_boot
#      aliases lo0 + primes sudo before launching the pexpect driver.
#
# Sourced by ~/phd/bin/zbmc. Reproducible from ipmi.old/fw/BMC_X10AST2400-32M_20210528_03.93_STD.bin.
ZBMC_NAME=supermicro-x10
ZBMC_DESC="Supermicro X10 BMC (ASPEED AST2400, FW 3.93) — weak-cipher ORACLE: offers IPMI 2.0 suites 0-14 (RC4/MD5); ADMIN:ADMIN"

# Portable paths (clone-and-run): scripts ship in THIS box dir; runtime artifacts go
# to the repo's work/; the master flash comes from firmware/ (fetch via
# firmware/download-fw.sh supermicro-x10). No author-absolute paths.
PROJ_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_XREPO="$(cd "$PROJ_DIR/../.." && pwd)"
ZBMC_DIR="$_XREPO/work/supermicro-x10"
X10_MASTER="$_XREPO/firmware/x10-master.flash"

# Zoo subnet target: qemu user-net forwards udp 10.0.8.10:623 -> guest 623, bound
# on a lo0 alias (qemu under sudo, like x14). zbmc_boot aliases lo0 + primes sudo,
# then the pexpect driver spawns `sudo -n qemu`. running() greps $PIDF / the 623
# hostfwd, both now on 10.0.8.10.
ZBMC_IP=$(_zbmc_resolve_ip supermicro-x10 20 10.0.8.10)
ZBMC_HOSTPORT=623
ZBMC_HOST=x10bmc

IPMI_USER=ADMIN
IPMI_PW=ADMIN
IPMI_KEY=00
IPMI_OPTS=""
IPMI_T=6

SSH_USER=ADMIN
SSH_PW=ADMIN
IPMI_PORT=623

SSH_PORT=22
WEB_PORT=443
export X10_SSH_PORT="$SSH_PORT" X10_WEB_PORT="$WEB_PORT"
X10_NET_MODE=direct
X10_TAP=ztap-x10
X10_AUX_TAP=ztap-x10-aux
X10_NETMASK=255.0.0.0
X10_GATEWAY=10.0.0.1
ZBMC_QEMU="$_XREPO/qemu/runtime/qemu-system-arm"
ZBMC_QEMU_SHA256=a066ffd52f50bc4555ea9af003e44e02aec3b3d260a37da8ab0b3d8c596790a6
ZBMC_QEMU_MAJOR=11
ZBMC_QEMU_VERSION=11.0.0
ZBMC_QEMU_MACHINE=supermicrox11-bmc
export X10_NET_MODE X10_TAP X10_AUX_TAP X10_NETMASK X10_GATEWAY ZBMC_QEMU

PIDF="$ZBMC_DIR/zbmc.pid"
SOCK="$ZBMC_DIR/x10-serial.sock"
QMP_SOCK="$ZBMC_DIR/x10-qmp.sock"
LOG="$ZBMC_DIR/x10-start.log"
CONSOLE_LOG="${ZBMC_CONSOLE_LOG:-$ZBMC_DIR/x10-console.log}"
ZBMC_BOOTSTRAP_PIDF="$ZBMC_DIR/x10-driver.pid"
ZBMC_GUEST_SNAPSHOT_AT=bootstrap
ZBMC_READY_DEADLINE=300
ZBMC_REQUIRED_SERVICES="ssh ipmi redfish"
ZBMC_REMEDIATION="FTGMAC hardware-reset restore + RX interrupt kick (experimental)"
ZBMC_STABILITY_SECONDS=60
ZBMC_TIMING_PROFILE=stable60-v1
ZBMC_PROBE_AFTER_BOOTSTRAP=1
ZBMC_CAPTURE_INTERFACES="br-zbmc $X10_TAP $X10_AUX_TAP"
ZBMC_SYSLOG_PORT=5514
# Initial expectations come from prior observed cold boots. Successful run records
# replace these profiles with measured averages and ranges automatically.
ZBMC_EXPECTED_FIRMWARE=5
ZBMC_EXPECTED_BOOTSTRAP=130
ZBMC_EXPECTED_L2=95
ZBMC_EXPECTED_READY=190

# boot: alias lo0 + prime sudo (so start-x10.sh's `sudo -n qemu` never prompts),
# then launch the detached driver; it prints the qemu pid on NET_CONFIGURED.
# Write that pid to PIDF as the reliable handle for the dispatcher's running().
zbmc_boot() {
  local SUDO=; [ "$(id -u)" = 0 ] || SUDO=sudo
  $SUDO ip addr del "$ZBMC_IP/32" dev lo 2>/dev/null || true
  $SUDO "$PROJ_DIR/../../tools/zbmc-net" add-tap "$X10_TAP" "${SUDO_USER:-${USER}}" || return 1
  $SUDO "$PROJ_DIR/../../tools/zbmc-net" add-tap "$X10_AUX_TAP" "${SUDO_USER:-${USER}}" || return 1
  mkdir -p "$ZBMC_DIR"
  WD="$ZBMC_DIR" X10_MASTER="$X10_MASTER" ZBMC_IP="$ZBMC_IP" ZBMC_CONSOLE_LOG="$CONSOLE_LOG" \
    X10_QEMU="$ZBMC_QEMU" X10_LAUNCH_ONLY=1 X10_PACKET_DIR="${ZBMC_RUN_DIR:-$ZBMC_DIR}/packets" \
    bash "$PROJ_DIR/start-x10.sh" >/dev/null 2>&1
  local qp; qp=$(pgrep -f "^[^ ]*/qemu-system-arm .*ifname=$X10_TAP" | head -1)
  [ -n "$qp" ] && echo "$qp" > "$PIDF"
  echo "$qp"
}

zbmc_running() { pgrep -f "^[^ ]*/qemu-system-arm .*ifname=$X10_TAP" | head -1; }

zbmc_build() { echo "x10 boots the flat flash directly (no snapshot). Master: $X10_MASTER (fetch: firmware/download-fw.sh supermicro-x10; orig BMC_X10AST2400-32M_20210528_03.93_STD.bin). Cold boot ~60s."; }
zbmc_ready() {
  [ -f "$X10_MASTER" ] && { echo "ready (firmware present)"; return 0; }
  echo "no firmware — run: firmware/download-fw.sh supermicro-x10"; return 1
}

# ipmi: zipmi password-auth on 10.0.8.10:623 (we WANT zipmi's cipher stack
# exercised, not ipmitool). Generous timeout — scan probes ~20 suites.
zbmc_ipmi() {
  timeout -s KILL "$(( IPMI_T + 30 ))" \
    env PYTHONPATH="$ZIPMI" python3 -m zipmi.cli.zipmi \
    -H "$ZBMC_IP" -p "$ZBMC_HOSTPORT" -U "$IPMI_USER" -P "$IPMI_PW" -t "$IPMI_T" "$@" 2>&1
}

# status health: mc info over RMCP+ (default cipher). Prints its own line; 0 on OK.
zbmc_ipmi_health() {
  local r; r=$(zbmc_ipmi mc info)
  if echo "$r" | grep -qi "Manufacturer Name"; then
    echo "AUTH OK (zipmi RMCP+; $(echo "$r" | grep -i 'Firmware Rev' | tr -s ' '))"; return 0
  else
    echo "no answer (booting ~60s / down)"; return 1
  fi
}

# SSH into X10 BMC (Dropbear, patched at boot to give /bin/ash instead of SMASH-CLP).
# Legacy key types required: modern OpenSSH rejects ssh-rsa/ssh-dss by default.
# This custom dropbear ignores SSH exec requests — commands must be piped via stdin
# (echo 'cmd' | zbmc ssh), not passed as args. The probe uses stdin 'echo up'.
# OpenSSH <10: +ssh-rsa,ssh-dss re-enables legacy algs. OpenSSH >=10: ssh-dss removed,
# and +prefix is invalid; use ssh-rsa directly.
if ssh -Q key 2>/dev/null | grep -q ssh-dss; then
  _x10_hka="HostKeyAlgorithms=+ssh-rsa,ssh-dss" _x10_pka="PubkeyAcceptedAlgorithms=+ssh-rsa,ssh-dss"
else
  _x10_hka="HostKeyAlgorithms=ssh-rsa" _x10_pka="PubkeyAcceptedAlgorithms=ssh-rsa"
fi
_x10_ssh_opts=(-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
  -o "$_x10_hka" -o "$_x10_pka" -o ConnectTimeout=4)
zbmc_ssh() {
  if [ "$*" = "echo up" ]; then
    local out; out=$(echo 'echo up; exit' | sshpass -p "$SSH_PW" ssh -T "${_x10_ssh_opts[@]}" \
      -p "$SSH_PORT" "$SSH_USER@$ZBMC_IP" 2>/dev/null)
    echo "$out" | grep -q "up" && echo "up"
  else
    sshpass -p "$SSH_PW" ssh "${_x10_ssh_opts[@]}" \
      -p "$SSH_PORT" "$SSH_USER@$ZBMC_IP" "$@"
  fi
}

zbmc_web() {
  local url="https://$ZBMC_IP:${WEB_PORT:-443}/"
  echo "x10 web: $url  (lighttpd; port 443 forwarded via QEMU slirp)"
  echo "  curl -sk $url"
  echo "  curl -sk -u ADMIN:ADMIN $url/redfish/v1/  (license bypass via LD_PRELOAD)"
}

zbmc_redfish_health() {
  local r detail; r=$(curl -sk --max-time 4 -u "$IPMI_USER:$IPMI_PW" "https://$ZBMC_IP:${WEB_PORT:-443}/redfish/v1/" 2>/dev/null)
  if echo "$r" | grep -q '"RedfishVersion"'; then
    detail=$(echo "$r" | python3 -c 'import sys,json; d=json.load(sys.stdin); print("Redfish %s" % d.get("RedfishVersion", "?"))' 2>/dev/null)
    echo "REDFISH OK (${detail:-authenticated service root})"; return 0
  else
    echo "REDFISH down (license bypass may not be applied)"; return 1
  fi
}

# One-shot guest-side sensor snapshot after the serial bootstrap releases the socket.
# X10's ancient ftgmac receive path can panic on larger SSH flows, so instrumentation
# must not add another network session. Serial is bounded and outside that data path.
zbmc_guest_snapshot() {
  {
    printf '\necho "[identity]"; date; uname -a\n'
    printf 'echo "[interfaces]"; ifconfig -a\n'
    printf 'echo "[routes]"; cat /proc/net/route\n'
    printf 'echo "[counters]"; cat /proc/net/dev\n'
    printf 'echo "[processes]"; ps w\n'
    printf 'echo "[listeners]"; netstat -anp 2>/dev/null\n'
    printf 'echo "[logging-tools]"; command -v syslogd klogd logread logger 2>/dev/null; syslogd --help 2>&1; echo "[syslog-config]"; cat /etc/syslog.conf 2>/dev/null; ls -l /dev/log /var/log 2>/dev/null; logread 2>/dev/null | tail -100\n'
    printf 'echo "[dmesg-tail]"; dmesg | tail -80\n'
    sleep 4
  } | timeout -s KILL 10 socat - "UNIX-CONNECT:$SOCK"
}

# Interactive root shell via serial UNIX socket (socat). Ctrl-] to detach.
# SSH also gives root (patched at boot), but serial is always available.
zbmc_shell() { socat -,raw,echo=0,escape=0x1d "UNIX-CONNECT:$SOCK"; }

# Console: interactive serial login (not a log tail — press Enter for prompt).
# For boot/dmesg output, see $LOG (x10-console.log during start-x10.py, then quiet).
zbmc_console() {
  echo "serial login → $SOCK  (press Enter for prompt; Ctrl-] to detach)"
  socat -,raw,echo=0,escape=0x1d "UNIX-CONNECT:$SOCK"
}

ZBMC_READY_GREP='NET_CONFIGURED'
