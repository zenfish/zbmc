# zbmc.box — HPE XD670 BMC (AMI MegaRAC SP-X / AST2600), the network-green MegaRAC box.
#
# WHAT: `zbmc megarac-hpe <verb>` boots the XD670 MegaRAC SP-X firmware on qemu ast2600-evb (direct-kernel,
#       rootfs as RAM disk, /conf from a NAMED-partition NOR image). Unlike advantech-asmb787, this build's
#       newer kernel brings the network up under qemu, so IPMI 2.0 RMCP+ and authenticated Redfish work.
# TURNKEY: firmware (BMC HPM) fetched by download-fw.sh (mirror); build.sh carves+patches it.
#
# ACCESS:
#   ipmi    : zbmc megarac-hpe ipmi mc info          (RMCP+ lanplus, admin/superuser)
#   redfish : zbmc megarac-hpe web                    (curl -u admin:superuser https://127.0.0.1:5443/redfish/v1/Managers)
#   console : zbmc megarac-hpe console 'id'           (serial ttyS4; auto-login sysadmin/superuser = root)
ZBMC_NAME=megarac-hpe
ZBMC_DESC="HPE XD670 BMC (AMI MegaRAC SP-X / AST2600, armv7l) — warm-snapshot restore; IPMI 2.0 RMCP+ + authed Redfish WORK (admin/superuser)"

PROJ_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ZBMC_DIR="${ZBMC_DIR:-$(cd "$PROJ_DIR/../.." && pwd)/work/$(basename "$PROJ_DIR")}"

ZBMC_IP=127.0.0.1
ZBMC_HOST=megarac-hpe
IPMI_USER=admin
IPMI_PW=superuser
IPMI_T=20
SSH_USER=sysadmin        # console/Linux account (different from the IPMI user)
SSH_PW=superuser
SSH_PORT=5022
WEB_PORT=5443
IPMI_PORT=5623
ZBMC_HINT='zbmc megarac-hpe ipmi mc info  |  zbmc megarac-hpe web  |  zbmc megarac-hpe console "id"   (admin/superuser)'

PIDF=/tmp/zbmc-megarac-hpe.pid
LOG="$ZBMC_DIR/svc.log"
SOCK="$ZBMC_DIR/cin"

# boot: restore the warm snapshot, verify IPMI answers; re-restore up to 3x. One qemu at a time.
zbmc_boot() {
  [ -f "$ZBMC_DIR/cray-snap.gz" ] || bash "$PROJ_DIR/build.sh" "$ZBMC_DIR" >/dev/null 2>&1
  rm -f "$ZBMC_DIR/.loggedin"
  local try qp
  for try in 1 2 3; do
    pkill -9 -f "$ZBMC_DIR/cray-snap-flash.bin" 2>/dev/null; sleep 1
    qp=$(BG=1 IP="$ZBMC_IP" SSH_PORT="$SSH_PORT" HTTPS_PORT="$WEB_PORT" IPMI_PORT="$IPMI_PORT" WD="$ZBMC_DIR" \
         bash "$PROJ_DIR/boot.sh" 2>/dev/null)
    sleep 6
    if zbmc_ipmi mc info 2>/dev/null | grep -qi 'Manufacturer'; then break; fi
  done
  [ -n "${qp:-}" ] && echo "$qp" > "$PIDF"; echo "${qp:-}"
}
zbmc_build() { WD="$ZBMC_DIR" bash "$PROJ_DIR/build.sh" "$ZBMC_DIR"; }

# ipmi: RMCP+ lanplus with the MegaRAC default admin/superuser.
zbmc_ipmi() {
  timeout -s KILL "$((IPMI_T+8))" ipmitool -I lanplus -H "$ZBMC_IP" -p "$IPMI_PORT" \
    -U "$IPMI_USER" -P "$IPMI_PW" "$@" 2>&1
}
zbmc_ipmi_health() {
  if zbmc_ipmi mc info 2>/dev/null | grep -qi 'Manufacturer'; then echo "AUTH OK (RMCP+ lanplus admin/superuser)"; return 0
  else echo "no answer (still booting? RMCP+ slow under emulation — IPMI_T=$IPMI_T)"; return 1; fi
}
zbmc_web() {
  if curl -sk --max-time 8 -u "$IPMI_USER:$IPMI_PW" "https://$ZBMC_IP:$WEB_PORT/redfish/v1/Managers" 2>/dev/null | grep -q ManagerCollection; then
    echo "megarac-hpe Redfish: UP  (curl -sk -u admin:superuser https://$ZBMC_IP:$WEB_PORT/redfish/v1/Managers)"
  else echo "megarac-hpe Redfish: not answering yet (still booting? ~2 min)"; fi
}
# ssh is loopback-only under emulation; use the console.
zbmc_ssh() { echo "megarac-hpe: use the console — zbmc megarac-hpe console (login sysadmin/superuser)"; return 1; }

# console: no args = live tail. With a command, AUTO-LOGIN once (waits for prompts), then run it.
_c_seen() { tail -n 8 "$LOG" 2>/dev/null | grep -q "$1"; }
_c_wait() { local t=0; until _c_seen "$1" || [ $t -ge "${2:-20}" ]; do sleep 1; t=$((t+1)); done; _c_seen "$1"; }
zbmc_console() {
  if [ $# -eq 0 ]; then tail -f "$LOG"; return; fi
  if [ ! -f "$ZBMC_DIR/.loggedin" ]; then
    printf '\n' > "$SOCK"
    if _c_wait 'login:' 30; then
      printf '%s\n' "$SSH_USER" > "$SOCK"; _c_wait 'Password:' 15 && printf '%s\n' "$SSH_PW" > "$SOCK"
    fi
    _c_wait '# ' 15 && touch "$ZBMC_DIR/.loggedin" || { echo "console: login didn't settle — retry"; return 1; }
  fi
  printf '%s\n' "$*" > "$SOCK"; sleep 2; tail -n 25 "$LOG"
}

ZBMC_READY_GREP='login:'
