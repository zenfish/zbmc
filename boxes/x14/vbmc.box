# vbmc.box — virtual-BMC descriptor for "x14" (Supermicro X14 BMC = Phosphor OpenBMC / AST2600-ROT).
#
# WHAT: makes `vbmc x14 <verb>` drive the virtual Supermicro X14 BMC, exactly like `vbmc idrac10`.
#       qemu is ast2600-evb (armv7l), bound to the real IP 10.0.8.14 (lo0 alias) with hostfwd
#       tcp 22/443 + udp 623. Serial console is the unix socket /tmp/x14.sock; QMP /tmp/x14-qmp.sock.
# WHY:  X14 is the OpenBMC counterpart to the Dell iDRAC boxes in this framework — one control tool.
# BOOT: FAST PATH restores a warm QMP snapshot (svc-snap-shell.gz: IPMI + Redfish + SSH shell all
#       working) in ~10s with a LIVE network (-incoming keeps 623/443/22 up). VBMC_COLD=1 (or a
#       missing snapshot) falls back to a full cold boot to an interactive shell (shell-x14.sh).
#
# ACCESS (unlike the iDRAC boxes, X14 is PASSWORD auth — NOT the zipmi factory IPMIKey):
#   SSH     : ssh ADMIN@10.0.8.14  pw ADMIN  -> real Linux /bin/sh (SMASH_ENABLE=0 baked in);
#             sudo -i (pw ADMIN) -> root.   [we use sshpass -p ADMIN, StrictHostKeyChecking=no]
#   IPMI    : ipmitool -I lanplus -H 10.0.8.14 -U ADMIN -P ADMIN <cmd>   (user/channel/etc. work;
#             `mc info` returns 0xff — one-handler quirk — so status probes `channel info 1`).
#   Redfish : curl -sk -u ADMIN:ADMIN https://10.0.8.14/redfish/v1/...   (served by the restore).
#
# Sourced by the `vbmc` dispatcher (~/phd/bin/vbmc). Root-direct model: qemu runs as root and binds
# the box's real IP + standard ports directly. The wrapped scripts live in the X14 scratch workdir.
VBMC_NAME=supermicro-x14
VBMC_DESC="Supermicro X14 BMC (Phosphor OpenBMC/AST2600-ROT, armv7l) — password auth (ADMIN:ADMIN); warm-restore snapshot"

# Scripts + snapshots live in the X14 scratch workdir (restore/snapshot/shell scripts cd there).
VBMC_DIR=/Users/zen/phd/tmp/x14-virtual
SNAP=svc-snap-shell.gz   # canonical warm snapshot: IPMI + Redfish + interactive SSH shell

# Real IP + /etc/hosts name (X14 = 10.0.8.14 in the 10.0.8.x scheme). Ports bound directly by qemu.
VBMC_IP=10.0.8.14
VBMC_HOST=x14bmc
# copy-paste access hint shown by `vbmc status` (factory-default ADMIN:ADMIN everywhere;
# X14 IPMI is password-auth — zipmi does 2.0 RMCP+ by default, no -I/-C needed. mc info
# hits the Get-Device-ID 0xff quirk, so the hint shows `user list`.)
VBMC_HINT='sshpass -p ADMIN ssh ADMIN@x14bmc | zipmi -H x14bmc -U ADMIN -P ADMIN user list | curl -k -u ADMIN:ADMIN https://x14bmc/redfish/'

# IPMI: password auth via ipmitool (see vbmc_ipmi below), NOT zipmi. IPMI_KEY unused but kept for the
# dispatcher's zipmi fallback signature. IPMI_USER/PW drive ipmitool.
IPMI_USER=ADMIN
IPMI_PW=ADMIN
IPMI_KEY=00
IPMI_OPTS=""
IPMI_T=6

# SSH: password auth via sshpass, NOT the iDRAC serial-socat path.
SSH_USER=ADMIN
SSH_PW=ADMIN

# port vars (kept for the dispatcher; qemu binds the standard ports directly on VBMC_IP)
SSH_PORT=22
IPMI_PORT=623
WEB_PORT=443

PIDF=/tmp/vbmc-supermicro-x14.pid
LOG=/tmp/x14-restore-console.log     # restore-svc-x14.sh writes qemu console here
SOCK=/tmp/x14.sock                   # root-owned serial console unix socket

# boot: FAST PATH restores the warm snapshot (~10s, network live). Cold-boot fallback (shell-x14.sh,
# interactive /bin/sh as PID1) when VBMC_COLD=1 or the snapshot is missing. Prints the qemu pid.
vbmc_boot() {
  cd "$VBMC_DIR" || return 1
  local SUDO=; [ "$(id -u)" = 0 ] || SUDO=sudo
  $SUDO ifconfig lo0 alias "$VBMC_IP" up 2>/dev/null
  grep -qE "[[:space:]]${VBMC_HOST}([[:space:]]|\$)" /etc/hosts 2>/dev/null || \
    echo "$VBMC_IP $VBMC_HOST $VBMC_NAME" | $SUDO tee -a /etc/hosts >/dev/null
  if [ -z "${VBMC_COLD:-}" ] && [ -f "$VBMC_DIR/$SNAP" ]; then
    bash "$VBMC_DIR/restore-svc-x14.sh" "$SNAP" >>"$LOG" 2>&1   # backgrounds qemu, network live ~10s
  else
    [ -f "$VBMC_DIR/$SNAP" ] || echo "snapshot $SNAP missing — cold boot (shell)" >&2
    : > "$LOG"
    nohup bash "$VBMC_DIR/shell-x14.sh" >>"$LOG" 2>&1 &   # cold boot to interactive shell (~55s)
  fi
  # wait for the qemu whose hostfwd matches this box's IPMI port to appear, print its pid
  local n=0 qp=; while [ $n -lt 60 ]; do
    qp=$(pgrep -f "hostfwd=udp:$VBMC_IP:623-:623" | head -1); [ -n "$qp" ] && break
    sleep 0.3; n=$((n+1)); done
  echo "$qp"
}

vbmc_build() { echo "x14 boot is snapshot-driven — see SNAPSHOTS.md; kernel.bin/initramfs-patched.bin + the .gz snapshots are prebuilt. Cold shell: VBMC_COLD=1 vbmc x14 start"; }

# snapshot: QMP-checkpoint the running instance to a gz (pauses the VM — restore to resume).
vbmc_snapshot() { bash "$VBMC_DIR/snapshot-x14.sh" "${1:-$SNAP}"; }
# restore: bring a warm snapshot up on the real IP (what `start` does automatically).
vbmc_restore()  { bash "$VBMC_DIR/restore-svc-x14.sh" "${1:-$SNAP}"; }

# ssh: password auth (sshpass). Real Linux shell; `sudo -i` for root. Args = remote command.
vbmc_ssh() {
  sshpass -p "$SSH_PW" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o ConnectTimeout=8 -o LogLevel=ERROR "$SSH_USER@$VBMC_IP" "$@"
}

# ipmi: standard ipmitool lanplus password auth (dispatcher's Z() calls this when defined).
vbmc_ipmi() {
  timeout -s KILL "$(( IPMI_T + 6 ))" \
    ipmitool -I lanplus -H "$VBMC_IP" -U "$IPMI_USER" -P "$IPMI_PW" "$@" 2>&1
}

# ipmi health for `status`: `mc info` returns 0xff on X14 (one-handler quirk), so probe channel info.
# Prints its own status line; returns 0 when the RMCP+ session authenticates.
vbmc_ipmi_health() {
  local r; r=$(vbmc_ipmi channel info 1)
  if echo "$r" | grep -q "Channel Medium Type"; then
    echo "AUTH OK (ipmitool lanplus; ADMIN:ADMIN — mc info=0xff quirk)"; return 0
  else
    echo "no answer (restore warming/down)"; return 1
  fi
}

# web: X14 Redfish is served by the restored instance already — verify it (health check, no bring-up).
vbmc_web() {
  if curl -sk -u "$IPMI_USER:$IPMI_PW" "https://$VBMC_IP/redfish/v1/" 2>/dev/null | grep -q ServiceRoot; then
    echo "x14 Redfish: UP  (curl -sk -u $IPMI_USER:$IPMI_PW https://$VBMC_HOST/redfish/v1/)"
  else
    echo "x14 Redfish: down — restore not up? (vbmc x14 start)"
  fi
}

VBMC_READY_GREP='network live'
