# zbmc.box — virtual-BMC descriptor for "supermicro-x13d" (Supermicro X13DAi C301MS BMC = ATEN AST2600, FW 01.08.08).
#
# WHAT: virtual Supermicro X13DAi (C301MS, ROT2HW2) BMC running the real ATEN userland.
#       eMMC-root ROT2HW2 ATEN layout: root = NOR squashfs @0x840000 (mtdblock0, the
#       injected rofs), /web = eMMC p10 (squashfs dd'd in at build), /cdata = p16,
#       /nv = p17 (guest mkfs.ext4 on first boot).
# WHY:  X13DAi is the dense/twin X13 variant with the ROT2HW2 root-of-trust. Same fleet-
#       shared at-rest AES key + SMCRAKP constant; C301MS disables the null-user
#       IPMI account that 2401MS leaves enabled.
# BOOT: direct-kernel (vendor kernel carved from the NOR FIT @0x330000, dtb patched for
#       FMC + rofs injected @0x840000), root=/dev/mtdblock0, GPT eMMC for /nv. Cold (~2 min).
#
# ACCESS (Supermicro ATEN factory default — password auth):
#   IPMI    : zipmi -H 10.0.8.17 -U ADMIN -P ADMIN <cmd>
#   Web     : curl -sk https://10.0.8.17/page/login.www
#   SSH     : sshpass -p ADMIN ssh ADMIN@10.0.8.17
#   Console : zbmc supermicro-x13d console
ZBMC_NAME=supermicro-x13d
ZBMC_DESC="Supermicro X13DAi C301MS BMC (ATEN AST2600, FW 01.08.08, ROT2HW2) — ATEN stack, eMMC-root; ADMIN:ADMIN; real IPMI+web"

PROJ_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_XREPO="$(cd "$PROJ_DIR/../.." && pwd)"
ZBMC_DIR="${ZBMC_DIR:-$_XREPO/work/supermicro-x13d}"
FLASH="$_XREPO/firmware/smc-x13d-01.08.08.bin"

ZBMC_IP=10.0.8.17
ZBMC_HOST=x13dbmc

IPMI_USER=ADMIN
IPMI_PW=ADMIN
IPMI_KEY=00
IPMI_OPTS=""
IPMI_T=8
SSH_USER=ADMIN
SSH_PW=ADMIN
SSH_PORT=22
IPMI_PORT=623
WEB_PORT=443

PIDF=/tmp/zbmc-supermicro-x13d.pid
LOG="$ZBMC_DIR/console.log"
SOCK="$ZBMC_DIR/console.sock"

zbmc_build() {
  mkdir -p "$ZBMC_DIR"
  [ -f "$FLASH" ] || bash "$_XREPO/firmware/download-fw.sh" supermicro-x13d
  [ -f "$FLASH" ] || { echo "firmware missing: $FLASH" >&2; return 1; }
  # X13D roots from the NOR squashfs @0x840000 (mtdblock0 = injected rofs), eMMC p16/17 for nv.
  python3 "$_XREPO/tools/aten-carve.py" "$FLASH" "$ZBMC_DIR" \
    --fit-off 0x330000 --rofs-off 0x840000 --rofs-len 0x2000000
  python3 "$_XREPO/tools/aten-emmc.py" "$ZBMC_DIR/emmc.img" 256 16:cdata:60 17:nv:60
  echo "built: $ZBMC_DIR (kernel.bin fdt-patched.dtb emmc.img)"
}

zbmc_boot() {
  mkdir -p "$ZBMC_DIR"
  [ -f "$ZBMC_DIR/kernel.bin" ] || zbmc_build || return 1
  local SUDO=; [ "$(id -u)" = 0 ] || SUDO=sudo
  $SUDO ifconfig lo0 alias "$ZBMC_IP" up 2>/dev/null
  grep -qE "[[:space:]]${ZBMC_HOST}([[:space:]]|\$)" /etc/hosts 2>/dev/null || \
    echo "$ZBMC_IP $ZBMC_HOST $ZBMC_NAME" | $SUDO tee -a /etc/hosts >/dev/null
  $SUDO rm -f "$SOCK" 2>/dev/null
  WD="$ZBMC_DIR" FLASH="$FLASH" EMMC="$ZBMC_DIR/emmc.img" ZBMC_IP="$ZBMC_IP" \
    CONSOLE_SOCK="$SOCK" LOG="$LOG" ROOT_MTD=0 \
    nohup bash "$_XREPO/tools/aten-boot.sh" >>"$LOG" 2>&1 &
  local n=0 qp=; while [ $n -lt 60 ]; do
    qp=$(pgrep -f "hostfwd=udp:$ZBMC_IP:623-:623" | head -1); [ -n "$qp" ] && break
    sleep 0.3; n=$((n+1)); done
  echo "$qp"
}

zbmc_ssh() {
  command -v sshpass >/dev/null || { echo "need sshpass"; return 1; }
  sshpass -p "$SSH_PW" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o ConnectTimeout=8 -o LogLevel=ERROR "$SSH_USER@$ZBMC_IP" "$@"
}

zbmc_ipmi() {
  timeout -s KILL "$(( IPMI_T + 6 ))" \
    env PYTHONPATH="$ZIPMI" python3 -m zipmi.cli.zipmi \
    -H "$ZBMC_IP" -p "${IPMI_PORT:-623}" -U "$IPMI_USER" -P "$IPMI_PW" -t "${IPMI_T:-8}" "$@" 2>&1
}

zbmc_ipmi_health() {
  local r; r=$(zbmc_ipmi mc info)
  if echo "$r" | grep -q "IPMI Version"; then
    echo "AUTH OK (zipmi RMCP+; ADMIN:ADMIN)"; return 0
  else
    echo "no answer (first boot formats /nv, ~2 min)"; return 1
  fi
}

zbmc_web() {
  if curl -sk --max-time 8 "https://$ZBMC_IP/page/login.www" 2>/dev/null | grep -qi "login\|Supermicro"; then
    echo "x13d web: UP  (curl -sk https://$ZBMC_HOST/page/login.www)"
  else
    echo "x13d web: down/warming — zbmc $ZBMC_NAME status -f"
  fi
}

zbmc_console() { command -v socat >/dev/null || { echo "need socat"; return 1; }
  echo "console -> $SOCK  (Ctrl-] to detach)"; exec sudo socat -,raw,echo=0,escape=0x1d "UNIX-CONNECT:$SOCK"; }

ZBMC_READY_GREP='login:'
