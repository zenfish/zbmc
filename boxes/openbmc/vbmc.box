# vbmc.box — vanilla upstream OpenBMC (Phosphor / AST2600), the clean baseline box.
#
# WHAT: `vbmc openbmc <verb>` boots the full OpenBMC flash image on qemu ast2600-evb. It's the reference
#       "no OEM" build (Manufacturer ID 0) — useful for diffing vendor OEM behaviour against a clean stack.
# TURNKEY: firmware ships in this repo (firmware/evb-ast2600.static.mtd, 64MB); ssh + Redfish + IPMI-LAN
#          all work. Loopback + high ports so no root/sudo is needed.
#
# ACCESS (creds = Phosphor default root / 0penBmc):
#   ssh     : vbmc openbmc ssh 'uname -a'
#   ipmi    : vbmc openbmc ipmi mc info          (RMCP+ lanplus, cipher 17)
#   redfish : vbmc openbmc web                    (curl https://127.0.0.1:7443/redfish/v1/)
#   console : vbmc openbmc console                (serial log; ssh is the primary shell)
VBMC_NAME=openbmc
VBMC_DESC="Vanilla upstream OpenBMC (Phosphor/AST2600) — clean baseline, NO OEM (Mfr 0); ipmi-LAN + Redfish + ssh all live"

# paths derive from this file's location (sourced -> BASH_SOURCE) so it works from any clone.
PROJ_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VBMC_DIR="${VBMC_DIR:-$(cd "$PROJ_DIR/../.." && pwd)/work/$(basename "$PROJ_DIR")}"

VBMC_IP=127.0.0.1
VBMC_HOST=openbmc
SSH_USER=root
SSH_PW=0penBmc
SSH_PORT=7022
WEB_PORT=7443
IPMI_PORT=7623
IPMI_USER=root
IPMI_PW=0penBmc
IPMI_T=20
VBMC_HINT='vbmc openbmc ssh "uname -a"  |  vbmc openbmc ipmi mc info  |  vbmc openbmc web   (root/0penBmc)'

PIDF=/tmp/vbmc-openbmc.pid
LOG="$VBMC_DIR/svc.log"
SOCK="$VBMC_DIR/cin"

# boot: stage the flash image if missing, then background qemu. ~1-2 min to sshd/Redfish/IPMI.
vbmc_boot() {
  [ -f "$VBMC_DIR/flash.mtd" ] || bash "$PROJ_DIR/build.sh" "$VBMC_DIR" >/dev/null 2>&1
  BG=1 IP="$VBMC_IP" SSH_PORT="$SSH_PORT" HTTPS_PORT="$WEB_PORT" IPMI_PORT="$IPMI_PORT" WD="$VBMC_DIR" \
    bash "$PROJ_DIR/boot.sh" >/dev/null 2>&1
  local n=0 qp=; while [ $n -lt 40 ]; do
    qp=$(pgrep -f "hostfwd=udp:$VBMC_IP:$IPMI_PORT" | head -1); [ -n "$qp" ] && break
    sleep 0.3; n=$((n+1)); done
  [ -n "$qp" ] && echo "$qp" > "$PIDF"; echo "$qp"
}
vbmc_build() { WD="$VBMC_DIR" bash "$PROJ_DIR/build.sh" "$VBMC_DIR"; }

# ssh: Phosphor password auth (root/0penBmc). Uses sshpass if present; else runs ssh (prompts once).
vbmc_ssh() {
  local o=(-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o PubkeyAuthentication=no
           -o ConnectTimeout=25 -p "$SSH_PORT")
  if command -v sshpass >/dev/null; then sshpass -p "$SSH_PW" ssh "${o[@]}" "$SSH_USER@$VBMC_IP" "$@"
  else ssh "${o[@]}" "$SSH_USER@$VBMC_IP" "$@"; fi
}
# ipmi: OpenBMC RMCP+ is cipher-17-only.
vbmc_ipmi() {
  timeout -s KILL "$((IPMI_T+8))" ipmitool -I lanplus -C 17 -H "$VBMC_IP" -p "$IPMI_PORT" \
    -U "$IPMI_USER" -P "$IPMI_PW" "$@" 2>&1
}
vbmc_ipmi_health() {
  if vbmc_ipmi mc info 2>/dev/null | grep -qi 'Manufacturer'; then echo "AUTH OK (RMCP+ cipher17 root/0penBmc)"; return 0
  else echo "no answer (still booting? RMCP+ slow under emulation — IPMI_T=$IPMI_T)"; return 1; fi
}
vbmc_web() {
  if curl -sk --max-time 8 "https://$VBMC_IP:$WEB_PORT/redfish/v1/" 2>/dev/null | grep -q '"@odata'; then
    echo "openbmc Redfish: UP  (curl -sk https://$VBMC_IP:$WEB_PORT/redfish/v1/)"
  else echo "openbmc Redfish: not answering yet (still booting? give it ~2 min)"; fi
}
vbmc_console() { if [ $# -gt 0 ]; then printf '%s\n' "$*" > "$SOCK"; sleep 1; tail -20 "$LOG"; else tail -f "$LOG"; fi; }

VBMC_READY_GREP='login:'
