# zbmc.box — virtual-BMC descriptor for "evb" (VANILLA upstream OpenBMC, Phosphor on ASPEED AST2600).
#
# WHAT: makes `zbmc evb <verb>` drive the clean no-vendor-OEM OpenBMC baseline — the reference point
#       against which the OEM boxes (gb200 NVIDIA, romulus multi-OEM, x14 Supermicro) are compared.
# WHY:  the zoo had every vendor flavor but no plain upstream OpenBMC. This is it: obmc-phosphor-image
#       @ github.com/openbmc/openbmc 5d179dab (3.1.0-dev-294), MACHINE=evb-ast2600. Manufacturer ID 0
#       ("Unknown") over IPMI = the vanilla signature (no OEM handler grafted on).
# BOOT: cold-boots the full flash image (.static.mtd = u-boot+kernel+rootfs) on qemu -M ast2600-evb,
#       snapshot=on so the built image stays pristine. Reachable at the real IP the moment services come
#       up (~60-90s). NB: unlike gb200, this image SHIPS net-ipmid → real IPMI-over-LAN on :623.
#
# ACCESS (Phosphor factory defaults — local research lab):
#   SSH     : sshpass -p 0penBmc ssh root@evb            -> real Linux (busybox) shell
#   IPMI    : zipmi -H evb -U root -P 0penBmc <cmd>   (mc info -> Mfr 0 = vanilla)
#   Redfish : curl -sk -u root:0penBmc https://evb/redfish/v1/
#
# Sourced by the `zbmc` dispatcher (~/phd/bin/zbmc). qemu runs as root and binds the box's real IP
# (10.0.7.10, OpenBMC class 10.0.7.*) + standard ports 22/443/623 directly. See BUILD-INFO.md +
# memory reference_evb_ast2600_vanilla_openbmc.
ZBMC_NAME=openbmc
ZBMC_DESC="Vanilla upstream OpenBMC (Phosphor/AST2600) — clean baseline, NO OEM (Mfr 0); ipmi-LAN + Redfish + ssh all live"
# Portable (clone-and-run): the .static.mtd firmware ships via firmware/download-fw.sh
# and boots with snapshot=on (writes to a throwaway overlay), so no work-dir copy needed.
PROJ_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_XREPO="$(cd "$PROJ_DIR/../.." && pwd)"
ZBMC_DIR="$_XREPO/firmware"

ZBMC_IP=$(_zbmc_resolve_ip openbmc 10 10.0.7.10)
ZBMC_HOST=openbmc

# ssh/redfish/ipmi creds (Phosphor default on a vanilla build)
SSH_USER=root
SSH_PASS=0penBmc
IPMI_USER=root
IPMI_PW=0penBmc
SSH_PORT=22
WEB_PORT=443
IPMI_PORT=623

PIDF=/tmp/zbmc-openbmc.pid
LOG=/tmp/zbmc-openbmc-console.log
SOCK=/tmp/zbmc-openbmc-serial.sock

zbmc_boot() {
  cd "$ZBMC_DIR" || return 1
  local MTD=evb-ast2600.static.mtd
  [ -e "$MTD" ] || { echo "missing $MTD — build not present" >&2; return 1; }
  local SUDO=; [ "$(id -u)" = 0 ] || SUDO=sudo
  $SUDO ifconfig lo0 alias "$ZBMC_IP" up 2>/dev/null
  grep -qE "[[:space:]]${ZBMC_HOST}([[:space:]]|\$)" /etc/hosts 2>/dev/null || \
    echo "$ZBMC_IP $ZBMC_HOST $ZBMC_NAME" | $SUDO tee -a /etc/hosts >/dev/null
  : > "$LOG"; $SUDO rm -f "$SOCK" 2>/dev/null
  # snapshot=on -> writes go to a throwaway overlay, the built image stays pristine.
  # -serial unix:$SOCK is serial0 = the AST2600 console (ttyS4 getty). Do NOT prepend -serial null.
  $SUDO nohup qemu-system-arm -M ast2600-evb -smp 2 -m 1G -display none \
    -drive file="$MTD",format=raw,if=mtd,snapshot=on \
    -net nic -net user,"hostfwd=tcp:$ZBMC_IP:22-:22,hostfwd=tcp:$ZBMC_IP:443-:443,hostfwd=udp:$ZBMC_IP:623-:623",hostname=qemu \
    -serial "unix:$SOCK,server,nowait" -serial null >"$LOG" 2>&1 &
  local n=0 qp=; while [ $n -lt 40 ]; do qp=$(pgrep -f "hostfwd=tcp:$ZBMC_IP:22-:22" | head -1); [ -n "$qp" ] && break; sleep 0.3; n=$((n+1)); done
  echo "$qp"
}
zbmc_build() { echo "evb image is bitbake-built (MACHINE=evb-ast2600, obmc-phosphor-image) on dell. See BUILD-INFO.md; rebuild = ~6h. Local image: $ZBMC_DIR/evb-ast2600.static.mtd"; }
zbmc_ready() {
  [ -f "$ZBMC_DIR/evb-ast2600.static.mtd" ] && { echo "ready (firmware present)"; return 0; }
  echo "no firmware — run: firmware/download-fw.sh openbmc"; return 1
}

# ssh: password auth (Phosphor root/0penBmc). Real Linux (busybox) shell.
zbmc_ssh() {
  command -v sshpass >/dev/null || { echo "need sshpass"; return 1; }
  exec sshpass -p "$SSH_PASS" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o ConnectTimeout=10 -p "$SSH_PORT" "$SSH_USER@$ZBMC_IP" "$@"
}
# ipmi: REAL IPMI-over-LAN (this image ships net-ipmid). zipmi RMCP+ password auth. Args = ipmi cmd.
zbmc_ipmi() {
  timeout -s KILL 16 \
    env PYTHONPATH="$ZIPMI" python3 -m zipmi.cli.zipmi \
    -H "$ZBMC_IP" -p "${IPMI_PORT:-623}" -U "$IPMI_USER" -P "$IPMI_PW" -t "${IPMI_T:-3}" "$@" 2>&1
}
# ipmi health for `status`: vanilla mc info returns real data (unlike x14's 0xff quirk).
zbmc_ipmi_health() {
  local r; r=$(zbmc_ipmi mc info 2>&1)
  if echo "$r" | grep -q "IPMI Version"; then
    echo "AUTH OK (zipmi RMCP+ root:0penBmc; Mfr $(echo "$r" | awk -F': *' '/Manufacturer ID/{print $2}') = vanilla)"; return 0
  else
    echo "no answer (booting/down)"; return 1
  fi
}
zbmc_web() { echo "Redfish: curl -sk -u root:0penBmc https://$ZBMC_IP/redfish/v1/"; command -v curl >/dev/null && curl -sk --max-time 8 -u root:0penBmc "https://$ZBMC_IP/redfish/v1/" 2>/dev/null | head -c 200; echo; }
# interactive console on the qemu serial socket (AST2600 ttyS4; escape = Ctrl-]). Root console shell.
zbmc_console() { command -v socat >/dev/null || { echo "need socat"; return 1; }
  echo "console -> $SOCK  (Ctrl-] to detach)"; exec sudo socat -,raw,echo=0,escape=0x1d "UNIX-CONNECT:$SOCK"; }
ZBMC_READY_GREP='login:'
