# Lenovo XClarity Controller preserved Newyork-pass1 runtime.
#
# Remote IPMI requires native account/service provisioning and channel-1 access.
# Store the changed password in private zbmc.conf as ZBMC_LENOVO_PASSWORD.
ZBMC_NAME=lenovo-xcc
ZBMC_NETWORK_MODE=tap
ZBMC_DESC="Lenovo XClarity Controller / AST2600 - vendor Web-UI"

PROJ_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$PROJ_DIR/../.." && pwd)"
ZBMC_DIR="${ZBMC_DIR:-${ZBMC_LENOVO_DIR:-$ROOT/work/lenovo-xcc}}"
ZBMC_IP=$(_zbmc_resolve_ip lenovo-xcc 43 10.0.6.69)
ZBMC_HOST=lenovo-xcc

ZBMC_QEMU=/home/zen/opt/zbmc-qemu/qemu-11.0.0-98b060da-arm-lenovo-xcc-dynamic-b7ea69ec0cdf/bin/qemu-system-arm
ZBMC_QEMU_SHA256=0239888e57aeb1f73508f90eddd042f295988a275145a9717b0878cda041da69
ZBMC_QEMU_MAJOR=11
ZBMC_QEMU_VERSION=11.0.0
ZBMC_QEMU_MACHINE=ast2600-evb
ZBMC_WARM_STATUS=verified
ZBMC_WARM_REASON="requires a matched TAP checkpoint; pre-TAP checkpoints are unsupported"
ZBMC_WARM_FILES="ckpt/state.gz ckpt/emmc.qcow2 ckpt/manifest.json ckpt/source-argv.json"
ZBMC_REQUIRED_SERVICES="ssh ipmi redfish webui console"
ZBMC_SERIAL_SERVICE_PROBES=1
ZBMC_STABILITY_SECONDS=60
ZBMC_READY_DEADLINE=3600
ZBMC_PROBE_AFTER_BOOTSTRAP=1
ZBMC_EXPECTED_FIRMWARE=5
ZBMC_EXPECTED_BOOTSTRAP=510
ZBMC_EXPECTED_READY=2700

SSH_USER=USERID
SSH_PW="${ZBMC_LENOVO_PASSWORD:-PASSW0RD}"
SSH_PORT=22
IPMI_USER=USERID
IPMI_PW="$SSH_PW"
[ -z "${ZBMC_LENOVO_PASSWORD:-}" ] || ZBMC_AUTH_HINT="USERID / password from private zbmc.conf"
IPMI_KEY=00
IPMI_PORT=623
IPMI_T=30
IPMI_OPTS="-C 17 -I lanplus"
WEB_PORT=443
HTTP_PORT=80
ZBMC_HTTP_PROBE_TIMEOUT=15
ZBMC_SSH_PROBE_TIMEOUT=40
ZBMC_TAP=ztap-xcc
ZBMC_MAC=52:54:00:12:34:60
ZBMC_CAPTURE_INTERFACES="br-zbmc $ZBMC_TAP"
ZBMC_GUEST_PREFIX="${ZBMC_GUEST_PREFIX:-8}"
ZBMC_GUEST_GATEWAY="${ZBMC_GUEST_GATEWAY:-10.0.0.1}"

PIDF="$ZBMC_DIR/zbmc.pid"
LOG="$ZBMC_DIR/launcher.log"
SOCK="$ZBMC_DIR/serial.sock"
QMP_SOCK="$ZBMC_DIR/qmp.sock"
CONSOLE_LOG="${ZBMC_CONSOLE_LOG:-$ZBMC_DIR/console.log}"
ZBMC_MEMDUMP_REGIONS="sram:0x10000000:0x16400"
ZBMC_MEMDUMP_GDB_SCRIPT="$PROJ_DIR/memdump.gdb"
export ZBMC_MEMDUMP_REGIONS ZBMC_MEMDUMP_GDB_SCRIPT

zbmc_boot() {
  mkdir -p "$ZBMC_DIR"
  local qp=
  qp=$(ZBMC_WARM="${ZBMC_WARM:-}" ZBMC_CONSOLE_LOG="$CONSOLE_LOG" WD="$ZBMC_DIR" ZBMC_QEMU="$ZBMC_QEMU" \
    IP="$ZBMC_IP" SSH_PORT="$SSH_PORT" HTTP_PORT="$HTTP_PORT" \
    GUEST_PREFIX="$ZBMC_GUEST_PREFIX" GUEST_GATEWAY="$ZBMC_GUEST_GATEWAY" \
    HTTPS_PORT="$WEB_PORT" IPMI_PORT="$IPMI_PORT" SOCK="$SOCK" TAP="$ZBMC_TAP" \
    QMP="$QMP_SOCK" LOG="$LOG" bash "$PROJ_DIR/boot.sh") || return 1
  printf '%s\n' "$qp" >"$ZBMC_DIR/boot.pid"
  [ -n "$qp" ] && printf '%s\n' "$qp" >"$PIDF"
  printf '%s\n' "$qp"
}

zbmc_post_launch() {
  nohup python3 "$ROOT/tools/zbmc-configure-serial-ip.py" "$SOCK" "$ZBMC_IP" \
    "$ZBMC_GUEST_PREFIX" "$ZBMC_GUEST_GATEWAY" eth1 >"$ZBMC_DIR/tap-config.log" 2>&1 &
}

zbmc_build() { bash "$PROJ_DIR/build.sh" "$ZBMC_DIR"; }
zbmc_ready() {
  local file
  for file in kernel.zImage kernel-shell.zImage xcc.dtb sram.bin ptables.bin emmc.qcow2 build-provenance.txt; do
    [ -f "$ZBMC_DIR/$file" ] || { echo "not built - run: zbmc lenovo-xcc build"; return 1; }
  done
  echo "cold artifacts installed; LAN IPMI gateway is stubbed in cold image"
}

zbmc_web() {
  curl -sk --max-time 15 -o /dev/null -w 'Lenovo XCC Web-UI: HTTP %{http_code}\n' \
    "https://$ZBMC_IP:$WEB_PORT/"
}

# Validate the native Web session, independently of historical console markers.
zbmc_webui_health() {
  XCC_URL="https://$ZBMC_IP:$WEB_PORT" XCC_USER="$SSH_USER" XCC_PASSWORD="$SSH_PW" \
    python3 "$PROJ_DIR/web-health.py"
}

zbmc_ssh() {
  SSHPASS="$SSH_PW" sshpass -e ssh -o StrictHostKeyChecking=accept-new \
    -o UserKnownHostsFile="$ZBMC_DIR/ssh_known_hosts" -o ConnectTimeout=10 \
    -p "$SSH_PORT" "$SSH_USER@$ZBMC_IP" "$@"
}

zbmc_ssh_health() {
  local result
  export SSH_PW SSH_PORT SSH_USER ZBMC_IP ZBMC_DIR
  export -f zbmc_ssh
  result=$(timeout -s KILL "${ZBMC_SSH_PROBE_TIMEOUT:-40}" bash -c 'zbmc_ssh help' 2>&1) &&
    grep -Eq 'help[[:space:]]+--[[:space:]]+Display command list' <<<"$result" && {
      echo 'AUTH OK (native Lenovo CLI help)'; return 0;
    }
  echo 'authenticated Lenovo CLI command failed'
  return 1
}

zbmc_console() {
  command -v socat >/dev/null || { echo "need socat" >&2; return 1; }
  echo "Lenovo XCC console -> $SOCK (Ctrl-] to detach)"
  exec socat -,raw,echo=0,escape=0x1d "UNIX-CONNECT:$SOCK"
}

ZBMC_READY_GREP='XCC_RUNTIME_VPDOCTOR_BYPASS_BOUND\|XCC_WARM_RESTORE_RUNNING'

# Use the same authenticated command for interactive calls and readiness.
zbmc_ipmi() {
  timeout -s KILL 90 env IPMI_PASSWORD="$IPMI_PW" \
    ipmitool -I lanplus -H "$ZBMC_IP" -p "$IPMI_PORT" -U "$IPMI_USER" \
    -E -C 17 -N "$IPMI_T" -R 1 "$@"
}

zbmc_ipmi_health() {
  local result
  result=$(zbmc_ipmi mc info 2>&1) &&
    grep -q 'Manufacturer ID' <<<"$result" && {
      echo 'AUTH OK (IPMI 2.0, cipher 17)'; return 0;
    }
  echo 'authenticated controller read failed (booting or provisioning required)'
  return 1
}

zbmc_redfish_health() {
  local result
  result=$(curl -sk --connect-timeout 3 --max-time 30 -u "$IPMI_USER:$IPMI_PW" \
    "https://$ZBMC_IP:$WEB_PORT/redfish/v1/AccountService/Accounts/1" 2>/dev/null) &&
    python3 -c 'import json,sys; d=json.load(sys.stdin); assert d.get("UserName") == sys.argv[1]' \
      "$IPMI_USER" <<<"$result" 2>/dev/null && {
        echo 'AUTH OK (protected Redfish account read)'
        return 0
      }
  echo 'authenticated Redfish account read failed'
  return 1
}
