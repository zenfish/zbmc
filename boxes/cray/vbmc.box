# vbmc.box — virtual-BMC descriptor for "cray" (HPE Cray XD670 BMC = AMI MegaRAC SP-X / AST2600).
#
# WHAT: makes `vbmc cray <verb>` drive the virtual HPE Cray XD670 BMC. qemu is ast2600-evb (armv7l);
#       Linux 5.4.184-ami MegaRAC SP-X. Rootfs (squashfs) boots as a RAM disk; /conf & /bkupconf mount
#       from a 64 MB NOR image (mtdflash.bin) with NAMED mtd partitions. Console on ttyS4.
# WHY:  the Cray XD670 does NOT run iLO — it runs AMI MegaRAC (same stack Eclypsium BMC&C Part 3 hit,
#       CVE-2024-54085 in the Redfish host-interface lua). First MegaRAC-on-Gigabyte box in the zoo.
# BOOT: boot-cray-svc.sh (real /sbin/init + qemu user-net). Artifacts regenerate from the HPM via
#       extract.sh. There is no warm snapshot yet (cold boot ~2 min).
#
# STATUS (2026-07-28): GREEN — IPMI 2.0 RMCP+ + authenticated Redfish both work. extract.sh ->
#   qemu-patch-rootfs.sh applies the Ghidra-RE'd fixes that let IPMIMain run stably under qemu:
#     (1) seed /conf + create /conf/BMC -> BMC1/ast2600evb_ami symlink (IPMIMain opens the literal
#         /conf/BMC/IPMI.conf to build g_BMCInfo[]); (2) IPMI.conf consistent with qemu hardware —
#         keep LAN/UDS/KCS, disable serial/sol/bt/smm/smbus/ipmb (absent hw crash the central MsgHndlr),
#         set NM_IPMB_BUS=0xFF (Node-Manager validation self-stop otherwise). IPMIMain then completes
#         init, binds /var/UDSocket1, and auto-provisions the default admin/superuser (Admin, chan 1).
#   Verified: ipmitool -I lanplus -U admin -P superuser mc info -> Gigabyte MfgID 15370, IPMI 2.0;
#     user2=admin=ADMINISTRATOR; curl -u admin:superuser https://IP/redfish/v1/Managers -> real JSON.
#
# ACCESS:
#   IPMI    : ipmitool -I lanplus -H 10.0.8.67 -U admin -P superuser mc info   (vbmc cray ipmi …)
#   Redfish : curl -sk -u admin:superuser https://10.0.8.67/redfish/v1/Managers   (vbmc cray web)
#   Console : vbmc cray console   (serial ttyS4; getty login = sysadmin / superuser — Linux acct)
#   Raw sh  : WD=... boot-cray.sh  (init=/bin/sh, unrestricted root — for RE)
VBMC_NAME=megarac-hpe
VBMC_DESC="HPE Cray XD670 BMC (AMI MegaRAC SP-X / AST2600, armv7l) — IPMI 2.0 RMCP+ + authed Redfish WORK (admin/superuser)"

VBMC_DIR=/Users/zen/phd/tmp/cray-xd670         # scratch workdir: artifacts + console log + fifo
PROJ_DIR=/Volumes/yyy/phd/bmc/HP/cray/xd670-virtual   # scripts + docs (git-tracked)

# IP scheme: 10.0.8.x like the other OpenBMC/MegaRAC boxes; 67 = XD6[7]0. Ports bound on this IP once green.
# Loopback + distinct high ports (romulus pattern). Real-IP (lo0 alias) hostfwd works for Redfish (TCP)
# but qemu SLIRP mangles RMCP+'s multi-packet UDP exchange on an alias — IPMI-623 only stays reliable on
# 127.0.0.1. So the box lives on loopback: IPMI :5623, Redfish :5443, ssh :5022 (no root, no collision).
VBMC_IP=127.0.0.1
VBMC_HOST=craybmc
VBMC_HINT='zipmi -H 127.0.0.1 -p 5623 -U admin -P superuser mc info | curl -k -u admin:superuser https://127.0.0.1:5443/redfish/v1/Managers'

# IPMI/Redfish auth = the MegaRAC default IPMI user 'admin'/'superuser' (auto-provisioned by IPMIMain
# into /conf/BMC1/UserConfig.ini once it runs; verified: RMCP+ mc info + user2=ADMINISTRATOR). NOTE the
# Linux/console login is a DIFFERENT account: sysadmin/superuser (see SSH_USER below).
IPMI_USER=admin
IPMI_PW=superuser
IPMI_KEY=00
IPMI_OPTS=""
IPMI_T=20        # RMCP+ RAKP under armv7 emulation is slow; short timeouts look dead
SSH_USER=sysadmin
SSH_PW=superuser
SSH_PORT=5022
IPMI_PORT=5623
WEB_PORT=5443

PIDF=/tmp/vbmc-megarac-hpe.pid
LOG=/Users/zen/phd/tmp/cray-xd670/svc.log
SOCK=/Users/zen/phd/tmp/cray-xd670/cin        # fifo: echo 'cmd' > "$SOCK" drives the console

# boot: background the service boot (real init + net) bound to the box's real IP on standard ports
# (qemu needs root for 443/623 -> sudo + lo0 alias, same root-direct model as the x14 box). Console
# -> $LOG, driven via the $SOCK fifo. ~2 min cold boot to Redfish-ready.
# boot: FAST PATH restores the warm snapshot (~4s to green — sidesteps the IPMIMain cold-boot race).
# Falls back to the health-gated cold retry (start-cray-green.sh) if no snapshot exists or VBMC_COLD=1.
vbmc_boot() {
  local SUDO=; [ "$(id -u)" = 0 ] || SUDO=sudo
  $SUDO ifconfig lo0 alias "$VBMC_IP" up 2>/dev/null
  grep -qE "[[:space:]]${VBMC_HOST}([[:space:]]|\$)" /etc/hosts 2>/dev/null || \
    echo "$VBMC_IP $VBMC_HOST $VBMC_NAME" | $SUDO tee -a /etc/hosts >/dev/null
  local PENV="IP=$VBMC_IP HTTPS_PORT=$WEB_PORT IPMI_PORT=$IPMI_PORT SSH_PORT=$SSH_PORT WD=$VBMC_DIR"
  if [ -z "${VBMC_COLD:-}" ] && [ -f "$VBMC_DIR/cray-snap.gz" ] && [ -f "$VBMC_DIR/cray-snap-flash.bin" ]; then
    env $PENV bash "$PROJ_DIR/restore-cray.sh" >/dev/null 2>&1   # ~4s to green
  else
    [ -f "$VBMC_DIR/cray-snap.gz" ] || echo "no snapshot — cold retry (flaky; ~minutes)" >&2
    env $PENV TRIES="${TRIES:-6}" bash "$PROJ_DIR/start-cray-green.sh" >>"$LOG" 2>&1
  fi
  local n=0 qp=; while [ $n -lt 40 ]; do
    qp=$(pgrep -f "hostfwd=udp:$VBMC_IP:$IPMI_PORT-:623" | head -1); [ -n "$qp" ] && break
    qp=$(pgrep -f 'qemu-system-arm -M ast2600-evb' | head -1); [ -n "$qp" ] && break
    sleep 0.3; n=$((n+1)); done
  [ -n "$qp" ] && echo "$qp" > "$PIDF"; echo "$qp"
}
# snapshot/restore verbs (build a warm base from a green boot, then always restore it)
vbmc_snapshot() { WD="$VBMC_DIR" bash "$PROJ_DIR/snapshot-cray.sh" "$@"; }
vbmc_restore()  { env IP="$VBMC_IP" HTTPS_PORT="$WEB_PORT" IPMI_PORT="$IPMI_PORT" SSH_PORT="$SSH_PORT" WD="$VBMC_DIR" bash "$PROJ_DIR/restore-cray.sh" "$@"; }

vbmc_build() { WD="$VBMC_DIR" bash "$PROJ_DIR/extract.sh"; }

# console: tail the serial log; pass a string arg to send it to the getty/shell over the fifo.
vbmc_console() {
  if [ $# -gt 0 ]; then printf '%s\n' "$*" > "$SOCK"; sleep 1; tail -20 "$LOG"; else tail -f "$LOG"; fi
}

# web: external Redfish ServiceRoot is UP (public). Health-check it.
vbmc_web() {
  if curl -sk --max-time 8 -u "$IPMI_USER:$IPMI_PW" "https://$VBMC_IP:$WEB_PORT/redfish/v1/Managers" 2>/dev/null | grep -q ManagerCollection; then
    echo "cray Redfish: UP  (curl -sk -u admin:superuser https://$VBMC_IP:$WEB_PORT/redfish/v1/Managers)"
  else
    echo "cray Redfish: down — restore not up? (vbmc cray start)"
  fi
}
# ipmi: RMCP+ lanplus with the MegaRAC default admin/superuser (WORKS — Gigabyte MfgID 15370).
vbmc_ipmi() {
  timeout -s KILL "$(( IPMI_T + 8 ))" \
    ipmitool -I lanplus -H "$VBMC_IP" -p "$IPMI_PORT" -U "$IPMI_USER" -P "$IPMI_PW" "$@" 2>&1
}
vbmc_ipmi_health() {
  if vbmc_ipmi mc info | grep -q 'GIGA-BYTE\|Manufacturer'; then
    echo "AUTH OK (RMCP+ lanplus admin/superuser; Gigabyte MfgID 15370)"; return 0
  else echo "no answer (still booting? RMCP+ is slow under emulation — IPMI_T=$IPMI_T)"; return 1; fi
}
# ssh: sshd binds loopback under emulation; use the console for a shell (sysadmin/superuser).
vbmc_ssh()         { echo "cray ssh: use the console — vbmc cray console (getty sysadmin/superuser)"; return 1; }

VBMC_READY_GREP='Redfish Server ready'
