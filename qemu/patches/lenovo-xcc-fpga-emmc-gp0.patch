From 0331933660e03d0ed369113e0777b0f4ecda1a77 Mon Sep 17 00:00:00 2001
From: zenfish <zen@trouble.org>
Date: Tue, 1 Sep 2026 14:36:10 -0700
Subject: [PATCH 1/2] hw: model Lenovo XCC FPGA and eMMC GP0

---
 hw/arm/aspeed.c         | 408 +++++++++++++++++++++++++++++++++++++++-
 hw/sd/sd.c              |  34 +++-
 hw/sd/sdmmc-internal.h  |   1 +
 include/hw/arm/aspeed.h |  11 ++
 4 files changed, 449 insertions(+), 5 deletions(-)

diff --git a/hw/arm/aspeed.c b/hw/arm/aspeed.c
index a3db340..2f77f3a 100644
--- a/hw/arm/aspeed.c
+++ b/hw/arm/aspeed.c
@@ -13,13 +13,379 @@
 #include "qapi/error.h"
 #include "hw/arm/boot.h"
 #include "hw/arm/aspeed.h"
+#include "exec/cpu-common.h"
+#include "qemu/error-report.h"
+#include "qemu/timer.h"
+
+#define XCC_FPGA_CMD_BASE  0x50000000
+#define XCC_FPGA_DATA_BASE 0x50800000
+#define XCC_FPGA_CTRL_BASE 0x51000000
+#define XCC_FPGA_CMD_SIZE   0x8000
+#define XCC_FPGA_DATA_SIZE  0x4000
+#define XCC_FPGA_CTRL_SIZE  0x1000
+#define XCC_FPGA_RING       0x400
+#define XCC_FPGA_DOORBELL   0xf06
+#define XCC_FPGA_PENDING    0xf05
+#define XCC_FPGA_REQUEST_MAX (6 + 1024 + 1)
+#define XCC_PTABLES_BASE     0x80000000
+#define XCC_PTABLES_SIZE     0x8000
+
+static const hwaddr xcc_fpga_bases[] = {
+    XCC_FPGA_CMD_BASE, XCC_FPGA_DATA_BASE, XCC_FPGA_CTRL_BASE,
+};
+
+static const uint64_t xcc_fpga_sizes[] = {
+    XCC_FPGA_CMD_SIZE, XCC_FPGA_DATA_SIZE, XCC_FPGA_CTRL_SIZE,
+};
+
+static unsigned int xcc_fpga_read_count;
+static uint8_t xcc_fpga_fifo[4096];
+static unsigned int xcc_fpga_fifo_pos;
+static unsigned int xcc_fpga_transaction;
+static uint32_t xcc_fpga_command;
+static uint8_t xcc_fpga_request[XCC_FPGA_REQUEST_MAX];
+static unsigned int xcc_fpga_request_length;
+static unsigned int xcc_fpga_response_length;
+static bool xcc_fpga_collecting_write;
+static bool xcc_fpga_i2c_operation_complete;
+static bool xcc_fpga_i2c_status_logged;
+static QEMUTimer *xcc_ptables_timer;
+static uint8_t xcc_ptables_data[XCC_PTABLES_SIZE];
+static bool xcc_ptables_valid;
+static unsigned int xcc_ptables_polls;
+
+static uint8_t xcc_fpga_crc8_byte(uint8_t crc, uint8_t value)
+{
+    crc ^= value;
+    for (unsigned int bit = 0; bit < 8; bit++) {
+        crc = (crc & 1) ? (crc >> 1) ^ 0xe0 : crc >> 1;
+    }
+    return crc;
+}
+
+static uint8_t xcc_fpga_response_crc(const uint8_t *request,
+                                     unsigned int request_length,
+                                     const uint8_t *response,
+                                     unsigned int payload_length)
+{
+    uint8_t crc = 0xff;
+
+    for (unsigned int i = 0; i < request_length; i++) {
+        crc = xcc_fpga_crc8_byte(crc, request[i]);
+    }
+    for (unsigned int i = 1; i <= payload_length + 1; i++) {
+        crc = xcc_fpga_crc8_byte(crc, response[i]);
+    }
+    return crc;
+}
+
+static uint8_t xcc_fpga_request_crc(void)
+{
+    uint8_t crc = 0xff;
+
+    for (unsigned int i = 0; i < xcc_fpga_request_length; i++) {
+        crc = xcc_fpga_crc8_byte(crc, xcc_fpga_request[i]);
+    }
+    return crc;
+}
+
+static unsigned int xcc_fpga_expected_write_length(void)
+{
+    if (!(xcc_fpga_request[0] & 0x40)) {
+        /* Four-byte header, byte 3 payload length, request CRC. */
+        return 4 + xcc_fpga_request[3] + 1;
+    }
+    if (xcc_fpga_request_length >= 6) {
+        /* Extended writes encode payload length in 16-byte units. */
+        return 6 + xcc_fpga_request[5] * 16 + 1;
+    }
+    return 0;
+}
+
+static void xcc_fpga_refresh_response_integrity(void)
+{
+    unsigned int integrity_index = xcc_fpga_response_length + 2;
+
+    g_assert(integrity_index < sizeof(xcc_fpga_fifo));
+    xcc_fpga_fifo[integrity_index] =
+        xcc_fpga_response_crc(xcc_fpga_request, xcc_fpga_request_length,
+                              xcc_fpga_fifo, xcc_fpga_response_length);
+}
+
+static void xcc_ptables_install(void *opaque)
+{
+    CPUState *cpu = first_cpu;
+    vaddr pc;
+
+    if (!xcc_ptables_valid) {
+        return;
+    }
+    pc = CPU_GET_CLASS(cpu)->get_pc(cpu);
+    if (pc < 0x80008000 || pc >= 0xc0000000) {
+        if (++xcc_ptables_polls < 10000) {
+            timer_mod(xcc_ptables_timer,
+                      qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 100 * SCALE_US);
+        } else {
+            error_report("xcc-fpga: PTABLES handoff timed out");
+        }
+        return;
+    }
+    cpu_physical_memory_write(XCC_PTABLES_BASE, xcc_ptables_data,
+                              sizeof(xcc_ptables_data));
+    fprintf(stderr,
+            "xcc-fpga: installed PTABLES at 0x80000000 after pc=0x%" PRIx64
+            "\n", (uint64_t)pc);
+}
+
+static uint64_t xcc_fpga_read(void *opaque, hwaddr offset, unsigned size)
+{
+    AspeedXccFpgaWindow *window = opaque;
+    uint8_t *buf = window->machine->xcc_fpga_buf[window->index];
+    uint64_t value = 0;
+
+    if (window->index == 0 && offset == 0 &&
+        xcc_fpga_fifo_pos + size <= sizeof(xcc_fpga_fifo)) {
+        memcpy(&value, xcc_fpga_fifo + xcc_fpga_fifo_pos, size);
+        xcc_fpga_fifo_pos += size;
+    } else {
+        memcpy(&value, buf + offset, size);
+    }
+    if (xcc_fpga_read_count < 500) {
+        fprintf(stderr,
+                "xcc-fpga: read[%u] window=%u offset=0x%04" HWADDR_PRIx
+                " size=%u value=0x%016" PRIx64 "\n",
+                xcc_fpga_read_count, window->index, offset, size, value);
+    }
+    xcc_fpga_read_count++;
+    return value;
+}
+
+static void xcc_fpga_complete(AspeedMachineState *bmc)
+{
+    uint8_t *cmd = bmc->xcc_fpga_buf[0];
+    uint8_t *ctrl = bmc->xcc_fpga_buf[2];
+    unsigned int slot = cmd[0] & 0x7f;
+    uint8_t *desc = cmd + XCC_FPGA_RING + slot * 0x10;
+
+    fprintf(stderr,
+            "xcc-fpga: slot=%u desc="
+            "%02x %02x %02x %02x %02x %02x %02x %02x "
+            "%02x %02x %02x %02x %02x %02x %02x %02x\n",
+            slot, desc[0], desc[1], desc[2], desc[3],
+            desc[4], desc[5], desc[6], desc[7], desc[8],
+            desc[9], desc[10], desc[11], desc[12], desc[13],
+            desc[14], desc[15]);
+
+    desc[0] = 2;
+    cmd[1] = slot;
+    ctrl[XCC_FPGA_PENDING] = 1;
+}
+
+static void xcc_fpga_write(void *opaque, hwaddr offset, uint64_t value,
+                           unsigned size)
+{
+    AspeedXccFpgaWindow *window = opaque;
+    AspeedMachineState *bmc = window->machine;
+    uint8_t *buf = bmc->xcc_fpga_buf[window->index];
+
+    memcpy(buf + offset, &value, size);
+    if (bmc->xcc_fpga_write_count < 500) {
+        fprintf(stderr,
+                "xcc-fpga: write[%u] window=%u offset=0x%04" HWADDR_PRIx
+                " size=%u value=0x%016" PRIx64 "\n",
+                bmc->xcc_fpga_write_count, window->index, offset, size,
+                value);
+    }
+    bmc->xcc_fpga_write_count++;
+    if (window->index == 0 && offset == 0 && size == 4 &&
+        !xcc_fpga_collecting_write &&
+        (xcc_fpga_transaction == 0 || xcc_fpga_fifo_pos != 0)) {
+        unsigned int payload_length = value >> 24;
+        unsigned int integrity_index = payload_length + 2;
+        uint8_t integrity;
+
+        if (xcc_fpga_transaction != 0) {
+            fprintf(stderr,
+                    "xcc-fpga: transaction=%u command=0x%08x bytes-read=%u\n",
+                    xcc_fpga_transaction - 1, xcc_fpga_command,
+                    xcc_fpga_fifo_pos);
+        }
+        xcc_fpga_command = value;
+        xcc_fpga_request_length = sizeof(xcc_fpga_command);
+        for (unsigned int i = 0; i < xcc_fpga_request_length; i++) {
+            xcc_fpga_request[i] = value >> (i * 8);
+        }
+        memset(xcc_fpga_fifo, 0, sizeof(xcc_fpga_fifo));
+        if (value == 0x10000000) {
+            memset(xcc_fpga_fifo + 2, 0xff, 16);
+        }
+        if (value == 0x01410200 && xcc_fpga_i2c_operation_complete) {
+            xcc_fpga_fifo[1] = 0x01;
+        }
+        xcc_fpga_response_length = payload_length;
+        xcc_fpga_fifo_pos = 0;
+        xcc_fpga_collecting_write = xcc_fpga_request[0] & 0x80;
+        if (xcc_fpga_collecting_write) {
+            xcc_fpga_response_length = 0;
+            fprintf(stderr,
+                    "xcc-fpga: transaction=%u write-request-length=%u"
+                    " pending\n",
+                    xcc_fpga_transaction, xcc_fpga_request_length);
+        } else {
+            g_assert(integrity_index < sizeof(xcc_fpga_fifo));
+            xcc_fpga_refresh_response_integrity();
+            if (value == 0x01410200 && xcc_fpga_i2c_operation_complete &&
+                !xcc_fpga_i2c_status_logged) {
+                fprintf(stderr,
+                        "xcc-fpga: first post-completion 0x01410200 fifo="
+                        "%02x %02x %02x %02x\n",
+                        xcc_fpga_fifo[0], xcc_fpga_fifo[1],
+                        xcc_fpga_fifo[2], xcc_fpga_fifo[3]);
+                xcc_fpga_i2c_status_logged = true;
+            }
+            integrity = xcc_fpga_fifo[integrity_index];
+            fprintf(stderr,
+                    "xcc-fpga: transaction=%u payload-length=%u"
+                    " response-integrity-index=%u value=0x%02x\n",
+                    xcc_fpga_transaction, payload_length, integrity_index,
+                    integrity);
+        }
+        xcc_fpga_transaction++;
+    } else if (window->index == 0 && offset == 0 &&
+               xcc_fpga_fifo_pos == 0 &&
+               xcc_fpga_request_length + size <= sizeof(xcc_fpga_request)) {
+        unsigned int expected_length;
+        unsigned int header_length;
+        uint8_t request_crc;
+
+        for (unsigned int i = 0; i < size; i++) {
+            xcc_fpga_request[xcc_fpga_request_length + i] = value >> (i * 8);
+        }
+        xcc_fpga_request_length += size;
+        request_crc = xcc_fpga_request_crc();
+        expected_length = xcc_fpga_expected_write_length();
+        header_length = (xcc_fpga_request[0] & 0x40) ? 6 : 4;
+        if (xcc_fpga_collecting_write &&
+            ((expected_length != 0 &&
+              xcc_fpga_request_length == expected_length) ||
+             (expected_length == 0 &&
+              xcc_fpga_request_length > header_length &&
+              request_crc == 0))) {
+            if (request_crc != 0) {
+                error_report("xcc-fpga: transaction=%u invalid write request"
+                             " CRC 0x%02x",
+                             xcc_fpga_transaction - 1, request_crc);
+            } else {
+                xcc_fpga_collecting_write = false;
+                xcc_fpga_response_length = 0;
+                if (xcc_fpga_request_length == 6 &&
+                    xcc_fpga_request[0] == 0x80 &&
+                    xcc_fpga_request[1] == 0x02 &&
+                    xcc_fpga_request[2] == 0x41 &&
+                    xcc_fpga_request[3] == 0x01 &&
+                    xcc_fpga_request[4] == 0x80) {
+                    xcc_fpga_i2c_operation_complete = true;
+                    fprintf(stderr,
+                            "xcc-fpga: transaction=%u I2C operation complete\n",
+                            xcc_fpga_transaction - 1);
+                }
+                xcc_fpga_refresh_response_integrity();
+                fprintf(stderr,
+                        "xcc-fpga: transaction=%u write-request-complete"
+                        " length=%u response-integrity=0x%02x\n",
+                        xcc_fpga_transaction - 1, xcc_fpga_request_length,
+                        xcc_fpga_fifo[2]);
+            }
+        } else if (xcc_fpga_collecting_write) {
+            fprintf(stderr,
+                    "xcc-fpga: transaction=%u write-request-length=%u"
+                    " expected=%u pending\n",
+                    xcc_fpga_transaction - 1, xcc_fpga_request_length,
+                    expected_length);
+        } else {
+            if (xcc_fpga_request_length == 6 &&
+                (xcc_fpga_request[0] & 0x40)) {
+                xcc_fpga_response_length = xcc_fpga_request[5] * 16;
+            }
+            xcc_fpga_refresh_response_integrity();
+            fprintf(stderr,
+                    "xcc-fpga: transaction=%u request-length=%u"
+                    " response-integrity-index=%u value=0x%02x\n",
+                    xcc_fpga_transaction - 1, xcc_fpga_request_length,
+                    xcc_fpga_response_length + 2,
+                    xcc_fpga_fifo[xcc_fpga_response_length + 2]);
+        }
+    }
+    if (window->index == 2 && offset <= XCC_FPGA_DOORBELL &&
+        offset + size > XCC_FPGA_DOORBELL &&
+        buf[XCC_FPGA_DOORBELL] & 1) {
+        xcc_fpga_complete(bmc);
+    }
+}
+
+static const MemoryRegionOps xcc_fpga_ops = {
+    .read = xcc_fpga_read,
+    .write = xcc_fpga_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 1,
+        .max_access_size = 8,
+    },
+    .impl = {
+        .min_access_size = 1,
+        .max_access_size = 8,
+    },
+};
+
+static void aspeed_xcc_fpga_init(AspeedMachineState *bmc)
+{
+    static const char * const names[] = {
+        "xcc-fpga-command", "xcc-fpga-data", "xcc-fpga-control",
+    };
+    g_autofree char *contents = NULL;
+    gsize length = 0;
+    g_autoptr(GError) error = NULL;
+
+    if (!bmc->xcc_ptables_file ||
+        !g_file_get_contents(bmc->xcc_ptables_file, &contents, &length,
+                             &error)) {
+        error_report("xcc-fpga: cannot read PTABLES file: %s",
+                     error ? error->message : "path not configured");
+    } else if (length != sizeof(xcc_ptables_data) ||
+               memcmp(contents, "PTABLES", 7) != 0) {
+        error_report("xcc-fpga: invalid PTABLES file %s",
+                     bmc->xcc_ptables_file);
+    } else {
+        memcpy(xcc_ptables_data, contents, length);
+        xcc_ptables_valid = true;
+    }
+
+    for (unsigned int i = 0; i < ARRAY_SIZE(xcc_fpga_bases); i++) {
+        bmc->xcc_fpga_buf[i] = g_malloc0(xcc_fpga_sizes[i]);
+        bmc->xcc_fpga_window[i].machine = bmc;
+        bmc->xcc_fpga_window[i].index = i;
+        memory_region_init_io(&bmc->xcc_fpga_mr[i], OBJECT(bmc),
+                              &xcc_fpga_ops, &bmc->xcc_fpga_window[i],
+                              names[i], xcc_fpga_sizes[i]);
+        memory_region_add_subregion(get_system_memory(), xcc_fpga_bases[i],
+                                    &bmc->xcc_fpga_mr[i]);
+    }
+
+    /* Lenovo's probe accepts an interface descriptor beginning with 0x80. */
+    bmc->xcc_fpga_buf[0][0x300] = 0x80;
+    xcc_ptables_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                     xcc_ptables_install, NULL);
+    timer_mod(xcc_ptables_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 100 * SCALE_US);
+    fprintf(stderr,
+            "xcc-fpga: model enabled; PTABLES handoff scheduled\n");
+}
 #include "hw/arm/aspeed_soc.h"
 #include "hw/arm/machines-qom.h"
 #include "hw/block/flash.h"
 #include "hw/gpio/pca9552.h"
 #include "hw/gpio/pca9554.h"
 #include "system/block-backend.h"
-#include "qemu/error-report.h"
 #include "qemu/units.h"
 #include "hw/core/qdev-clock.h"
 #include "system/system.h"
@@ -187,6 +553,10 @@ static void aspeed_machine_init(MachineState *machine)
     aspeed_connect_serial_hds_to_uarts(bmc);
     qdev_realize(DEVICE(bmc->soc), NULL, &error_abort);
 
+    if (bmc->xcc_fpga) {
+        aspeed_xcc_fpga_init(bmc);
+    }
+
     if (defaults_enabled()) {
         aspeed_board_init_flashes(&bmc->soc->fmc,
                               bmc->fmc_model ? bmc->fmc_model : amc->fmc_model,
@@ -273,11 +643,36 @@ static void aspeed_set_mmio_exec(Object *obj, bool value, Error **errp)
     ASPEED_MACHINE(obj)->mmio_exec = value;
 }
 
+static bool aspeed_get_xcc_fpga(Object *obj, Error **errp)
+{
+    return ASPEED_MACHINE(obj)->xcc_fpga;
+}
+
+static void aspeed_set_xcc_fpga(Object *obj, bool value, Error **errp)
+{
+    ASPEED_MACHINE(obj)->xcc_fpga = value;
+}
+
+static char *aspeed_get_xcc_ptables_file(Object *obj, Error **errp)
+{
+    return g_strdup(ASPEED_MACHINE(obj)->xcc_ptables_file);
+}
+
+static void aspeed_set_xcc_ptables_file(Object *obj, const char *value,
+                                        Error **errp)
+{
+    AspeedMachineState *bmc = ASPEED_MACHINE(obj);
+
+    g_free(bmc->xcc_ptables_file);
+    bmc->xcc_ptables_file = g_strdup(value);
+}
+
 static void aspeed_machine_instance_init(Object *obj)
 {
     AspeedMachineClass *amc = ASPEED_MACHINE_GET_CLASS(obj);
 
     ASPEED_MACHINE(obj)->mmio_exec = false;
+    ASPEED_MACHINE(obj)->xcc_fpga = false;
     ASPEED_MACHINE(obj)->hw_strap1 = amc->hw_strap1;
 }
 
@@ -343,6 +738,17 @@ static void aspeed_set_bmc_console(Object *obj, const char *value, Error **errp)
 
 static void aspeed_machine_class_props_init(ObjectClass *oc)
 {
+    object_class_property_add_bool(oc, "xcc-fpga",
+                                   aspeed_get_xcc_fpga,
+                                   aspeed_set_xcc_fpga);
+    object_class_property_set_description(oc, "xcc-fpga",
+                           "Enable the experimental Lenovo XCC FPGA MMIO model");
+    object_class_property_add_str(oc, "xcc-ptables-file",
+                                  aspeed_get_xcc_ptables_file,
+                                  aspeed_set_xcc_ptables_file);
+    object_class_property_set_description(oc, "xcc-ptables-file",
+                           "Load Lenovo XCC PTABLES for direct kernel boot");
+
     object_class_property_add_bool(oc, "execute-in-place",
                                    aspeed_get_mmio_exec,
                                    aspeed_set_mmio_exec);
diff --git a/hw/sd/sd.c b/hw/sd/sd.c
