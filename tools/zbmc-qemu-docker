#!/usr/bin/env bash
set -euo pipefail

IMAGE=sha256:0e03b041c9014a8be084d4fa72413c8db6a9897bdabab9804a9f302dc461fa3f
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
guest_binary="${1:?missing packaged QEMU path}"
shift

if docker info >/dev/null 2>&1; then
  docker_cmd=(docker)
elif sudo -n docker info >/dev/null 2>&1; then
  docker_cmd=(sudo -n docker)
else
  echo "zbmc QEMU runtime cannot access Docker; run tools/install-qemu-runtime" >&2
  exit 1
fi

docker_args=(run --rm --network host --workdir "$PWD"
  --volume "$ROOT:$ROOT" --volume /tmp:/tmp --volume /var/tmp:/var/tmp)
for arg in "$@"; do
  if [[ "$arg" == *ifname=* ]]; then
    docker_args+=(--device /dev/net/tun --cap-add NET_ADMIN)
    break
  fi
done
if [ "${ZBMC_QEMU_DOCKER_DETACH:-0}" = 1 ]; then
  cid=$("${docker_cmd[@]}" "${docker_args[@]}" --detach "$IMAGE" "$guest_binary" "$@")
  trap '"${docker_cmd[@]}" stop -t 3 "$cid" >/dev/null 2>&1 || true' INT TERM
  trap '' HUP
  status=$("${docker_cmd[@]}" wait "$cid")
  [[ "$status" =~ ^[0-9]+$ ]] || status=1
  exit "$status"
fi
exec "${docker_cmd[@]}" "${docker_args[@]}" -i "$IMAGE" "$guest_binary" "$@"
