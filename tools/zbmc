        }
        _row L2 "$_l2state" "$_l2why" "" "$_l2nt"
        _row SSH "$_sshstate" "$_sshwhy" "$_sshds" "$_sshnt"
        _row IPMI "$_ipmistate" "$_ipmiwhy" "$_ipmids" "$_ipmint"
        _row Redfish "$_redfishstate" "$_redfishwhy" "$_redfishds" "$_redfishnt"
        _row Web-UI "$_webuistate" "$_webuiwhy" "$_webuids" "$_webuint"
        _row Console "$_consolestate" "$_consolewhy" "$_consoleds" "$_consolent"
        if [ "$_ncsi_expected" = 1 ]; then
          _row NC-SI "$_ncsistate" "$_ncsiwhy" "$_ncsids" "$_ncsint"
        fi
        printf "%-9s : %s%s%s  (%s%s%s)\n" "Net (IP)" "$CP" "$ZBMC_IP" "$CZ" "$CC" "$ZBMC_NAME" "$CZ"
        if [ -n "${ZBMC_REMEDIATION:-}" ]; then
          printf "%-9s : %s (%s)\n" "Remediation" "$(_colored_state CONFIGURED)" "$ZBMC_REMEDIATION"
        else
          printf "%-9s : N/A (not configured)\n" "Remediation"
        fi
      fi

      if [ "$_failed_n" -gt 0 ]; then _health=DEGRADED
      elif [ "$_starting_n" -gt 0 ]; then _health=STARTING
      else _health=READY; fi
      _health_detail="$_ready_names"
      if [ "$_starting_n" -gt 0 ]; then
        [ -n "$_health_detail" ] && _health_detail="$_health_detail; "
        _health_detail="${_health_detail}${_starting_names} coming online"
      fi
      if [ "$_failed_n" -gt 0 ]; then
        [ -n "$_health_detail" ] && _health_detail="$_health_detail; "
        _health_detail="${_health_detail}${_failed_names} failed"
      fi
      printf "%-9s : %s [%d/%d - %s]\n" "Health" "$(_colored_state "$_health")" \
        "$_ready_n" "$_expected_n" "$_health_detail"
      if [ "$_follow" = 1 ] && [ "${_run_state:-}" = starting ] && [ -f "${ZBMC_RUN_DIR:-}/progress.log" ]; then
        echo "Progress (Ctrl-C stops following; QEMU keeps running):"
        tail -n +1 -f "$ZBMC_RUN_DIR/progress.log" & _tail_pid=$!
        _watch_pid=$(cat "$ZBMC_RUN_DIR/watcher.pid" 2>/dev/null || true)
        if [[ "$_watch_pid" =~ ^[0-9]+$ ]]; then
          while kill -0 "$_watch_pid" 2>/dev/null; do sleep 1; done
        fi
        sleep 0.2; kill "$_tail_pid" 2>/dev/null || true; wait "$_tail_pid" 2>/dev/null || true
      fi
      break
    done ;;
  ssh)    zbmc_ssh "$@" ;;
  telnet) declare -F zbmc_telnet >/dev/null && zbmc_telnet "$@" || { nc "$ZBMC_IP" "${TELNET_PORT:-23}"; } ;;
  ipmi)  [ $# -eq 0 ] && { echo "usage: zbmc $ZBMC_NAME ipmi <cmd...>  (e.g. mc info)"; exit 2; }; Z "$@" ;;
  web)   zbmc_web "$@" ;;
  console)
    # console = a window on the LIVE console. If the box is DOWN, say so — do NOT
    # replay the stale $LOG from the last run (which is bring-up/restore output and
    # can misleadingly show "IDRAC10_UP" etc. long after the box is gone).
    if ! running >/dev/null 2>&1; then
      echo "${CR}$ZBMC_NAME is DOWN${CZ} — no live console. Start it:  zbmc $ZBMC_NAME start"; exit 1; fi
    if _zr_load "" 2>/dev/null && [ -f "$ZBMC_RUN_DIR/console.log" ]; then
      CONSOLE_LOG="$ZBMC_RUN_DIR/console.log"
    fi
    if declare -F zbmc_console >/dev/null; then zbmc_console
    elif _zr_load "" 2>/dev/null && [ -f "$ZBMC_RUN_DIR/console.log" ]; then tail -f "$ZBMC_RUN_DIR/console.log"
    else echo "$ZBMC_NAME is up, but its current run has no console evidence — try 'ssh' or restart"; fi ;;
  build) zbmc_build ;;
  shell)    declare -F zbmc_shell    >/dev/null && zbmc_shell    "$@" || { echo "zbmc: '$ZBMC_NAME' has no shell verb"; exit 2; } ;;
  snapshot) declare -F zbmc_snapshot >/dev/null && zbmc_snapshot "$@" || { echo "zbmc: '$ZBMC_NAME' has no snapshot support"; exit 2; } ;;
  restore)  declare -F zbmc_restore  >/dev/null && zbmc_restore  "$@" || { echo "zbmc: '$ZBMC_NAME' has no restore support"; exit 2; } ;;
  rename)
    new="${1:-}"; old="$ZBMC_NAME"
    [ -n "$new" ] || { echo "usage: zbmc $old rename <newname>"; exit 2; }
    [[ "$new" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "zbmc: bad name '$new' (allowed: A-Za-z0-9_-)"; exit 2; }
    [ "$new" = "$old" ] && { echo "zbmc: already named '$old'"; exit 0; }
    find_box "$new" >/dev/null && { echo "zbmc: a box named '$new' already exists"; exit 2; }
    # Surgical: only identity fields. NEVER the qemu machine (ast2600-evb) or image (evb-ast2600.static.mtd),
    # which also contain the name substring — perl \Q..\E + line anchors keep those untouched.
    perl -i -pe "
      s/^ZBMC_NAME=.*/ZBMC_NAME=$new/;
      s/^ZBMC_HOST=\Q$old\E\$/ZBMC_HOST=$new/;
      if (/^(PIDF|LOG|SOCK)=/) { s/zbmc-\Q$old\E/zbmc-$new/ }
      # ZBMC_HINT retired — no line to update
    " "$BF" || { echo "zbmc: rename edit failed"; exit 1; }
    # Swap the /etc/hosts alias if it used the old name (box re-adds the new one on next start).
    [ "${ZBMC_HOST:-}" = "$old" ] && sudo perl -i -pe "s/\b\Q$old\E\b/$new/g if /^\Q$ZBMC_IP\E\s/" /etc/hosts 2>/dev/null
    echo "renamed '$old' -> '$new'  ($BF)"
    running >/dev/null 2>&1 && echo "  box is running — 'zbmc $new restart' to refresh its scratch paths/hosts"
    echo "  try:  zbmc $new status" ;;
  *) echo "zbmc: unknown verb '$VERB'"; echo; usage; exit 2 ;;
esac
