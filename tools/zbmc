#!/usr/bin/env bash
# zbmc — virtual-BMC control (init.d-style). One tool for every emulated BMC.
#   zbmc                         list boxes + verbs (help)
#   zbmc <box>                   status of that box
#   zbmc <box> <verb> [args]     start|stop|restart|status|ssh|ipmi|web|console|shell|build|net
# Boxes are described by zbmc.box files (register their paths in REGISTRY below).
set -u
# Ctrl-C: without an explicit trap, a probe child (nc/curl/timeout/sleep) absorbs the SIGINT and the
# status/`all` loop just continues to the next iteration — so Ctrl-C looks dead. Trap forces the whole
# tool to exit; the in-flight child already got the same SIGINT from the terminal, so it dies with us.
trap 'echo; exit 130' INT TERM

# --- status colors (only when stdout is a TTY; pipes/greps stay plain) --------
# CG green=good  CR red=bad  CP purple(#af8dc3)=IP+creds  CC cyan=box name  CZ reset
if [ -t 1 ] || [ -n "${ZBMC_COLOR:-}" ]; then
  CG=$'\e[1;38;2;74;222;128m'; CR=$'\e[31m'; CP=$'\e[38;2;175;141;195m'; CC=$'\e[38;2;34;211;238m'; CZ=$'\e[0m'
else CG=; CR=; CP=; CC=; CZ=; fi

# --- registry: every boxes/<name>/zbmc.box in this repo (relative to this script) ----------
# Single source of truth: the repo's own boxes/. phd runs this tool via a symlink (dogfood),
# so there is exactly ONE tool + ONE set of descriptors — no more manual-copy drift.
# Resolve symlinks (BSD/macOS has no `readlink -f`) so discovery works when invoked via the
# phd/bin/zbmc symlink — otherwise _REPO would be phd/ and boxes/* would glob nothing.
_src="${BASH_SOURCE[0]:-$0}"
while [ -L "$_src" ]; do
  _lnk="$(readlink "$_src")"; case "$_lnk" in /*) _src="$_lnk";; *) _src="$(dirname "$_src")/$_lnk";; esac
done
_SELF="$(cd "$(dirname "$_src")" && pwd)"
_REPO="$(cd "$_SELF/.." && pwd)"
ZIPMI="${ZIPMI:-$_REPO/../zipmi}"
ZHOSTS_FILE="${ZHOSTS_FILE:-$_REPO/zhosts.txt}"

# --- user network config (zbmc.conf) ---
# Sourced before any box, so ZBMC_POOL and ZBMC_IP_* are available when zbmc.box sets ZBMC_IP.
[ -f "$_REPO/zbmc.conf" ] && . "$_REPO/zbmc.conf"
export ZBMC_POOL="${ZBMC_POOL:-}"

# _zbmc_resolve_ip BOX_NAME POOL_OCTET DEFAULT_IP
# zhosts.txt is canonical. Legacy config remains as a fallback for old clones.
_zbmc_resolve_ip(){
  local mapped=
  if [ -f "$ZHOSTS_FILE" ]; then
    mapped=$(awk -v n="$1" '$1 == n { print $2; exit }' "$ZHOSTS_FILE")
    if [ -z "$mapped" ]; then
      echo "zbmc: $1 has no address in $ZHOSTS_FILE" >&2
      return 1
    fi
    echo "$mapped"; return 0
  fi
  local varname="ZBMC_IP_$(echo "$1" | tr '-' '_')"
  local override="${!varname:-}"
  if [ -n "$override" ]; then echo "$override"
  elif [ -n "${ZBMC_POOL:-}" ]; then echo "${ZBMC_POOL}.$2"
  else echo "$3"; fi
}
export -f _zbmc_resolve_ip

# _zbmc_pick_port PREFERRED FALLBACK — return PREFERRED if bindable, else FALLBACK.
# On Linux, sshd on 0.0.0.0:22 blocks QEMU from binding $IP:22; detect and dodge.
_zbmc_pick_port(){
  local want="$1" alt="$2"
  if command -v ss >/dev/null 2>&1; then
    ss -tlnH 2>/dev/null | grep -qE "0\.0\.0\.0:${want} " && { echo "$alt"; return; }
  elif command -v lsof >/dev/null 2>&1; then
    lsof -iTCP:"$want" -sTCP:LISTEN -P -n >/dev/null 2>&1 && { echo "$alt"; return; }
  fi
  echo "$want"
}
export -f _zbmc_pick_port

_zbmc_duration(){
  local s="${1:-0}" d h m
  if [ "$s" -lt 60 ]; then printf '%ss' "$s"; return; fi
  if [ "$s" -lt 3600 ]; then printf '%s min%s' "$((s/60))" " $((s%60)) secs"; return; fi
  if [ "$s" -lt 86400 ]; then printf '%s hour%s' "$((s/3600))" " $(((s%3600)/60)) mins"; return; fi
  d=$((s/86400)); h=$(((s%86400)/3600)); printf '%s day%s' "$d" " $h hours"
}
export -f _zbmc_duration

# _zbmc_lo_alias IP — add an IP to the loopback interface (idempotent, cross-platform).
_zbmc_lo_alias(){
  local ip="$1" SUDO=; [ "$(id -u)" = 0 ] || SUDO=sudo
  case "$(uname -s)" in
    Darwin) $SUDO ifconfig lo0 alias "$ip" up 2>/dev/null ;;
    *)      ip addr show dev lo 2>/dev/null | grep -q "$ip" || $SUDO ip addr add "$ip/32" dev lo 2>/dev/null ;;
  esac
}
export -f _zbmc_lo_alias

REGISTRY=( "$_REPO"/boxes/*/zbmc.box )

boxname_of(){ ( set -u; . "$1" 2>/dev/null; echo "${ZBMC_NAME:-}" ); }
boxip_of(){ ( set -u; . "$1" 2>/dev/null; echo "${ZBMC_IP:-}" ); }
find_box(){
  local want="$1" f name ip
  for f in "${REGISTRY[@]}"; do
    [ -f "$f" ] || continue
    name="$(boxname_of "$f")"; ip="$(boxip_of "$f")"
    { [ "$name" = "$want" ] || [ "$ip" = "$want" ]; } && { echo "$f"; return 0; }
  done
  return 1
}

usage(){
  echo "zbmc — virtual-BMC control"
  echo "usage: zbmc <box> <verb> [args]"
  echo
  echo "boxes:"
  local f n d; for f in "${REGISTRY[@]}"; do [ -f "$f" ] || continue
    ( . "$f" 2>/dev/null; printf "  %-10s %s\n" "$ZBMC_NAME" "${ZBMC_DESC:-}" ); done
  echo
  echo "  (use 'all' as the box to run a verb across every box:  zbmc all status)"
  echo "  (just the names:  zbmc list   |   zbmc -l)"
  echo
  echo "verbs:"
  echo "  up|start [-v|-d] [--deadline SEC] [--no-wait] [--build] [--no-web]"
  echo "                    boot and wait through functional readiness (default); record evidence"
  echo "                    --no-wait leaves a supervised readiness watcher running"
  echo "  down|stop         stop captures, archive final evidence, then stop QEMU"
  echo "  restart           down then blocking up"
  echo "  status [-f] [-v]  concise health; -v explains checks; -f follows startup (default verb)"
  echo "  explain [RUN_ID]  explain the latest (or named) run and its terminal cause"
  echo "  evidence [RUN_ID] show the run evidence directory and its files"
  echo "  ssh [cmd]         SSH into the box (dropbear; sysadmin/blank)"
  echo "  telnet            telnet into the box (mini_telnetd; no auth; port 23)"
  echo "  ipmi <cmd...>     authenticated zipmi (e.g. zbmc idrac9 ipmi mc info)"
  echo "  web               bring up httpd + Redfish"
  echo "  console           live console (box must be up): interactive serial login on"
  echo "                    boxes with a console (megarac-hpe, nvidia-obmc); else tail -f the log"
  echo "  shell             boot init=/bin/sh — unrestricted root, no net/IPMI (RE; megarac-hpe)"
  echo "  build             rebuild the boot image"
  echo "  rename <newname>  rename the box (dispatch name + host alias; qemu machine/image untouched)"
  echo
  echo "  Address map: $ZHOSTS_FILE (generated commands always use numeric IPs)"
}

# --- status probe helpers -------------------------------------------------------------
# Each _probe_* echoes "STATE|DISPLAY|NOTE"; STATE = ok|authfail|fail|na.
# _ipmi_invocation is PURE (no network) so the shown command == the probed command.
_ipmi_invocation(){ # $1 = pw|key ; echoes the copy-paste IPMI command
  if [ "$1" = pw ]; then
    echo "zipmi -H $ZBMC_IP -U ${IPMI_USER:-} -P ${IPMI_PW:-}${IPMI_OPTS:+ $IPMI_OPTS}"
  else
    echo "zipmi -H $ZBMC_IP -U ${IPMI_USER:-} -K ${IPMI_KEY:-}${IPMI_OPTS:+ $IPMI_OPTS}"
  fi; }

_ipmi_run(){ # $1 = pw|key ; returns 0 if authed, 2 if auth-fail, 1 if no-answer
  local r outer=$(( ${IPMI_T:-3} + 6 ))
  if [ "$1" = pw ]; then
    r=$(timeout -s KILL "$outer" env PYTHONPATH="$ZIPMI" python3 -m zipmi.cli.zipmi -H "$ZBMC_IP" -p "${IPMI_PORT:-623}" -U "${IPMI_USER:-}" -P "${IPMI_PW:-}" ${IPMI_OPTS:-} -t "${IPMI_T:-3}" -R 0 mc info 2>&1)
  else
    r=$(timeout -s KILL "$outer" env PYTHONPATH="$ZIPMI" python3 -m zipmi.cli.zipmi -H "$ZBMC_IP" -p "${IPMI_PORT:-623}" -U "${IPMI_USER:-}" -K "${IPMI_KEY:-}" ${IPMI_OPTS:-} -t "${IPMI_T:-3}" -R 0 mc info 2>&1)
  fi
  # authfail patterns checked FIRST — "BMC error" could otherwise match a 0x0d reply
  echo "$r" | grep -qiE "0x0d|auth code mismatch|unauthorized" && return 2
  # post-auth: Manufacturer data OR post-auth command-level error = session authenticated
  echo "$r" | grep -qiE "Manufacturer|BMC error|completion code|Unspecified on cmd" && return 0
  return 1; }

_probe_ipmi(){ # cred ladder: password first, key fallback; echoes STATE|DISPLAY|NOTE
  if command -v flock >/dev/null 2>&1; then
    exec 9<"$BF" || { echo "fail||probe lock unavailable"; return; }
    flock -w "$(( ${IPMI_T:-3} + 8 ))" 9 || { echo "fail||probe busy"; return; }
  fi
  if declare -F zbmc_ipmi_health >/dev/null; then
    local r rc
    r=$(zbmc_ipmi_health 2>&1); rc=$?
    [ "$rc" = 0 ] && { echo "ok|$(_ipmi_invocation pw)|$r"; return; }
    echo "fail||${r:-box-specific IPMI probe failed}"; return
  fi
  if ! python3 -c "import zipmi" 2>/dev/null && ! PYTHONPATH="$ZIPMI" python3 -c "import zipmi" 2>/dev/null; then
    if command -v ipmitool >/dev/null 2>&1; then
      local r; r=$(timeout -s KILL 4 ipmitool -I lanplus -H "$ZBMC_IP" -p "${IPMI_PORT:-623}" -U "${IPMI_USER:-}" -P "${IPMI_PW:-}" mc info 2>&1)
      echo "$r" | grep -qiE "Manufacturer" && { echo "ok|ipmitool -I lanplus -H $ZBMC_IP -U ${IPMI_USER:-} mc info|"; return; }
      echo "fail||no answer (warming/down)"; return
    fi
    echo "fail||not checked (need zipmi or ipmitool)"; return
  fi
  local has_key=0; [ -n "${IPMI_KEY:-}" ] && [ "${IPMI_KEY}" != "00" ] && has_key=1
  if [ "$has_key" = 1 ]; then
    _ipmi_run key; local ky=$?
    [ "$ky" = 0 ] && { echo "ok|$(_ipmi_invocation key)|"; return; }
    _ipmi_run pw; local pw=$?
    [ "$pw" = 0 ] && { echo "ok|$(_ipmi_invocation pw)|key auth failed; password worked"; return; }
    { [ "$ky" = 2 ] || [ "$pw" = 2 ]; } && { echo "authfail||key/password rejected"; return; }
    echo "fail||no answer (warming/down)"; return
  fi
  _ipmi_run pw; local pw=$?
  [ "$pw" = 0 ] && { echo "ok|$(_ipmi_invocation pw)|"; return; }
  [ "$pw" = 2 ] && { echo "authfail||password rejected"; return; }
  echo "fail||no answer (warming/down)"; }

_probe_ssh(){
  local cmd='.'" '$BF'"'; zbmc_ssh '\''echo up'\'''
  if command -v flock >/dev/null 2>&1; then
    exec 8<"$BF" || { echo "fail||probe lock unavailable"; return; }
    flock -w 6 8 || { echo "fail||probe busy"; return; }
  fi
  if timeout -s KILL 10 bash -c "$cmd" 2>/dev/null | grep -q up; then
    echo "ok|zbmc $ZBMC_IP ssh|"; else echo "fail||no (refused/booting)"; fi; }

_probe_redfish(){
  if declare -F zbmc_redfish_health >/dev/null; then
    local r rc
    r=$(zbmc_redfish_health 2>&1); rc=$?
    [ "$rc" = 0 ] && { echo "ok|curl -sk -u ${IPMI_USER:-}:${IPMI_PW:-} https://$ZBMC_IP:${WEB_PORT:-443}/redfish/v1/Managers|$r"; return; }
    echo "fail||${r:-box-specific Redfish probe failed}"; return
  fi
  local url="https://$ZBMC_IP:${WEB_PORT:-443}/redfish/v1/Managers"
  # ponytail: DISPLAY uses $ZBMC_HOST while probe hits $ZBMC_IP — both resolve the same via /etc/hosts, so the pasted command works.
  if timeout -s KILL 4 curl -sk --max-time 3 -u "${IPMI_USER:-}:${IPMI_PW:-}" "$url" 2>/dev/null | grep -qi "ManagerCollection\|Members"; then
    echo "ok|curl -sk -u ${IPMI_USER:-}:${IPMI_PW:-} https://$ZBMC_IP:${WEB_PORT:-443}/redfish/v1/Managers|"
  else echo "fail||down"; fi; }

_probe_webui(){
  if declare -F zbmc_webui_health >/dev/null; then
    local r rc
    r=$(zbmc_webui_health 2>&1); rc=$?
    [ "$rc" = 0 ] && { echo "ok|curl -sk https://$ZBMC_IP:${WEB_PORT:-443}/|$r"; return; }
    echo "fail||${r:-box-specific Web-UI probe failed}"; return
  fi
  local url="https://$ZBMC_IP:${WEB_PORT:-443}/" code
  code=$(timeout -s KILL 4 curl -sk --max-time 3 -o /dev/null -w '%{http_code}' "$url" 2>/dev/null)
  case "$code" in
    ""|000) echo "fail||no HTTPS root response" ;;
    *) echo "ok|curl -sk $url|HTTP $code" ;;
  esac
}

_probe_console(){
  if [ -n "${SOCK:-}" ] && { [ -S "$SOCK" ] || [ -p "$SOCK" ]; }; then
    echo "ok|zbmc $ZBMC_IP console|interactive serial"
  elif [ -f "${LOG:-}" ]; then
    echo "ok|zbmc $ZBMC_IP console|live log; non-interactive"
  elif declare -F zbmc_console >/dev/null; then
    echo "ok|zbmc $ZBMC_IP console|box console"
  else
    echo "na||unsupported"
  fi; }

# Allow `ZBMC_SOURCE_ONLY=1 . zbmc` to load helpers without running a verb (tests).
[ -n "${ZBMC_SOURCE_ONLY:-}" ] && return 0 2>/dev/null

[ $# -eq 0 ] && { usage; exit 0; }

_need_root(){ # verbs that bind privileged ports or kill qemu need root
  case "$1" in up|start|down|stop|restart|shell|snapshot|restore) return 0;; esac; return 1; }

BOX="$1"; shift
# `zbmc list` / `zbmc -l` — just the box names, one per line (no status). For scripting/quick recall.
if [ "$BOX" = list ] || [ "$BOX" = -l ] || [ "$BOX" = --list ]; then
  for f in "${REGISTRY[@]}"; do [ -f "$f" ] || continue; n="$(boxname_of "$f")"; [ -n "$n" ] && echo "$n"; done
  exit 0
fi
# `zbmc all [verb]` / `zbmc ls` — run the verb (default status) across every registered box.
if [ "$BOX" = all ] || [ "$BOX" = ls ]; then
  verb="${1:-status}"; td="$_REPO/work/.zbmc-all-tmp.$$"; rm -rf "$td"; mkdir -p "$td"; [ -t 1 ] && export ZBMC_COLOR=1
  # root check for the whole fleet — fail once up front, not N times in subprocesses
  _all_run_as_me=0; _all_no_fix_ip=0
  for _a in "${@:2}"; do [ "$_a" = "--run-as-me" ] && _all_run_as_me=1; [ "$_a" = "--no-fix-ip" ] && _all_no_fix_ip=1; done
  if [ "$_all_run_as_me" = 0 ] && _need_root "$verb" && [ "$(id -u)" != 0 ]; then
    echo "zbmc: '$verb' needs root to bind privileged ports and manage qemu." >&2
    echo "  sudo zbmc all $verb" >&2
    echo "  or: zbmc all $verb --run-as-me  (skip root; you handle port failures)" >&2
    exit 1
  fi
  # resolve box names once (registry order)
  names=(); for f in "${REGISTRY[@]}"; do [ -f "$f" ] || continue; n="$(boxname_of "$f")"; [ -n "$n" ] && names+=("$n"); done
  N=${#names[@]}
  if [ "$verb" = status ]; then printf 'checking status on %s%d%s inmates in the asylum -\n' "$CC" "$N" "$CZ"
  else printf 'running %s%s%s on %s%d%s inmates -\n' "$CC" "$verb" "$CZ" "$CC" "$N" "$CZ"; fi
  # fan out concurrently; each box drops a .done marker when finished
  _xf=; [ "$_all_run_as_me" = 1 ] && _xf="--run-as-me"; [ "$_all_no_fix_ip" = 1 ] && _xf="$_xf --no-fix-ip"
  i=0; for n in "${names[@]}"; do ( "$0" "$n" "$verb" $_xf >"$td/$i" 2>&1; : > "$td/$i.done" ) & i=$((i+1)); done
  # print in registry order, STREAMING: block on each box's own completion, then flush it
  alive=0; j=0
  for n in "${names[@]}"; do
    printf '\n===== %s%s%s (%d/%d) =====\n' "$CC" "$n" "$CZ" "$((j+1))" "$N"
    while [ ! -e "$td/$j.done" ]; do sleep 0.1; done
    cat "$td/$j"
    grep -qE "QEMU +: .*UP" "$td/$j" && alive=$((alive+1))
    j=$((j+1))
  done
  [ "$verb" = status ] && printf '\n%s%d/%d%s inmates currently alive\n' "$CG" "$alive" "$N" "$CZ"
  rm -rf "$td"; exit 0
fi
BF="$(find_box "$BOX")" || { echo "zbmc: unknown box '$BOX'"; echo; usage; exit 2; }
# shellcheck disable=SC1090
. "$BF"
ZBMC_DESCRIPTOR_REQUIRED_SERVICES="${ZBMC_REQUIRED_SERVICES:-ssh ipmi}"
export ZBMC_IP ZBMC_HOST ZBMC_NAME ZBMC_DESCRIPTOR_REQUIRED_SERVICES
case "${1:-}" in
  ""|-f|--follow|-v|--verbose|-d|--debug) VERB=status ;;
  *) VERB="$1"; shift ;;
esac

running(){ # pidfile first; then a box-specific or legacy hostfwd lookup
  local p; p=$(cat "$PIDF" 2>/dev/null) && ps -p "$p" >/dev/null 2>&1 && { echo "$p"; return 0; }
  if declare -F zbmc_running >/dev/null; then
    p=$(zbmc_running) && [ -n "$p" ] && { echo "$p"; return 0; }
  fi
  p=$(pgrep -f "hostfwd=udp:${ZBMC_IP}:${IPMI_PORT:-623}-:623" | head -1) && [ -n "$p" ] && { echo "$p"; return 0; }
  return 1; }

# Per-run event records, packet capture, readiness state machine, and failure explanations.
# shellcheck disable=SC1091
. "$_SELF/zbmc-runlib"
# IPMI via zipmi, straight at the box's real IP + standard port 623 (qemu binds it directly as root).
# A box may override by defining zbmc_ipmi() (e.g. X14 uses password-auth ipmitool, not zipmi/-K).
Z(){ if declare -F zbmc_ipmi >/dev/null; then zbmc_ipmi "$@"; else
  timeout -s KILL "$(( ${IPMI_T:-3} + 6 ))" env PYTHONPATH="$ZIPMI" python3 -m zipmi.cli.zipmi -H "$ZBMC_IP" -p "${IPMI_PORT:-623}" -U "${IPMI_USER:-}" -K "${IPMI_KEY:-}" ${IPMI_OPTS:-} -t "${IPMI_T:-3}" "$@" 2>&1; fi; }

_zbmc_spawn_watcher(){ # run-id qemu-pid deadline detail
  nohup "$0" "$ZBMC_IP" _watch "$1" "$2" "$3" "$4" </dev/null >"$ZBMC_RUN_ROOT/$1/progress.log" 2>&1 &
  printf '%s\n' "$!" >"$ZBMC_RUN_ROOT/$1/watcher.pid"
  echo "$!"
}

# --run-as-me: per-invocation flag
ZBMC_RUN_AS_ME=0; ZBMC_NO_FIX_IP=
for _a in "$@"; do
  [ "$_a" = "--run-as-me" ] && ZBMC_RUN_AS_ME=1
  [ "$_a" = "--no-fix-ip" ] && ZBMC_NO_FIX_IP=1
done
if [ "$ZBMC_RUN_AS_ME" = 0 ] && _need_root "$VERB" && [ "$(id -u)" != 0 ]; then
  echo "zbmc: '$VERB' needs root to bind privileged ports and manage qemu." >&2
  echo "  sudo zbmc $BOX $VERB $*" >&2
  echo "  or: zbmc $BOX $VERB --run-as-me  (skip root; you handle port failures)" >&2
  exit 1
fi

case "$VERB" in
  _watch)
    [ $# -ge 3 ] || exit 2
    _zr_load "$1" || exit 2
    ZBMC_DETAIL="${4:-0}"
    _zr_wait_ready "$2" "$3" ;;
  up|start)
    do_web=1; _wait=1; ZBMC_DETAIL=0; _deadline="${ZBMC_READY_DEADLINE:-900}"
    _original_args="$*"
    for a in "$@"; do case "$a" in
      --build)  zbmc_build || exit 1;;
      --no-web) do_web=0;;
      --no-wait) _wait=0;;
      -v|--verbose) ZBMC_DETAIL=1;;
      -d|--debug) ZBMC_DETAIL=2;;
      --deadline=*) _deadline="${a#*=}";;
    esac; done
    set -- "$@"
    while [ $# -gt 0 ]; do
      if [ "$1" = --deadline ]; then
        [ $# -ge 2 ] || { echo "zbmc: --deadline needs seconds" >&2; exit 2; }
        _deadline="$2"; shift 2
      else shift; fi
    done
    [[ "$_deadline" =~ ^[0-9]+$ ]] || { echo "zbmc: bad deadline '$_deadline'" >&2; exit 2; }
    _zr_set_effective_services "$([ "$do_web" = 0 ] && echo 1 || echo 0)"
    ZBMC_ORIGINAL_COMMAND="zbmc $ZBMC_IP $VERB${_original_args:+ $_original_args}"
    export ZBMC_DETAIL ZBMC_ORIGINAL_COMMAND
    if p=$(running); then _zr_init attach; _zr_event QEMU reused "already running as pid $p"
    else
      _zr_init boot
      if declare -F zbmc_ready >/dev/null; then
        _rmsg=$(zbmc_ready 2>&1); _rrc=$?
        if [ "$_rrc" != 0 ]; then
          _zr_event BUILD failed "$_rmsg"; _zr_result failed BUILD "$_rmsg"; exit 1
        fi
        _zr_event BUILD ready "$_rmsg"
      fi
    # zbmc_boot self-elevates (sudo), sets the lo0 alias + /etc/hosts, and binds $ZBMC_IP:{22,443,623}
    # directly — the box is reachable at its real IP the moment services come up. No socat/net-up step.
    qp=$(zbmc_boot) || {
      _zr_archive_logs; _zr_snapshot failure; _zr_event LAUNCH failed 'box launcher returned failure'; _zr_result failed LAUNCH 'box launcher returned failure'
      echo "$ZBMC_NAME: boot failed; evidence: $ZBMC_RUN_DIR" >&2; exit 1
    }
    sleep 0.5
    if [ -z "$qp" ] || ! ps -p "$qp" >/dev/null 2>&1; then
      echo "$ZBMC_NAME: boot failed — QEMU did not stay running; check $LOG" >&2
      rm -f "$PIDF"
      _zr_archive_logs; _zr_snapshot failure; _zr_event QEMU failed 'QEMU did not stay running'; _zr_result failed QEMU 'QEMU did not stay running'
      exit 1
    fi
    echo "$qp" > "$PIDF"
      p="$qp"
      _zr_event LAUNCH complete "qemu pid $p launched for $ZBMC_IP"
    fi
    qp="$p"
    if ! _zr_capture_start; then
      _zr_archive_logs; _zr_qmp_snapshot; _zr_snapshot failure
      _zr_result failed CAPTURE 'baseline host packet capture failed to start'
      echo "Baseline capture failed; QEMU remains up for diagnosis. Evidence: $ZBMC_RUN_DIR" >&2
      exit 1
    fi
    # auto-bring-up web once SSH is reachable (box needs ~6-15 min to boot). --no-web skips.
    if [ "$do_web" = 1 ]; then
      nohup bash -c '. "'"$BF"'"; qp="'"$qp"'"
        for i in $(seq 1 240); do
          ps -p "$qp" >/dev/null 2>&1 || exit
          if zbmc_ssh "echo up" 2>/dev/null | grep -q up; then sleep 20; zbmc_web; exit; fi
          sleep 8
        done' </dev/null >"$ZBMC_DIR/web-bringup.log" 2>&1 &
      echo $! > "$ZBMC_DIR/web-bringup.pid"
    fi
    if [ "$_wait" = 1 ]; then
      trap '_watch_pid=$(_zbmc_spawn_watcher "$ZBMC_RUN_ID" "$p" "$_deadline" "$ZBMC_DETAIL"); echo; echo "Readiness watcher $_watch_pid continues; follow $ZBMC_RUN_DIR/progress.log"; exit 130' INT TERM
      _zr_wait_ready "$p" "$_deadline"; _wait_rc=$?
      trap 'echo; exit 130' INT TERM
      exit "$_wait_rc"
    else
      _watch_pid=$(_zbmc_spawn_watcher "$ZBMC_RUN_ID" "$p" "$_deadline" "$ZBMC_DETAIL")
      _zr_event WATCHER active "pid $_watch_pid continues readiness checks; follow $ZBMC_RUN_DIR/progress.log"
      echo "Evidence: $ZBMC_RUN_DIR"
      echo "Follow: zbmc $ZBMC_NAME status --follow"
    fi ;;
  down|stop)
    # kill web-bringup poller first (otherwise it lingers after qemu dies, may prompt for SSH passwords)
    wbpid=$(cat "$ZBMC_DIR/web-bringup.pid" 2>/dev/null) && kill "$wbpid" 2>/dev/null; rm -f "$ZBMC_DIR/web-bringup.pid"
    if _zr_load "" 2>/dev/null; then
      _watch_pid=$(cat "$ZBMC_RUN_DIR/watcher.pid" 2>/dev/null || true)
      [ -z "$_watch_pid" ] || kill "$_watch_pid" 2>/dev/null || true
    fi
    _zr_stop_current_run
    if p=$(running); then
      kill "$p" 2>/dev/null || true
      for _ in $(seq 1 20); do ps -p "$p" >/dev/null 2>&1 || break; sleep 0.25; done
      if ps -p "$p" >/dev/null 2>&1; then
        echo "$ZBMC_NAME: QEMU $p did not stop after 5s" >&2; exit 1
      fi
      rm -f "$PIDF"
      echo "$ZBMC_NAME stopped (qemu $p exited)"
    else echo "$ZBMC_NAME not running"; fi ;;
  restart) "$0" "$BOX" down; sleep 1; exec "$0" "$BOX" up "$@" ;;
  explain) _zr_explain "${1:-}" ;;
  evidence) _zr_evidence "${1:-}" ;;
  status)
    _follow=0; ZBMC_DETAIL=0
    for _a in "$@"; do case "$_a" in
      -f|--follow) _follow=1;;
      -v|--verbose) ZBMC_DETAIL=1;;
      -d|--debug) ZBMC_DETAIL=2;;
    esac; done
    _colored_state(){
      case "$1" in
        READY|AVAILABLE|CONFIGURED) printf '%s%s%s' "$CG" "$1" "$CZ" ;;
        FAILED|"AUTH FAILED"|DEGRADED) printf '%s%s%s' "$CR" "$1" "$CZ" ;;
        STARTING) printf '%s%s%s' "$CC" "$1" "$CZ" ;;
        *) printf '%s' "$1" ;;
      esac
    }
    while :; do
      _qpid=; _running=0; _webui_run_disabled=0
      if _qpid=$(running 2>/dev/null); then _running=1; fi
      if [ "$_running" = 1 ]; then
        _up_s=$(ps -p "$_qpid" -o etimes= 2>/dev/null | tr -d ' ')
        if ! [[ "$_up_s" =~ ^[0-9]+$ ]]; then _up_s=0; fi
        echo "QEMU      : ${CG}UP${CZ} (up for $(_zbmc_duration "$_up_s"); pid $_qpid)"
      else
        echo "QEMU      : ${CR}DOWN${CZ} — zbmc $ZBMC_NAME start"
      fi
      [ "$ZBMC_DETAIL" -gt 0 ] && printf "%-9s : %s\n" "Observed" "$(date '+%Y-%m-%dT%H:%M:%S%z (%Z)')"
      if _zr_load "" 2>/dev/null; then
        [ "$_running" = 0 ] || _webui_run_disabled="${ZBMC_WEBUI_DISABLED:-0}"
        _run_label="Last run"; [ "$_running" = 1 ] && _run_label="Current run"
        _run_info=$(python3 - "$ZBMC_RUN_DIR" "$_running" <<'PY'
import json, os, sys, time

root, running = sys.argv[1], sys.argv[2] == "1"

def load(name):
    try:
        with open(os.path.join(root, name), encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError, TypeError):
        return None

def seconds(name, default=0):
    try:
        with open(os.path.join(root, name), encoding="utf-8") as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return default

def duration(value):
    value = max(0, int(value or 0))
    if value < 60:
        return f"{value}s"
    if value < 3600:
        return f"{value // 60}m {value % 60}s"
    return f"{value // 3600}h {(value % 3600) // 60}m"

result, termination = load("result.json"), load("termination.json")
highest = (result or {}).get("highest_stage")
if not highest:
    ranks = {name: rank for rank, name in enumerate(
        ("QEMU", "L2", "CONSOLE", "FIRMWARE", "BOOTSTRAP", "SERVICES", "STABILITY", "READY"))}
    try:
        with open(os.path.join(root, "events.jsonl"), encoding="utf-8") as f:
            stages = [json.loads(line).get("stage") for line in f]
        highest = max((stage for stage in stages if stage in ranks), key=ranks.get, default=None)
    except (OSError, ValueError, TypeError):
        pass
if running:
    if result:
        state = str(result.get("state", "unknown")).lower()
        elapsed = duration(result.get("elapsed_seconds", 0))
        if state == "ready":
            summary = f"READY (startup took {elapsed})"
        elif state == "timeout":
            reached = f"; reached {highest}" if highest else ""
            summary = f"TIMED OUT after {elapsed} ({reached.lstrip('; ')}; QEMU still running)"
        else:
            reached = f" (reached {highest})" if highest else ""
            summary = f"{state.upper()} after {elapsed}{reached}"
    else:
        state = "starting"
        elapsed = duration(time.time() - seconds("start-epoch", int(time.time())))
        reached = f"; reached {highest}" if highest else ""
        summary = f"STARTING ({elapsed} elapsed{reached})"
else:
    terminal = termination or result
    if terminal:
        state = str(terminal.get("state", "unknown")).lower()
        elapsed = duration(terminal.get("elapsed_seconds", (result or {}).get("elapsed_seconds", 0)))
        reached = highest or terminal.get("highest_stage")
        suffix = f" (had reached {reached})" if reached else ""
        summary = f"{state.upper()} after {elapsed}{suffix}"
    else:
        state, summary = "unknown", "ENDED (no readable result)"
print(f"{state}|{summary}")
PY
)
        IFS='|' read -r _run_state _run_summary <<<"$_run_info"
        printf "%-9s : %s\n" "$_run_label" "$_run_summary"
        [ "$ZBMC_DETAIL" -gt 0 ] && printf "%-9s : %s\n" "Evidence" "$ZBMC_RUN_DIR"
      else
        _run_state=unknown
      fi
      # readiness: can this box boot? box-defined zbmc_ready echoes a message; rc 0=ready, 1=not.
      printf "%-9s : " "Build"
      if declare -F zbmc_ready >/dev/null; then
        _rmsg=$(zbmc_ready 2>/dev/null); _rrc=$?
      else _rmsg="unknown (no zbmc_ready)"; _rrc=1; fi
      if [ "$_rrc" = 0 ]; then
        _rmsg="${_rmsg#ready}"
        echo "$(_colored_state READY)$_rmsg"
      else
        echo "$(_colored_state FAILED) ($_rmsg)"
      fi
      if [ "$_running" = 0 ]; then break; fi
      if ping -c 1 -W 1 "$ZBMC_IP" >/dev/null 2>&1; then
        _l2st=ok; _l2nt="$ZBMC_IP answers ICMP"
      else
        _l2st=fail; _l2nt="no ICMP reply from $ZBMC_IP"
      fi
      # capability rows — probe concurrently, collect, render. Each helper echoes STATE|DISPLAY|NOTE.
      tmp_base="$ZBMC_DIR/tmp"
      mkdir -p "$tmp_base" 2>/dev/null || tmp_base="${TMPDIR:-/tmp}"
      [ -w "$tmp_base" ] || tmp_base="${TMPDIR:-/tmp}"
      tmp=$(mktemp -d "${tmp_base%/}/status.XXXXXXXX" 2>/dev/null || mktemp -d "${TMPDIR:-/tmp}/zbmc-status.XXXXXXXX")
      ( echo "$(_probe_ssh)"     > "$tmp/ssh" ) &
      ( echo "$(_probe_ipmi)"    > "$tmp/ipmi" ) &
      ( echo "$(_probe_redfish)" > "$tmp/redfish" ) &
      if [ "$_webui_run_disabled" = 1 ]; then echo "na||disabled" > "$tmp/webui"
      else ( echo "$(_probe_webui)" > "$tmp/webui" ) & fi
      ( echo "$(_probe_console)" > "$tmp/console" ) &
      wait
      IFS='|' read -r _sshst _sshds _sshnt < "$tmp/ssh"
      IFS='|' read -r _ipmist _ipmids _ipmint < "$tmp/ipmi"
      IFS='|' read -r _redfishst _redfishds _redfishnt < "$tmp/redfish"
      IFS='|' read -r _webuist _webuids _webuint < "$tmp/webui"
      IFS='|' read -r _consolest _consoleds _consolent < "$tmp/console"
      rm -rf "$tmp"

      _disabled(){
        [ "$1" = webui ] && [ "$_webui_run_disabled" = 1 ] && return 0
        [[ " ${ZBMC_DISABLED_SERVICES:-} " == *" $1 "* ]]
      }
      _required(){ [ "$1" = l2 ] || [[ " ${ZBMC_REQUIRED_SERVICES:-ssh ipmi webui} " == *" $1 "* ]]; }
      _classify(){
        local raw="$1" service="$2"
        if _disabled "$service"; then _state=N/A; _why=disabled
        elif [ "$raw" = na ]; then _state=N/A; _why=unsupported
        elif [ "$service" = console ]; then _state=AVAILABLE; _why="operator access"
        elif ! _required "$service"; then _state=N/A; _why="not configured"
        else
          _why=required
          case "$raw" in
            ok) _state=READY ;;
            authfail) _state="AUTH FAILED" ;;
            *) if [ "${_run_state:-starting}" = starting ]; then _state=STARTING; else _state=FAILED; fi ;;
          esac
        fi
      }
      _classify "$_l2st" l2; _l2state=$_state; _l2why=$_why
      _classify "$_sshst" ssh; _sshstate=$_state; _sshwhy=$_why
      _classify "$_ipmist" ipmi; _ipmistate=$_state; _ipmiwhy=$_why
      _classify "$_redfishst" redfish; _redfishstate=$_state; _redfishwhy=$_why
      _classify "$_webuist" webui; _webuistate=$_state; _webuiwhy=$_why
      _classify "$_consolest" console; _consolestate=$_state; _consolewhy=$_why

      _ready_n=0; _expected_n=0; _starting_n=0; _failed_n=0; _na_n=0
      _ready_names=; _starting_names=; _failed_names=; _na_names=
      _add_name(){
        local var="$1" name="$2" old
        old="${!var:-}"
        printf -v "$var" '%s%s' "${old:+$old, }" "$name"
      }
      _count(){
        local state="$1" why="$2" name="$3"
        if [ "$state" = N/A ]; then _na_n=$((_na_n+1)); _add_name _na_names "$name"; return; fi
        [ "$state" = AVAILABLE ] && return
        _expected_n=$((_expected_n+1))
        case "$state" in
          READY) _ready_n=$((_ready_n+1)); _add_name _ready_names "$name" ;;
          STARTING) _starting_n=$((_starting_n+1)); _add_name _starting_names "$name" ;;
          *) _failed_n=$((_failed_n+1)); _add_name _failed_names "$name" ;;
        esac
      }
      _count "$_l2state" "$_l2why" L2; _count "$_sshstate" "$_sshwhy" SSH
      _count "$_ipmistate" "$_ipmiwhy" IPMI; _count "$_redfishstate" "$_redfishwhy" Redfish
      _count "$_webuistate" "$_webuiwhy" Web-UI
      _count "$_consolestate" "$_consolewhy" Console

      if [ "$ZBMC_DETAIL" -gt 0 ]; then
        _row(){
          local label="$1" state="$2" why="$3" display="$4" note="$5" detail
          detail="$why"
          if [ "$state" != N/A ]; then
            [ -n "$note" ] && detail="$detail; $note"
            [ -n "$display" ] && detail="$detail; $display"
          fi
          printf "%-9s : %s (%s)\n" "$label" "$(_colored_state "$state")" "$detail"
        }
        _row L2 "$_l2state" "$_l2why" "" "$_l2nt"
        _row SSH "$_sshstate" "$_sshwhy" "$_sshds" "$_sshnt"
        _row IPMI "$_ipmistate" "$_ipmiwhy" "$_ipmids" "$_ipmint"
        _row Redfish "$_redfishstate" "$_redfishwhy" "$_redfishds" "$_redfishnt"
        _row Web-UI "$_webuistate" "$_webuiwhy" "$_webuids" "$_webuint"
        _row Console "$_consolestate" "$_consolewhy" "$_consoleds" "$_consolent"
        printf "%-9s : " "NC-SI"
        if [ "$_sshstate" = READY ]; then
          _ncsi=$(timeout -s KILL 4 bash -c '. "'"$BF"'"; zbmc_ssh '\''zcat /proc/config.gz 2>/dev/null | grep -q "^CONFIG_NET_NCSI=y"'\''' 2>/dev/null)
          [ $? = 0 ] && echo "$(_colored_state AVAILABLE) (kernel support present)" || echo "N/A (not present)"
        else
          echo "N/A (not checked; SSH unavailable)"
        fi
        printf "%-9s : %s%s%s  (%s%s%s)\n" "Net (IP)" "$CP" "$ZBMC_IP" "$CZ" "$CC" "$ZBMC_NAME" "$CZ"
        if [ -n "${ZBMC_REMEDIATION:-}" ]; then
          printf "%-9s : %s (%s)\n" "Remediation" "$(_colored_state CONFIGURED)" "$ZBMC_REMEDIATION"
        else
          printf "%-9s : N/A (not configured)\n" "Remediation"
        fi
      fi

      if [ "$_failed_n" -gt 0 ]; then _health=DEGRADED
      elif [ "$_starting_n" -gt 0 ]; then _health=STARTING
      else _health=READY; fi
      printf "%-9s : " "Health"
      printf "%s [%d/%d - %s" "$(_colored_state "$_health")" "$_ready_n" "$_expected_n" "$_ready_names"
      [ "$_starting_n" -gt 0 ] && printf "; %s coming online" "$_starting_names"
      [ "$_failed_n" -gt 0 ] && printf "; %s failed" "$_failed_names"
      printf "]"
      echo
      if [ "$_follow" = 1 ] && [ "${_run_state:-}" = starting ] && [ -f "${ZBMC_RUN_DIR:-}/progress.log" ]; then
        echo "Progress (Ctrl-C stops following; QEMU keeps running):"
        tail -n +1 -f "$ZBMC_RUN_DIR/progress.log" & _tail_pid=$!
        _watch_pid=$(cat "$ZBMC_RUN_DIR/watcher.pid" 2>/dev/null || true)
        if [[ "$_watch_pid" =~ ^[0-9]+$ ]]; then
          while kill -0 "$_watch_pid" 2>/dev/null; do sleep 1; done
        fi
        sleep 0.2; kill "$_tail_pid" 2>/dev/null || true; wait "$_tail_pid" 2>/dev/null || true
      fi
      break
    done ;;
  ssh)    zbmc_ssh "$@" ;;
  telnet) declare -F zbmc_telnet >/dev/null && zbmc_telnet "$@" || { nc "$ZBMC_IP" "${TELNET_PORT:-23}"; } ;;
  ipmi)  [ $# -eq 0 ] && { echo "usage: zbmc $ZBMC_NAME ipmi <cmd...>  (e.g. mc info)"; exit 2; }; Z "$@" ;;
  web)   zbmc_web ;;
  console)
    # console = a window on the LIVE console. If the box is DOWN, say so — do NOT
    # replay the stale $LOG from the last run (which is bring-up/restore output and
    # can misleadingly show "IDRAC10_UP" etc. long after the box is gone).
    if ! running >/dev/null 2>&1; then
      echo "${CR}$ZBMC_NAME is DOWN${CZ} — no live console. Start it:  zbmc $ZBMC_NAME start"; exit 1; fi
    if declare -F zbmc_console >/dev/null; then zbmc_console
    elif [ -f "$LOG" ]; then tail -f "$LOG"
    else echo "$ZBMC_NAME is up, but its console log is missing ($LOG) — try 'ssh' or restart"; fi ;;
  build) zbmc_build ;;
  shell)    declare -F zbmc_shell    >/dev/null && zbmc_shell    "$@" || { echo "zbmc: '$ZBMC_NAME' has no shell verb"; exit 2; } ;;
  snapshot) declare -F zbmc_snapshot >/dev/null && zbmc_snapshot "$@" || { echo "zbmc: '$ZBMC_NAME' has no snapshot support"; exit 2; } ;;
  restore)  declare -F zbmc_restore  >/dev/null && zbmc_restore  "$@" || { echo "zbmc: '$ZBMC_NAME' has no restore support"; exit 2; } ;;
  rename)
    new="${1:-}"; old="$ZBMC_NAME"
    [ -n "$new" ] || { echo "usage: zbmc $old rename <newname>"; exit 2; }
    [[ "$new" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "zbmc: bad name '$new' (allowed: A-Za-z0-9_-)"; exit 2; }
    [ "$new" = "$old" ] && { echo "zbmc: already named '$old'"; exit 0; }
    find_box "$new" >/dev/null && { echo "zbmc: a box named '$new' already exists"; exit 2; }
    # Surgical: only identity fields. NEVER the qemu machine (ast2600-evb) or image (evb-ast2600.static.mtd),
    # which also contain the name substring — perl \Q..\E + line anchors keep those untouched.
    perl -i -pe "
      s/^ZBMC_NAME=.*/ZBMC_NAME=$new/;
      s/^ZBMC_HOST=\Q$old\E\$/ZBMC_HOST=$new/;
      if (/^(PIDF|LOG|SOCK)=/) { s/zbmc-\Q$old\E/zbmc-$new/ }
      # ZBMC_HINT retired — no line to update
    " "$BF" || { echo "zbmc: rename edit failed"; exit 1; }
    # Swap the /etc/hosts alias if it used the old name (box re-adds the new one on next start).
    [ "${ZBMC_HOST:-}" = "$old" ] && sudo perl -i -pe "s/\b\Q$old\E\b/$new/g if /^\Q$ZBMC_IP\E\s/" /etc/hosts 2>/dev/null
    echo "renamed '$old' -> '$new'  ($BF)"
    running >/dev/null 2>&1 && echo "  box is running — 'zbmc $new restart' to refresh its scratch paths/hosts"
    echo "  try:  zbmc $new status" ;;
  *) echo "zbmc: unknown verb '$VERB'"; echo; usage; exit 2 ;;
esac
