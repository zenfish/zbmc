#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
  echo "usage: $0 OUTPUT.tar MANIFEST..."
}

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  else shasum -a 256 "$1" | awk '{print $1}'; fi
}

output="${1:-}"
[ -n "$output" ] || { usage >&2; exit 2; }
shift
[ $# -gt 0 ] || { usage >&2; exit 2; }
if [ "$(uname -s)" != Linux ] || [ "$(uname -m)" != x86_64 ]; then
  echo "QEMU v1 Docker images require an x86_64 Linux host" >&2
  exit 1
fi
command -v docker >/dev/null 2>&1 || { echo "docker is required" >&2; exit 1; }
command -v timeout >/dev/null 2>&1 || { echo "timeout is required" >&2; exit 1; }
[ ! -e "$output" ] || { echo "refusing to overwrite: $output" >&2; exit 1; }
context="$output.context"
[ ! -e "$context" ] || { echo "refusing to overwrite: $context" >&2; exit 1; }
docker_run_timeout="${QEMU_DOCKER_RUN_TIMEOUT_SECONDS:-60}"
case "$docker_run_timeout" in
  ''|*[!0-9]*) echo "QEMU_DOCKER_RUN_TIMEOUT_SECONDS must be a positive integer" >&2; exit 2 ;;
esac
[ "$docker_run_timeout" -gt 0 ] || {
  echo "QEMU_DOCKER_RUN_TIMEOUT_SECONDS must be a positive integer" >&2
  exit 2
}

docker_run() {
  timeout --foreground -s TERM -k 5 "$docker_run_timeout" docker run "$@"
}

for manifest in "$@"; do
  [ -f "$manifest" ] || { echo "manifest not found: $manifest" >&2; exit 2; }
done
manifest_digest="$(python3 - "$ROOT/qemu/Dockerfile" "$@" <<'PY'
import hashlib
import pathlib
import sys

digest = hashlib.sha256()
for manifest in sys.argv[1:]:
    contents = pathlib.Path(manifest).read_bytes()
    digest.update(len(contents).to_bytes(8, "big"))
    digest.update(contents)
print(digest.hexdigest())
PY
)"

mkdir -p "$context/rootfs" "$context/manifests"
install -m 0644 "$ROOT/qemu/Dockerfile" "$context/Dockerfile"

debian_version=
smoke_rows=()
hash_rows=()
data_hash_rows=()
for manifest in "$@"; do
  mapfile -t fields < <(python3 - "$manifest" <<'PY'
import json, sys
data = json.load(open(sys.argv[1], encoding="utf-8"))
print(data.get("kind", "source-build"))
print(data["build_id"])
print(data["binary"])
print(data["binary_sha256"])
print(data.get("package_version", ""))
print(" ".join(data["machines"]))
PY
)
  kind="${fields[0]}" build_id="${fields[1]}" binary="${fields[2]}"
  expected_sha="${fields[3]}" package_version="${fields[4]}" machines="${fields[5]}"
  [ -x "$binary" ] || { echo "binary is not executable: $binary" >&2; exit 1; }
  [ "$(sha256 "$binary")" = "$expected_sha" ] || { echo "binary hash mismatch: $binary" >&2; exit 1; }
  install -m 0644 "$manifest" "$context/manifests/$build_id.json"
  if [ "$kind" = distribution-package ]; then
    debian_version="$package_version"
    image_binary="/usr/bin/$(basename "$binary")"
  else
    image_binary="$binary"
    install -Dm0755 "$binary" "$context/rootfs$binary"
  fi
  while IFS='|' read -r data_path data_sha; do
    [ -n "$data_path" ] || continue
    if [ "$kind" != distribution-package ]; then
      [ -f "$data_path" ] || { echo "QEMU data file not found: $data_path" >&2; exit 1; }
      [ "$(sha256 "$data_path")" = "$data_sha" ] || { echo "QEMU data hash mismatch: $data_path" >&2; exit 1; }
      install -Dm0644 "$data_path" "$context/rootfs$data_path"
    fi
    data_hash_rows+=("$data_path|$data_sha")
  done < <(python3 - "$manifest" <<'PY'
import json, sys
for item in json.load(open(sys.argv[1], encoding="utf-8")).get("data_files", []):
    print(f'{item["installed"]}|{item["sha256"]}')
PY
  )
  hash_rows+=("$image_binary|$expected_sha")
  for machine in $machines; do smoke_rows+=("$image_binary|$machine"); done
done
[ -n "$debian_version" ] || { echo "a Debian package manifest is required" >&2; exit 1; }

tag="zbmc-qemu:$manifest_digest"
docker build --platform linux/amd64 --build-arg "QEMU_DEBIAN_VERSION=$debian_version" -t "$tag" "$context"
for row in "${hash_rows[@]}"; do
  binary="${row%%|*}" expected_sha="${row##*|}"
  actual_sha="$(docker_run --rm "$tag" sha256sum "$binary" | awk '{print $1}')"
  [ "$actual_sha" = "$expected_sha" ] || { echo "Docker binary hash mismatch: $binary" >&2; exit 1; }
  printf 'Docker hash : %s: PASS\n' "$binary"
done
for row in "${data_hash_rows[@]}"; do
  data_path="${row%%|*}" expected_sha="${row##*|}"
  actual_sha="$(docker_run --rm "$tag" sha256sum "$data_path" | awk '{print $1}')"
  [ "$actual_sha" = "$expected_sha" ] || { echo "Docker data hash mismatch: $data_path" >&2; exit 1; }
  printf 'Docker data : %s: PASS\n' "$data_path"
done
for row in "${smoke_rows[@]}"; do
  binary="${row%%|*}" machine="${row##*|}"
  docker_run --rm "$tag" "$binary" -machine help | awk -v machine="$machine" '$1 == machine { found=1 } END { exit !found }'
  qmp="$(printf '%s\n' '{"execute":"qmp_capabilities"}' '{"execute":"quit"}' \
    | docker_run --rm -i "$tag" "$binary" -M "$machine" -nodefaults -display none -S -qmp stdio)"
  grep -q '"QMP"' <<<"$qmp"
  printf 'Docker smoke: %s -M %s: PASS\n' "$binary" "$machine"
done
docker save -o "$output" "$tag"
printf 'Docker archive: %s\nImage         : %s\nSHA-256       : %s\nBuild input   : %s\n' \
  "$output" "$tag" "$(sha256 "$output")" "$context"
