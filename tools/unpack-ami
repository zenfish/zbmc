#!/usr/bin/env bash
# =============================================================================
# unpack-ami -- one-command unpack of an AMI MegaRAC (SP-X) BMC flash image.
# =============================================================================
# WHAT  Takes a raw AMI MegaRAC flash image (.ima / .ima_enc / .img / .bin) and
#       carves + extracts every filesystem inside: XZ/LZMA SquashFS (root, www),
#       JFFS2 (conf, subextensions), and lists FIT kernel images. Prints each
#       step. Format is AMI's FMH module table ($MODULE$), NOT Dell FIT.
# WHY   Vendor binwalk builds often lack the squashfs signature and SILENTLY skip
#       the 30-40MB XZ-SquashFS rootfs -- the image looks "encrypted" (solid
#       high-entropy blob) when it is just compressed. This finds squashfs by
#       superblock magic, reads the real size, carves, and unsquashfs's it.
# SUCCESS  fw-filesystems/<name>/ trees (rootfs/, www/, ...) + MANIFEST.txt with
#          each filesystem's offset, size, compressor, file count, sha256.
# USAGE
#   unpack-ami <image.ima|.ima_enc|.img|.bin> [OUTDIR]
#       OUTDIR default: <input-dir>/<input-stem>.unpacked/
#   unpack-ami --help
# NEEDS  unsquashfs (brew: squashfs-tools).  Optional: jefferson (pip, JFFS2),
#        dumpimage (brew: u-boot-tools, FIT listing), shasum, dd, python3.
# NOTE   "encrypted"/".ima_enc" in AMI filenames is usually a misnomer for the
#        production/signed image -- the payload is plain XZ-SquashFS. If a carved
#        region is truly AES (entropy ~8.0 AND no hsqs/jffs2 magic anywhere),
#        this reports it and stops; decryption key lives in U-Boot/loader.
# RELATED  unpack-idrac (Dell DUP/FIT format); ~/phd/bmc/AMI prior extractions.
# =============================================================================
set -uo pipefail

say()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
sub()  { printf '    %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit "${2:-1}"; }

[ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ] && { sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; exit 0; }
IN="${1:?usage: unpack-ami <image.ima|.ima_enc|.img|.bin> [OUTDIR]  (--help)}"
[ -f "$IN" ] || die "input not found: $IN"
IN="$(cd "$(dirname "$IN")" && pwd)/$(basename "$IN")"

command -v unsquashfs >/dev/null || warn "no unsquashfs (brew install squashfs-tools) -- squashfs stage will fail"

STEM="$(basename "$IN")"; STEM="${STEM%.*}"
OUT="${2:-$(dirname "$IN")/${STEM}.unpacked}"
mkdir -p "$OUT"/{fw-blobs,fw-filesystems,fw-jffs2,fw-fit}
OUT="$(cd "$OUT" && pwd)"
MAN="$OUT/MANIFEST.txt"; : > "$MAN"
log() { echo "$*" >> "$MAN"; }
sha() { shasum -a256 "$1" 2>/dev/null | awk '{print $1}'; }
log "unpack-ami $(date)"; log "input: $IN  sha256: $(sha "$IN")"; log ""
say "input : $IN"; say "output: $OUT"

# Portable byte carve (macOS /bin/dd lacks iflag=skip_bytes; tail/head is POSIX).
carve() { tail -c "+$(( $1 + 1 ))" "$IN" | head -c "$2"; }

# --- Stage 1: find every SquashFS by superblock magic, read true size --------
# SquashFS superblock: 0x00 'hsqs' (LE), 0x14 compressor(u16), 0x28 bytes_used(u64).
# We scan the whole image for 'hsqs' and emit "<offset> <bytes_used> <comp>".
say "Stage 1 — scanning for SquashFS superblocks (own scan; binwalk-independent)"
mapfile -t SQ < <(python3 - "$IN" <<'PY'
import sys,struct
d=open(sys.argv[1],'rb').read()
comp={1:'gzip',2:'lzo',3:'lzma',4:'xz',5:'lz4',6:'zstd'}
i=-1
while True:
    i=d.find(b'hsqs',i+1)
    if i<0: break
    if i+96>len(d): break
    c=struct.unpack_from('<H',d,i+0x14)[0]
    used=struct.unpack_from('<q',d,i+0x28)[0]
    # sanity: plausible size and it fits in the image
    if 0 < used <= len(d)-i and c in comp:
        print(f"{i} {used} {comp[c]}")
PY
)
[ "${#SQ[@]}" -eq 0 ] && sub "(no squashfs found)"
for line in "${SQ[@]:-}"; do
  [ -n "$line" ] || continue
  off="${line%% *}"; rest="${line#* }"; size="${rest%% *}"; comp="${rest##* }"
  blob="$OUT/fw-blobs/sqsh_$(printf '%x' "$off").sqsh"
  sub "squashfs @ 0x$(printf '%x' "$off")  size=$size  comp=$comp"
  carve "$off" "$size" > "$blob"
  # name the tree by probing contents after extraction (rootfs vs www vs offset)
  tmp="$OUT/fw-filesystems/.tmp_$(printf '%x' "$off")"
  rm -rf "$tmp"; unsquashfs -ignore-errors -f -d "$tmp" "$blob" >/dev/null 2>&1 || true
  if [ -n "$(ls -A "$tmp" 2>/dev/null)" ]; then
    name="fs_$(printf '%x' "$off")"
    [ -e "$tmp/bin/busybox" ] || [ -e "$tmp/etc" ] && name="rootfs"
    [ -e "$tmp/index.html" ] && name="www"
    dst="$OUT/fw-filesystems/$name"; [ -e "$dst" ] && dst="${dst}_$(printf '%x' "$off")"
    mv "$tmp" "$dst"
    nf=$(find "$dst" -type f 2>/dev/null | wc -l | tr -d ' ')
    sub "  -> fw-filesystems/$(basename "$dst")/  ($nf files, $comp)"
    log "squashfs @0x$(printf '%x' "$off") size=$size comp=$comp -> $(basename "$dst") ($nf files) sha256=$(sha "$blob")"
  else
    rm -rf "$tmp"; warn "  unsquashfs produced nothing for 0x$(printf '%x' "$off") ($comp)"
  fi
done

# --- Stage 2: JFFS2 partitions (conf, subextensions) ------------------------
# jefferson auto-detects endianness PER FILE; fed the whole image it misdetects
# big-endian and finds 0 nodes. Fix: locate each JFFS2 region by node magic
# (0x1985 LE = bytes 85 19), carve region->next region, run jefferson per-region
# (isolated region -> correct little-endian detection).
say "Stage 2 — JFFS2 partitions"
NJ=0
if command -v jefferson >/dev/null; then
  mapfile -t JR < <(python3 - "$IN" <<'PY'
import sys
d=open(sys.argv[1],'rb').read()
# collect 4-byte-aligned jffs2 node magics (LE 0x1985 and BE 0x8519)
offs=[]
for m in (b'\x85\x19', b'\x19\x85'):
    i=-1
    while True:
        i=d.find(m,i+1)
        if i<0: break
        if i%4==0: offs.append(i)
offs.sort()
# cluster: new region when gap > 256KB
regions=[]; start=None; last=None
for o in offs:
    if start is None: start=last=o; continue
    # ponytail: 256KB gap splits regions. XZ payload spoofs stray 85-19 magics
    # that can bridge the dual conf copies (primary+golden, identical) into one
    # carve; jefferson extracts the primary, golden is a byte-identical backup.
    if o-last > 0x40000:
        regions.append((start,last)); start=o
    last=o
if start is not None: regions.append((start,last))
# align region start down to 64KB erase block; print "start end"
for s,e in regions:
    print(s & ~0xFFFF, e+64)
PY
)
  # carve each region up to the next region start (or +48MB slack for the last)
  cnt=${#JR[@]}
  for idx in "${!JR[@]}"; do
    [ -n "${JR[$idx]}" ] || continue
    rs="${JR[$idx]%% *}"
    # region length = next region start - this start (fallback 48MB)
    nxt=$idx; nxt=$((idx+1))
    if [ "$nxt" -lt "$cnt" ] && [ -n "${JR[$nxt]}" ]; then
      re="${JR[$nxt]%% *}"; len=$((re-rs))
    else
      len=$((48*1024*1024))
    fi
    reg="$OUT/fw-blobs/jffs2_$(printf '%x' "$rs").bin"
    carve "$rs" "$len" > "$reg"
    dst="$OUT/fw-jffs2/j_$(printf '%x' "$rs")"
    jefferson -f -d "$dst" "$reg" >/dev/null 2>&1 || true
    if [ -n "$(ls -A "$dst" 2>/dev/null)" ]; then
      # name by content: passwd -> conf, redfish_subextensions -> subext
      nm="conf_$(printf '%x' "$rs")"
      find "$dst" -name passwd -o -name redfish_subextensions 2>/dev/null | grep -q passwd && nm="conf_$(printf '%x' "$rs")"
      find "$dst" -name redfish_subextensions 2>/dev/null | grep -q . && nm="subext_$(printf '%x' "$rs")"
      [ "$dst" = "$OUT/fw-jffs2/$nm" ] || mv "$dst" "$OUT/fw-jffs2/$nm" 2>/dev/null
      nf=$(find "$OUT/fw-jffs2/$nm" -type f 2>/dev/null | wc -l | tr -d ' ')
      sub "JFFS2 @ 0x$(printf '%x' "$rs")  -> fw-jffs2/$nm/  ($nf files)"
      log "jffs2 @0x$(printf '%x' "$rs") -> $nm ($nf files)"
      NJ=$((NJ+1))
    else
      rm -rf "$dst" "$reg"
    fi
  done
  [ "$NJ" -eq 0 ] && sub "(no JFFS2 partitions carved)"
else
  warn "jefferson not installed (pipx install jefferson) -- skipping JFFS2 carve"
  sub "(JFFS2 conf/subext partitions not extracted)"
fi

# --- Stage 3: FIT kernel images (posimage) -- list only ---------------------
say "Stage 3 — FIT kernel images (d00dfeed)"
if command -v dumpimage >/dev/null; then
  mapfile -t FIT < <(python3 - "$IN" <<'PY'
import sys
d=open(sys.argv[1],'rb').read(); i=-1
while True:
    i=d.find(b'\xd0\x0d\xfe\xed',i+1)
    if i<0: break
    print(i)
PY
)
  for off in "${FIT[@]:-}"; do
    [ -n "$off" ] || continue
    blob="$OUT/fw-fit/fit_$(printf '%x' "$off").itb"
    carve "$off" $((64*1024*1024)) > "$blob"
    if dumpimage -l "$blob" >"$OUT/fw-fit/fit_$(printf '%x' "$off").listing.txt" 2>/dev/null; then
      sub "FIT @ 0x$(printf '%x' "$off") -> fw-fit/fit_$(printf '%x' "$off").listing.txt"
    else
      rm -f "$blob"
    fi
  done
  [ "${#FIT[@]}" -eq 0 ] && sub "(no FIT images)"
else
  warn "dumpimage not installed (brew install u-boot-tools) -- skipping FIT listing"
fi

# --- Stage 4: sanity -- warn if a big high-entropy region carried NO fs ------
# If squashfs+jffs2 found nothing, the image may be genuinely AES-encrypted.
if [ "${#SQ[@]}" -eq 0 ] && [ "$NJ" -eq 0 ]; then
  warn "No SquashFS or JFFS2 found. If entropy ~8.0 throughout, this image is"
  warn "likely AES-encrypted for real -- key/IV lives in U-Boot or a loader stub."
fi

say "DONE."
sub "filesystems : $(find "$OUT/fw-filesystems" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | tr '\n' ' ')"
sub "manifest    : $MAN"
sub "output      : $OUT"
log ""; log "completed $(date)"
