#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
  echo "usage: $0 OUTPUT.oci MANIFEST..."
}

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  else shasum -a 256 "$1" | awk '{print $1}'; fi
}

output="${1:-}"
[ -n "$output" ] || { usage >&2; exit 2; }
shift
[ $# -gt 0 ] || { usage >&2; exit 2; }
if [ "$(uname -s)" != Linux ] || [ "$(uname -m)" != x86_64 ]; then
  echo "QEMU v1 OCI images require an x86_64 Linux host" >&2
  exit 1
fi
command -v podman >/dev/null 2>&1 || { echo "podman is required" >&2; exit 1; }
[ ! -e "$output" ] || { echo "refusing to overwrite: $output" >&2; exit 1; }
context="$output.context"
[ ! -e "$context" ] || { echo "refusing to overwrite: $context" >&2; exit 1; }
mkdir -p "$context/artifacts" "$context/manifests"
install -m 0644 "$ROOT/qemu/Containerfile" "$context/Containerfile"

debian_version=
smoke_rows=()
for manifest in "$@"; do
  [ -f "$manifest" ] || { echo "manifest not found: $manifest" >&2; exit 2; }
  mapfile -t fields < <(python3 - "$manifest" <<'PY'
import json, pathlib, sys
data = json.load(open(sys.argv[1], encoding="utf-8"))
print(data.get("kind", "source-build"))
print(data["build_id"])
print(data["binary"])
print(data["binary_sha256"])
print(data.get("package_version", ""))
print(" ".join(data["machines"]))
PY
)
  kind="${fields[0]}" build_id="${fields[1]}" binary="${fields[2]}"
  expected_sha="${fields[3]}" package_version="${fields[4]}" machines="${fields[5]}"
  [ -x "$binary" ] || { echo "binary is not executable: $binary" >&2; exit 1; }
  [ "$(sha256 "$binary")" = "$expected_sha" ] || { echo "binary hash mismatch: $binary" >&2; exit 1; }
  install -m 0644 "$manifest" "$context/manifests/$build_id.json"
  if [ "$kind" = distribution-package ]; then
    debian_version="$package_version"
    image_binary="/usr/bin/$(basename "$binary")"
  else
    mkdir -p "$context/artifacts/$build_id"
    image_binary="/opt/zbmc-qemu/$build_id/$(basename "$binary")"
    install -m 0755 "$binary" "$context/artifacts/$build_id/$(basename "$binary")"
  fi
  for machine in $machines; do smoke_rows+=("$image_binary|$machine"); done
done
[ -n "$debian_version" ] || { echo "a Debian package manifest is required" >&2; exit 1; }

tag="zbmc-qemu:$(date -u +%Y%m%d%H%M%S)"
podman build --arch amd64 --build-arg "QEMU_DEBIAN_VERSION=$debian_version" -t "$tag" "$context"
for row in "${smoke_rows[@]}"; do
  binary="${row%%|*}" machine="${row##*|}"
  podman run --rm "$tag" "$binary" -machine help | awk -v machine="$machine" '$1 == machine { found=1 } END { exit !found }'
  qmp="$(printf '%s\n' '{"execute":"qmp_capabilities"}' '{"execute":"quit"}' \
    | podman run --rm -i "$tag" "$binary" -M "$machine" -nodefaults -display none -S -qmp stdio)"
  grep -q '"QMP"' <<<"$qmp"
  printf 'OCI smoke: %s -M %s: PASS\n' "$binary" "$machine"
done
podman save --format oci-archive -o "$output" "$tag"
printf 'OCI archive : %s\nSHA-256    : %s\nBuild input : %s\n' "$output" "$(sha256 "$output")" "$context"
