#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ZBMC_TOOL="${ZBMC_TOOL:-$ROOT/tools/zbmc}"
OUTPUT_ROOT="${QEMU_VALIDATION_ROOT:-$ROOT/work/qemu-validation}"
deadline=1200

usage() {
  echo "usage: $0 [--deadline SEC] MANIFEST [BOX ...]"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --deadline) [ $# -ge 2 ] || { usage >&2; exit 2; }; deadline="$2"; shift 2 ;;
    --deadline=*) deadline="${1#*=}"; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
    *) break ;;
  esac
done

manifest="${1:-}"
[ -f "$manifest" ] || { echo "manifest not found: $manifest" >&2; exit 2; }
shift
[[ "$deadline" =~ ^[0-9]+$ ]] || { echo "bad deadline: $deadline" >&2; exit 2; }

mapfile -t metadata < <(python3 - "$manifest" <<'PY'
import json
import sys

data = json.load(open(sys.argv[1]))
for value in (data["build_id"], data["binary"], data["binary_sha256"]):
    print(value)
for box in data["boxes"]:
    print(box)
PY
)
build_id="${metadata[0]}"
binary="${metadata[1]}"
expected_sha256="${metadata[2]}"
boxes=("${metadata[@]:3}")
[ $# -eq 0 ] || boxes=("$@")
[ -x "$binary" ] || { echo "QEMU binary is not executable: $binary" >&2; exit 1; }
actual_sha256="$(sha256sum "$binary" | awk '{print $1}')"
[ "$actual_sha256" = "$expected_sha256" ] || {
  echo "QEMU binary hash mismatch: $binary" >&2
  exit 1
}

if [ "${ZBMC_VALIDATE_RUN_AS_ME:-0}" = 1 ] || [ "$EUID" -eq 0 ]; then
  sudo_cmd=()
else
  sudo_cmd=(sudo)
fi

run_dir="$OUTPUT_ROOT/$build_id/$(date -u +%Y%m%dT%H%M%SZ)"
mkdir -p "$run_dir"
current_box=""
start_job=""
cleanup() {
  [ -z "$current_box" ] || "${sudo_cmd[@]}" "$ZBMC_TOOL" "$current_box" stop >/dev/null 2>&1 || true
  if [ -n "$start_job" ]; then
    kill -TERM "$start_job" >/dev/null 2>&1 || true
    wait "$start_job" >/dev/null 2>&1 || true
  fi
}
trap 'cleanup; exit 130' HUP INT TERM

printf 'Build    : %s\nBinary   : %s\nEvidence : %s\n' "$build_id" "$binary" "$run_dir"
failures=0
for box in "${boxes[@]}"; do
  current_box="$box"
  box_dir="$run_dir/$box"
  mkdir -p "$box_dir"
  printf '\n===== %s =====\n' "$box"

  "${sudo_cmd[@]}" "$ZBMC_TOOL" "$box" status >"$box_dir/preflight-status.log" 2>&1 || true
  if grep -Eq '^QEMU[[:space:]]*: UP' "$box_dir/preflight-status.log"; then
    echo "$box: refusing validation while QEMU is already running" | tee "$box_dir/error.log" >&2
    printf '%s\tpreflight=running\tFAIL\n' "$box" | tee -a "$run_dir/summary.tsv"
    failures=$((failures + 1))
    current_box=""
    continue
  fi

  set +e
  (
    "${sudo_cmd[@]}" "$ZBMC_TOOL" "$box" start --deadline "$deadline" -q "$binary" 2>&1 | tee "$box_dir/start.log"
    printf '%s\n' "${PIPESTATUS[0]}" >"$box_dir/start.rc"
  ) &
  start_job=$!
  wait "$start_job"
  start_wait_rc=$?
  start_job=""
  if [ -f "$box_dir/start.rc" ]; then
    start_rc="$(cat "$box_dir/start.rc")"
  else
    start_rc="$start_wait_rc"
  fi
  "${sudo_cmd[@]}" "$ZBMC_TOOL" "$box" status -v 2>&1 | tee "$box_dir/status.log"
  status_rc="${PIPESTATUS[0]}"
  grep -Eq '^Health[[:space:]]*: READY' "$box_dir/status.log" || status_rc=1
  evidence=$(sed -n 's/^Evidence[[:space:]]*: //p' "$box_dir/start.log" "$box_dir/status.log" | tail -1)
  manifest_rc=1
  if [ -n "$evidence" ] && [ -f "$evidence/manifest.json" ]; then
    python3 - "$evidence/manifest.json" "$binary" "$expected_sha256" <<'PY'
import json, os, sys
manifest, binary, expected_sha256 = sys.argv[1:]
data = json.load(open(manifest, encoding="utf-8"))
if os.path.realpath(data.get("qemu_path") or "") != os.path.realpath(binary):
    raise SystemExit(1)
if data.get("qemu_sha256") != expected_sha256:
    raise SystemExit(1)
PY
    manifest_rc=$?
  fi
  "${sudo_cmd[@]}" "$ZBMC_TOOL" "$box" stop >"$box_dir/stop.log" 2>&1
  stop_rc=$?
  set -e
  current_box=""

  result=PASS
  if [ "$start_rc" -ne 0 ] || [ "$status_rc" -ne 0 ] || [ "$manifest_rc" -ne 0 ] || [ "$stop_rc" -ne 0 ]; then
    result=FAIL
    failures=$((failures + 1))
  fi
  printf '%s\tstart=%s\tstatus=%s\tmanifest=%s\tstop=%s\t%s\n' \
    "$box" "$start_rc" "$status_rc" "$manifest_rc" "$stop_rc" "$result" | tee -a "$run_dir/summary.tsv"
done

printf '\nValidation evidence: %s\n' "$run_dir"
[ "$failures" -eq 0 ]
