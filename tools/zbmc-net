#!/usr/bin/env bash
# Minimal direct-LAN plumbing for zbmc. Uses iproute2 only: no network manager,
# DHCP, NAT, or port forwarding. The physical uplink remains the bridge port and
# the host keeps its original address on the bridge device.
set -euo pipefail

BR=${ZBMC_BRIDGE:-br-zbmc}
UPLINK=${ZBMC_UPLINK:-$(ip route show default | awk 'NR == 1 {print $5}')}
STATE=${ZBMC_NET_STATE:-/run/zbmc-net.state}

need_root() { [ "$(id -u)" = 0 ] || exec sudo -n "$0" "$@"; }

# Docker loads br_netfilter and sets the iptables FORWARD policy to DROP. That
# makes bridged LAN -> tap frames traverse FORWARD and get dropped, so a guest
# answers ARP (arptables is a separate, still-ACCEPT policy) and looks present,
# while every host except this one silently fails to reach it. Re-permit
# forwarding within our own bridge only; container isolation is untouched.
forward_chain() {
  if iptables -S DOCKER-USER >/dev/null 2>&1; then echo DOCKER-USER; else echo FORWARD; fi
}

ensure_forward_rule() {
  command -v iptables >/dev/null 2>&1 || return 0
  local chain
  chain=$(forward_chain)
  if iptables -C "$chain" -i "$BR" -o "$BR" -j ACCEPT 2>/dev/null; then return 0; fi
  if ! iptables -I "$chain" -i "$BR" -o "$BR" -j ACCEPT 2>/dev/null; then
    echo "zbmc-net: warning: could not add $chain accept rule for $BR;" \
         "guests may be unreachable from other hosts" >&2
  fi
}

# Safe to run unconditionally: the rule only matches $BR, which teardown deletes.
remove_forward_rule() {
  command -v iptables >/dev/null 2>&1 || return 0
  local chain
  chain=$(forward_chain)
  while iptables -C "$chain" -i "$BR" -o "$BR" -j ACCEPT 2>/dev/null; do
    iptables -D "$chain" -i "$BR" -o "$BR" -j ACCEPT 2>/dev/null || break
  done
}

setup_bridge() {
  [ -n "$UPLINK" ] || { echo "zbmc-net: cannot determine physical uplink" >&2; return 1; }
  ip link show "$UPLINK" >/dev/null
  ensure_forward_rule
  if ip link show "$BR" >/dev/null 2>&1; then
    [ -f "$STATE" ] || { echo "zbmc-net: refusing unmanaged bridge $BR" >&2; return 1; }
    return 0
  fi

  local mac mtu v4 gw
  mac=$(ip -o link show dev "$UPLINK" | awk '{for (i=1;i<=NF;i++) if ($i=="link/ether") {print $(i+1); exit}}')
  mtu=$(ip -o link show dev "$UPLINK" | awk '{for (i=1;i<=NF;i++) if ($i=="mtu") {print $(i+1); exit}}')
  v4=$(ip -o -4 addr show dev "$UPLINK" scope global | awk 'NR == 1 {print $4}')
  gw=$(ip route show default dev "$UPLINK" | awk 'NR == 1 {print $3}')
  [ -n "$v4" ] || { echo "zbmc-net: $UPLINK has no global IPv4 address" >&2; return 1; }

  umask 077
  printf 'UPLINK=%q\nBR=%q\nV4=%q\nGW=%q\n' "$UPLINK" "$BR" "$v4" "$gw" > "$STATE"
  : >"$STATE.taps"
  rollback_bridge() {
    set +e
    remove_forward_rule
    ip link set "$UPLINK" nomaster
    ip addr add "$v4" dev "$UPLINK"
    [ -z "$gw" ] || ip route replace default via "$gw" dev "$UPLINK" onlink
    ip link del "$BR"
    rm -f "$STATE" "$STATE.taps"
  }
  trap rollback_bridge ERR INT TERM
  ip link add "$BR" address "$mac" mtu "$mtu" type bridge
  ip link set "$BR" up
  ip addr add "$v4" dev "$BR"
  [ -z "$gw" ] || ip route replace default via "$gw" dev "$BR" onlink
  ip link set "$UPLINK" master "$BR"
  ip addr del "$v4" dev "$UPLINK"
  trap - ERR INT TERM
}

add_tap() {
  local tap=${1:?tap name required} owner=${2:-${SUDO_USER:-$(id -un)}}
  setup_bridge
  if ip link show "$tap" >/dev/null 2>&1; then
    grep -Fxq "$tap" "$STATE.taps" || { echo "zbmc-net: refusing unmanaged interface $tap" >&2; return 1; }
  else
    ip tuntap add dev "$tap" mode tap user "$owner"
    printf '%s\n' "$tap" >>"$STATE.taps"
  fi
  ip link set "$tap" master "$BR"
  ip link set "$tap" up
}

delete_tap() {
  local tap=${1:?tap name required}
  [ -f "$STATE.taps" ] && grep -Fxq "$tap" "$STATE.taps" || {
    echo "zbmc-net: refusing unmanaged interface $tap" >&2
    return 1
  }
  ip link del "$tap"
  grep -Fvx "$tap" "$STATE.taps" >"$STATE.taps.tmp" || true
  mv "$STATE.taps.tmp" "$STATE.taps"
}

teardown() {
  [ -f "$STATE" ] || { echo "zbmc-net: no saved state at $STATE" >&2; return 1; }
  # shellcheck disable=SC1090
  . "$STATE"
  if [ -f "$STATE.taps" ]; then
    while IFS= read -r tap; do [ -z "$tap" ] || ip link del "$tap" 2>/dev/null || true; done <"$STATE.taps"
  fi
  remove_forward_rule
  ip link set "$UPLINK" nomaster
  ip addr add "$V4" dev "$UPLINK" 2>/dev/null || true
  [ -z "$GW" ] || ip route replace default via "$GW" dev "$UPLINK" onlink
  ip link del "$BR"
  rm -f "$STATE" "$STATE.taps"
}

cmd=${1:-status}; shift || true
case "$cmd" in
  setup)    need_root setup; setup_bridge ;;
  add-tap)  tap=${1:?tap name required}; owner=${2:-${USER}}; need_root add-tap "$tap" "$owner"; add_tap "$tap" "$owner" ;;
  del-tap)  tap=${1:?tap name required}; need_root del-tap "$tap"; delete_tap "$tap" ;;
  teardown) need_root teardown; teardown ;;
  status)   ip -br link show "$BR" 2>/dev/null || true; ip -br addr show "$BR" 2>/dev/null || true; ip link show master "$BR" 2>/dev/null || true ;;
  *) echo "usage: zbmc-net {setup|add-tap TAP [OWNER]|del-tap TAP|status|teardown}" >&2; exit 2 ;;
esac
